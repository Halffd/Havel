# CompileStdlibBytecode.cmake.in - Generated by CMake configure
# Compiles all .hv modules to .hvc bytecode for release distribution

cmake_minimum_required(VERSION 3.16)

set(HAVEL_BINARY "@CMAKE_BINARY_DIR@/havel")
set(OUT_BASE "@CMAKE_BINARY_DIR@/share/havel/modules")
set(STD_SRC "@CMAKE_SOURCE_DIR@/modules/std")
set(LANG_SRC "@CMAKE_SOURCE_DIR@/modules/lang")
set(APP_SRC "@CMAKE_SOURCE_DIR@/modules/app")

if(NOT EXISTS "${HAVEL_BINARY}")
    message(FATAL_ERROR "havel binary not found: ${HAVEL_BINARY}")
endif()

function(compile_modules src_dir out_dir prefix)
    file(GLOB hv_files "${src_dir}/*.hv")
    foreach(hv ${hv_files})
        get_filename_component(name ${hv} NAME_WE)
        set(out "${out_dir}/${prefix}${name}.hvc")
        message(STATUS "Compiling ${hv} -> ${out}")
        execute_process(
            COMMAND ${HAVEL_BINARY} --no-self-hosted --build "${hv}" -o "${out}"
            RESULT_VARIABLE result
            OUTPUT_VARIABLE output
            ERROR_VARIABLE error
        )
        if(result)
            message(FATAL_ERROR "Failed to compile ${hv}: ${error}")
        endif()
        # Copy source .hv for debugging
        configure_file("${hv}" "${out_dir}/${name}.hv" COPYONLY)
    endforeach()
endfunction()

file(MAKE_DIRECTORY "${OUT_BASE}/std")
file(MAKE_DIRECTORY "${OUT_BASE}/lang")
# app modules are optional and have some parser issues - skip for now

compile_modules("${STD_SRC}" "${OUT_BASE}/std" "std.")
compile_modules("${LANG_SRC}" "${OUT_BASE}/lang" "lang.")

message(STATUS "Bytecode compilation complete -> ${OUT_BASE}")