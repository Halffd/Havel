// livelink.hv — LiveLink daemon control plane (HTTP-only)
//
// Concurrency model: the web server, request handlers, and the auto-refresh
// loop all run as cooperative fibers on the single-threaded scheduler
// (modules/std/net/webserver.hv spawns each request via `go {}`). There are
// no preemptive threads, so `state` needs no mutex — but a handler CAN
// observe a half-updated invariant if a fiber suspends (sleep / socket I/O)
// mid-mutation. Invariant used throughout: every multi-field update builds a
// complete replacement object and swaps it with one assignment, and no
// suspension point sits inside a mutation sequence.
//
// Interfaces: HTTP API only. The interactive CLI loop was removed —
// shell.read() is a hard-blocking std::getline that freezes the scheduler
// (and with it the web server) while waiting at the prompt. Use curl or
// scripts/livelinkctl.hv against the API below.
//
// API:
//   GET  /api/status     server + stream status (times are epoch millis)
//   GET  /api/stream     active stream record
//   POST /api/stream     {url, title?} — switch stream (400 on missing url)
//   POST /api/refresh    re-record current stream (success:false if no url)
//   GET  /api/streams    configured streams from config.toml
//   POST /api/shutdown   graceful stop (no signal API exists in Havel; this
//                        endpoint is the controlled shutdown path)
//   GET  /               dashboard HTML (templates/dashboard.html)

use sys
use shell
use time
// The template is read at STARTUP via an explicitly bound host-fs read: the
// webserver module (imported below) loads net/fsuv under the name `fs`, which
// shadows the plain `use fs` binding — fsuv's read() takes an fd, not a path.
// Binding the host read as fsRead (a name no other module exports) keeps the
// startup read unambiguous, and handlers never touch fs at all.
use { read as fsRead, exists as fsExists } from "fs"
use { config as dotenvConfig } from "std/dotenv"
use { parse as tomlParse } from "std/toml"
use { create as createApp } from "net/webserver"

// ============================================================================
// Configuration
// ============================================================================

fn resolveEnv(key, defaultVal, envVars) {
  envVal = sys.env(key)
  if envVal != null && envVal != "" {
    envVal
  } else if envVars != null && envVars[key] != null && envVars[key] != "" {
    envVars[key]
  } else {
    defaultVal
  }
}

// int() maps junk to 0 and parses "12x" as 12 (VM::toInt uses std::stoll),
// so numeric config from the outside world is validated strictly here.
fn isDigits(s) {
  if s == null || s == "" {
    return false
  }
  ok = true
  i = 0
  while i < #s {
    c = s[i:i+1]
    if c < "0" || c > "9" {
      ok = false
      i = #s
    }
    i = i + 1
  }
  ok
}

fn parsePositiveInt(raw, label, maxVal) {
  if !isDigits(raw) {
    print("[LiveLink] Invalid ${label}: '${raw}' is not a whole number")
    shell.exit(1)
  }
  n = int(raw)
  if n <= 0 {
    print("[LiveLink] Invalid ${label}: ${raw} must be > 0")
    shell.exit(1)
  }
  if maxVal != null && n > maxVal {
    print("[LiveLink] Invalid ${label}: ${raw} must be <= ${maxVal}")
    shell.exit(1)
  }
  n
}

fn loadConfig() {
  envVars = {}

  if fs.exists(".env") {
    envRes = dotenvConfig(".env")
    if envRes != null && envRes.parsed != null {
      envVars = envRes.parsed
    }
  }

  tomlCfg = {}
  if fs.exists("config.toml") {
    content = fs.read("config.toml")
    if content != null {
      parsed = tomlParse(content)
      if parsed != null {
        tomlCfg = parsed
      }
    }
  }

  config = {
    port: parsePositiveInt(resolveEnv("PORT", "3000", envVars), "PORT", 65535)
    streamUrl: resolveEnv("STREAM_URL", "", envVars)
    refreshInterval: parsePositiveInt(resolveEnv("REFRESH_INTERVAL", "300000", envVars), "REFRESH_INTERVAL", null)
    streams: {}
    autoRefresh: resolveEnv("AUTO_REFRESH", "true", envVars) == "true"
  }

  if tomlCfg.streams != null {
    config.streams = tomlCfg.streams
  }

  // CLI Overrides
  rawArgs = []
  if sys.argv != null {
    rawArgs = sys.argv()
  }

  i = 0
  while i < #rawArgs {
    arg = rawArgs[i]
    if arg == "--port" && i + 1 < #rawArgs {
      i = i + 1
      config.port = parsePositiveInt(rawArgs[i], "--port", 65535)
    } else if arg == "--url" && i + 1 < #rawArgs {
      i = i + 1
      config.streamUrl = rawArgs[i]
    } else if arg == "--refresh-interval" && i + 1 < #rawArgs {
      i = i + 1
      config.refreshInterval = parsePositiveInt(rawArgs[i], "--refresh-interval", null)
    } else if arg == "--no-auto-refresh" {
      config.autoRefresh = false
    }
    i = i + 1
  }

  config
}

// ============================================================================
// State
// ============================================================================

cfg = loadConfig()
serverStartMs = time.millis()

appState = {
  activeStream: {
    url: cfg.streamUrl
    quality: "auto"
    title: "LiveLink Direct Stream"
    headers: {}
    format: "hls"
    lastUpdated: serverStartMs
  }
  streamHistory: []
  autoRefresh: cfg.autoRefresh
  refreshInterval: cfg.refreshInterval
  shuttingDown: false
}

// ============================================================================
// Stream Management
// ============================================================================

fn refreshStream() {
  url = appState.activeStream.url
  if url == null || url == "" {
    print("[LiveLink] No stream URL configured.")
    return false
  }
  // Mutation block: no suspension points between these writes, so no other
  // fiber can observe a partial history/lastUpdated update.
  if #appState.streamHistory >= 10 {
    appState.streamHistory.shift()
  }
  appState.streamHistory.push({url: url, timestampMs: time.millis()})
  appState.activeStream.lastUpdated = time.millis()
  print("[LiveLink] Stream refreshed: ${url}")
  true
}

fn switchStream(newUrl, newTitle) {
  if newTitle == null {
    newTitle = "Stream - ${newUrl}"
  }
  // Atomic under the cooperative scheduler: build the complete record, then
  // replace the reference in a single assignment.
  appState.activeStream = {
    url: newUrl
    quality: appState.activeStream.quality
    title: newTitle
    headers: appState.activeStream.headers
    format: appState.activeStream.format
    lastUpdated: time.millis()
  }
  refreshStream()
}

fn shutdown(code) {
  if appState.shuttingDown {
    return
  }
  appState.shuttingDown = true
  print("[LiveLink] Shutting down (exit code ${code})...")
  webApp.stop()
  shell.exit(code)
}

// ============================================================================
// Dashboard
// ============================================================================

DASH_TEMPLATE_PATH = "templates/dashboard.html"
DASH_FALLBACK_HTML = "<!DOCTYPE html><html><head><title>LiveLink</title></head><body><h1>LiveLink Stream Hub</h1><p>Dashboard template missing: templates/dashboard.html</p></body></html>"

fn loadDashboardTemplate() {
  tpl = fsRead(DASH_TEMPLATE_PATH)
  if tpl == null {
    print("[LiveLink] Dashboard template missing: ${DASH_TEMPLATE_PATH} (using fallback)")
    DASH_FALLBACK_HTML
  } else {
    tpl
  }
}

DASH_TPL = loadDashboardTemplate()

fn renderDashboard() {
  html = DASH_TPL.replace("{{title}}", "${appState.activeStream.title}")
  html = html.replace("{{url}}", "${appState.activeStream.url}")
  html = html.replace("{{port}}", "${cfg.port}")
  html = html.replace("{{autorefresh}}", "${appState.autoRefresh}")
  html
}

// ============================================================================
// Web Server & API
// ============================================================================

webApp = createApp()

webApp.get("/api/status", fn(req, res) {
  nowMs = time.millis()
  res.json({
    status: "online"
    // All times are epoch millis (time.millis). This is wall-clock, NOT
    // monotonic — NTP steps can skew uptime. Havel has no monotonic
    // process-clock primitive; sys.uptime() is system uptime, not ours.
    clock: "epoch-millis (wall clock, not monotonic)"
    uptimeMs: nowMs - serverStartMs
    uptimeSec: (nowMs - serverStartMs) / 1000
    activeStream: appState.activeStream
    autoRefresh: appState.autoRefresh
    refreshIntervalMs: appState.refreshInterval
    shuttingDown: appState.shuttingDown
    port: cfg.port
  })
})

webApp.get("/api/stream", fn(req, res) {
  res.json(appState.activeStream)
})

webApp.post("/api/stream", fn(req, res) {
  body = req.json
  if body == null || body.url == null || body.url == "" {
    res.setStatus(400).json({
      success: false
      error: "url is required: POST JSON {\"url\": ...} with Content-Type: application/json"
    })
    return
  }
  switchStream(body.url, body.title)
  res.json({success: true, activeStream: appState.activeStream})
})

webApp.post("/api/refresh", fn(req, res) {
  success = refreshStream()
  res.json({success: success, activeStream: appState.activeStream})
})

webApp.get("/api/streams", fn(req, res) {
  res.json({streams: cfg.streams})
})

webApp.post("/api/shutdown", fn(req, res) {
  res.json({success: true, message: "shutting down"})
  shutdown(0)
})

webApp.get("/", fn(req, res) {
  res.html(renderDashboard())
})

// ============================================================================
// Start
// ============================================================================

print("========================================================================")
print(" LiveLink Daemon Started (HTTP-only; interactive CLI removed)")
print(" API on port: ${cfg.port}")
print(" Auto-refresh: ${appState.autoRefresh} (interval: ${appState.refreshInterval} ms)")
print("========================================================================")

if appState.activeStream.url != "" {
  refreshStream()
}

listening = webApp.listen("0.0.0.0", cfg.port)
if !listening {
  print("[LiveLink] Failed to bind 0.0.0.0:${cfg.port} (port in use?)")
  shell.exit(1)
}

// Background auto-refresh. refreshStream() cannot fail today, but the loop
// survives future failures (network fetches) instead of dying silently on
// the first throw.
go {
  while !appState.shuttingDown {
    sleep(appState.refreshInterval)
    if appState.shuttingDown {
      break
    }
    if appState.autoRefresh && appState.activeStream.url != "" {
      try {
        refreshStream()
      } catch e {
        print("[LiveLink] Auto-refresh failed: ${e}")
      }
    }
  }
}

// Daemon keep-alive. Checked every second so a future signal bridge (none
// exists yet) or the shutdown flag can end the process cleanly.
while !appState.shuttingDown {
  sleep(1000)
}
print("[LiveLink] Daemon loop ended.")
