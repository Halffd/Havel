// async.hv — Higher-level async/scheduling utilities
// Built on C++ primitives: thread.spawn, channel, sleep, timeout, interval, waitgroup

use time

// ============================================================
// Core utilities
// ============================================================

fn sleep(ms) {
    time.sleep(ms)
}

fn go(func) {
    thread.spawn(func)
}

fn await(x) { x }

// ============================================================
// Debounce - delay execution until after wait period of silence
// ============================================================

fn debounce(func, ms) {
    timer = nil
    cancelled = false
    wrapped = fn(...args) {
        if cancelled { return nil }
        if timer != nil { timeout.cancel(timer) }
        timer = timeout ms { func(...args) }
    }
    // cancel() permanently disables the debouncer: pending call is dropped
    // and subsequent wrapped calls become no-ops (see test_async.hv).
    wrapped.cancel = fn() { cancelled = true; if timer != nil { timeout.cancel(timer); timer = nil } }
    wrapped
}

// ============================================================
// Throttle - limit execution to once per period
// ============================================================

fn throttle(func, ms) {
    last = 0
    
    wrapped = fn(...args) {
        now = time.now()
        elapsed = now - last
        if elapsed >= ms {
            last = now
            func(...args)
        }
        // Calls inside the window are dropped (leading-edge only):
        // throttle(fn, 50) fires the first call immediately and ignores
        // the rest until the window elapses (see test_async.hv).
    }
    wrapped.cancel = fn() { }
    wrapped
}

// ============================================================
// Retry - retry function with backoff
// ============================================================

fn retry(func, attempts, baseDelay, maxDelay, backoff) {
    if backoff == nil { backoff = 2.0 }
    if maxDelay == nil { maxDelay = 30000 }
    
    // Immediate invocation: retry(func, n, delay) runs func now with backoff
    // between failures and returns the first success (see test_async.hv).
    lastErr = nil
    delay = baseDelay || 100
    i = 0
    while i < attempts {
        try {
            return func()
        } catch err {
            lastErr = err
            i += 1
            if i < attempts {
                sleep(int(delay))
                delay = int(delay * backoff)
                if delay > maxDelay { delay = maxDelay }
            }
        }
    }
    throw lastErr
}

// ============================================================
// Timeout - wrap function with timeout
// ============================================================

fn withTimeout(func, ms, onTimeout) {
    result = channel.new()
    timeoutId = nil
    done = false
    
    timeoutId = timeout ms {
        if !done {
            done = true
            if onTimeout != nil { 
                result.send(onTimeout()) 
            } else { 
                result.send({ok: false, error: "timeout"}) 
            }
        }
    }
    
    go fn() {
        if !done {
            try {
                res = func()
                done = true
                timeout.cancel(timeoutId)
                result.send({ok: true, value: res})
            } catch err {
                done = true
                timeout.cancel(timeoutId)
                result.send({ok: false, error: str(err)})
            }
        }
    }
    
    result.receive()
}

// withTimeout without an onTimeout handler.
// Returns {ok: true, value: res} or {ok: false, error: "timeout"}.
// (Exported as `timeout` via the alias in async.hv's import list — do NOT
// rebind the name `timeout` here: the timeout DSL (`timeout ms {}`) and
// timeout.cancel prototype calls must keep resolving to the host runtime.)
fn timeoutWrap(func, ms) { withTimeout(func, ms, nil) }

// ============================================================
// Race - first to complete wins
// ============================================================

fn race(funcs) {
    result = channel.new()
    
    // Each competitor sends its outcome; the first send queued wins because
    // channel.send never blocks (it queues) and we receive exactly once.
    // The old `done` flag had a TOCTOU race: two goroutines suspended at
    // f() could both pass the !done check, both set done, and both send.
    // Late sends just queue a value nobody reads — no goroutine blocks.
    // IIFE: loop vars share one upvalue cell, so capture f per iteration.
    for f in funcs {
        (fn(comp) {
            go fn() {
                try {
                    res = comp()
                    result.send({ok: true, value: res})
                } catch err {
                    result.send({ok: false, error: str(err)})
                }
            }
        })(f)
    }
    
    result.receive()
}

// ============================================================
// Once - memoize async function
// ============================================================

fn once(func) {
    called = false
    cached = nil
    err = nil
    
    wrapped = fn(...args) {
        if !called {
            called = true
            try {
                cached = func(...args)
            } catch e {
                err = e
                throw e
            }
        }
        if err != nil { throw err }
        cached
    }
    wrapped
}

// ============================================================
// Every - run function periodically
// ============================================================

fn every(func, ms) {
    id = interval ms { func() }
    wrapped = fn() { interval.stop(id) }
    wrapped.id = id
    wrapped.stop = wrapped
    wrapped
}

// ============================================================
// Parallel utilities
// ============================================================

fn parallelMap(items, func, concurrency) {
    if concurrency == nil { concurrency = 4 }
    if #items == 0 { return [] }
    
    results = channel.new()
    wg = waitgroup.new()
    sem = channel.new()
    
    // Count ALL workers up-front: adding wg.add(1) per loop iteration let
    // the counter hit zero (workers 1..k done, item k+1 still waiting on a
    // semaphore token) before every item had spawned — the closer's
    // wg.wait() fired, closed `results`, and the last worker's send was
    // dropped by the closed channel (parallelMap lost its final item).
    wg.add(#items)
    
    // Initialize semaphore
    for i in 0..concurrency { sem.send(true) }
    
    for i, item in items {
        sem.receive()
        // IIFE: loop vars share one upvalue cell — capture i/item per iteration
        (fn(idx, val) {
            go fn() {
                defer { wg.done(); sem.send(true) }
                res = func(val)
                results.send({index: idx, value: res, ok: true})
            }
        })(i, item)
    }
    
    go fn() {
        wg.wait()
        results.close()
    }
    
    out = []
    for r in results {
        if r.ok { out[r.index] = r.value }
    }
    out
}

fn parallelFilter(items, func, concurrency) {
    if concurrency == nil { concurrency = 4 }
    mapped = parallelMap(items, func, concurrency)
    out = []
    for i, item in items {
        if mapped[i] { out.push(item) }
    }
    out
}

fn parallelForEach(items, func, concurrency) {
    parallelMap(items, func, concurrency)
    nil
}

// ============================================================
// Promise-like utilities (for channel-based async)
// ============================================================

fn promise(func) {
    ch = channel.new()
    go fn() {
        try {
            res = func()
            ch.send({ok: true, value: res})
        } catch err {
            ch.send({ok: false, error: str(err)})
        }
    }
    ch
}

fn then(promiseCh, onFulfilled, onRejected) {
    go fn() {
        res = promiseCh.receive()
        if res.ok {
            if onFulfilled != nil { onFulfilled(res.value) }
        } else {
            if onRejected != nil { onRejected(res.error) }
        }
    }
}

fn all(channels) {
    results = []
    for i, ch in channels {
        // IIFE: loop vars share one upvalue cell — capture i/ch per iteration
        (fn(idx, c) {
            go fn() { results[idx] = c.receive() }
        })(i, ch)
    }
    wg = waitgroup.new()
    wg.add(#channels)
    for j in 0..#channels { wg.wait() }
    results
}

fn allSettled(channels) {
    out = []
    for ch in channels {
        out.push(ch.receive())
    }
    out
}

// ============================================================
// Channel utilities
// ============================================================

fn chan(buffer) {
    if buffer == nil || buffer <= 0 { channel.new() }
    else { channel.new(buffer) }
}

fn chanSelect(channels) {
    for ch in channels {
        v = ch.receive()
        return {channel: ch, value: v}
    }
    nil
}

fn merge(channels) {
    out = channel.new()
    for ch in channels {
        // IIFE: loop vars share one upvalue cell — capture ch per iteration
        (fn(c) {
            go fn() {
                for v in c { out.send(v) }
            }
        })(ch)
    }
    out
}

fn fanIn(channels) { merge(channels) }

fn fanOut(source, workers) {
    outs = []
    for i in 0..workers { outs.push(channel.new()) }
    go fn() {
        for v in source {
            i = 0
            for out in outs {
                out.send(v)
                i += 1
            }
        }
        for out in outs { out.close() }
    }
    outs
}

// ============================================================
// WaitGroup (re-export from VM)
// ============================================================

fn waitgroup() { waitgroup.new() }

// ============================================================
// Rate limiter
// ============================================================

fn rateLimit(maxPerSecond) {
    intervalMs = 1000 / maxPerSecond
    last = 0
    queue = []
    processing = false
    
    wrapped = fn(func) {
        queue.push(func)
        if !processing {
            processing = true
            go fn() {
                while #queue > 0 {
                    now = time.now()
                    if now - last >= intervalMs {
                        last = now
                        f = queue.shift()
                        f()
                    } else {
                        sleep(intervalMs - (now - last))
                    }
                }
                processing = false
            }
        }
    }
    wrapped
}

// ============================================================
// Circuit breaker
// ============================================================

fn circuitBreaker(func, failureThreshold, resetTimeout) {
    if failureThreshold == nil { failureThreshold = 5 }
    if resetTimeout == nil { resetTimeout = 30000 }
    
    state = "closed"
    failures = 0
    lastFailure = 0
    
    wrapped = fn(...args) {
        if state == "open" {
            if time.now() - lastFailure > resetTimeout {
                state = "half-open"
            } else {
                throw "circuit breaker open"
            }
        }
        
        try {
            res = func(...args)
            if state == "half-open" {
                state = "closed"
                failures = 0
            }
            res
        } catch err {
            failures += 1
            lastFailure = time.now()
            if failures >= failureThreshold {
                state = "open"
            }
            throw err
        }
    }
    wrapped
}