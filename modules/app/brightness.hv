// brightness.hv — optimized FFI for X11/Xrandr gamma ramp control
// Uses persistent display connection, caches atoms/monitor info, native gamma ramp

use ffi
use display
use shell
use fs
use math
use os

// === State holder (module-level singleton) ===
_state = {
  initialized: false,
  x11: null,
  xrandr: null,
  c: null,
  hasXRR: false,
  fillGammaRamp: 0,
  gammaRampLib: 0,
  display: 0,
  displayRefCount: 0,
  rootWin: 0,
  brightnessAtom: 0,
  monitors: [],
  monitorIndexByName: {},
  temperature: {},
  gammaRGB: {},
  shadowLift: {},
  cachedBrightness: {},
  originalGamma: {},
  gammaRampCache: {},
  XOpenDisplay: 0,
  XDefaultScreen: 0,
  XRootWindow: 0,
  XInternAtom: 0,
  XFlush: 0,
  XCloseDisplay: 0,
  XSynchronize: 0,
  XScreenNumberOfScreen: 0,
  XRRGetScreenResourcesCurrent: 0,
  XRRFreeScreenResources: 0,
  XRRGetOutputInfo: 0,
  XRRFreeOutputInfo: 0,
  XRRGetCrtcInfo: 0,
  XRRFreeCrtcInfo: 0,
  XRRGetOutputPrimary: 0,
  XRRGetCrtcGammaSize: 0,
  XRRGetCrtcGamma: 0,
  XRRSetCrtcGamma: 0,
  XRRAllocGamma: 0,
  XRRFreeGamma: 0,
  XRRChangeOutputProperty: 0,
  XRRGetOutputProperty: 0,
  XRRQueryOutputProperty: 0,
  XFree: 0,
  // Performance: track if we need to apply pending changes
  pendingMonitors: [],
  pendingSettings: {},
}

// Helper to get state
fn _S() { _state }

// === Constants ===
MIN_TEMP = 1000
MAX_TEMP = 25000
DEFAULT_BRIGHTNESS_AMOUNT = 0.02
DEFAULT_TEMP_AMOUNT = 200
DEFAULT_GAMMA_AMOUNT = 100
GAMMA_RAMP_SIZE = 256
SHADOW_LIFT_MAX = 4.0

// === Helpers ===
fn _clamp(v, lo, hi) { if v < lo { lo } else if v > hi { hi } else { v } }

fn _shell(cmd) {
  r = shell.exec(cmd + " 2>/dev/null")
  if r.success { r.stdout.trim() } else { "" }
}

// === Library loading and symbol resolution ===
fn _loadLibraries() {
  s = _S()
  s.x11 = ffi.open("libX11.so.6")
  s.xrandr = ffi.open("libXrandr.so.2")
  s.c = ffi.open("libc.so.6")

  if s.xrandr != 0 {
    s.XRRGetScreenResourcesCurrent = ffi.sym(s.xrandr, "XRRGetScreenResourcesCurrent")
    s.XRRFreeScreenResources = ffi.sym(s.xrandr, "XRRFreeScreenResources")
    s.XRRGetOutputInfo = ffi.sym(s.xrandr, "XRRGetOutputInfo")
    s.XRRFreeOutputInfo = ffi.sym(s.xrandr, "XRRFreeOutputInfo")
    s.XRRGetCrtcInfo = ffi.sym(s.xrandr, "XRRGetCrtcInfo")
    s.XRRFreeCrtcInfo = ffi.sym(s.xrandr, "XRRFreeCrtcInfo")
    s.XRRGetOutputPrimary = ffi.sym(s.xrandr, "XRRGetOutputPrimary")
    s.XRRGetCrtcGammaSize = ffi.sym(s.xrandr, "XRRGetCrtcGammaSize")
    s.XRRGetCrtcGamma = ffi.sym(s.xrandr, "XRRGetCrtcGamma")
    s.XRRSetCrtcGamma = ffi.sym(s.xrandr, "XRRSetCrtcGamma")
    s.XRRAllocGamma = ffi.sym(s.xrandr, "XRRAllocGamma")
    s.XRRFreeGamma = ffi.sym(s.xrandr, "XRRFreeGamma")
    s.XRRChangeOutputProperty = ffi.sym(s.xrandr, "XRRChangeOutputProperty")
    s.XRRGetOutputProperty = ffi.sym(s.xrandr, "XRRGetOutputProperty")
    s.XRRQueryOutputProperty = ffi.sym(s.xrandr, "XRRQueryOutputProperty")
    if s.XRRGetScreenResourcesCurrent != 0 { s.hasXRR = true }
  }

  if s.x11 != 0 {
    s.XOpenDisplay = ffi.sym(s.x11, "XOpenDisplay")
    s.XDefaultScreen = ffi.sym(s.x11, "XDefaultScreen")
    s.XRootWindow = ffi.sym(s.x11, "XRootWindow")
    s.XInternAtom = ffi.sym(s.x11, "XInternAtom")
    s.XFlush = ffi.sym(s.x11, "XFlush")
    s.XCloseDisplay = ffi.sym(s.x11, "XCloseDisplay")
    s.XSynchronize = ffi.sym(s.x11, "XSynchronize")
  }

  if s.c != 0 {
    s.XFree = ffi.sym(s.c, "free")
    if s.XFree == 0 && s.x11 != 0 {
      s.XFree = ffi.sym(s.x11, "XFree")
    }
  }
}

// === Load native gamma ramp builder ===
fn _loadNativeRampBuilder() {
  s = _S()
  if s.gammaRampLib == null || ffi.ptr_to_uint(s.gammaRampLib) == 0 {
    // Dynamic paths based on common build directories
    cwd = fs.cwd()
    paths = [
      "libgamma_ramp.so",
      "./libgamma_ramp.so",
      "./lib/libgamma_ramp.so",
      "./build-debug/libgamma_ramp.so",
      "./build-release/libgamma_ramp.so",
      "/usr/local/lib/libgamma_ramp.so",
      "/usr/lib/libgamma_ramp.so"
    ]
    // Also try build directory if HAVEL_BUILD_DIR is set
    buildDir = os.env("HAVEL_BUILD_DIR")
    if buildDir != "" { paths = [buildDir + "/libgamma_ramp.so"] + paths }
    // Try build directories relative to cwd if cwd is available
    if cwd != null {
      paths = paths + [cwd + "/libgamma_ramp.so", cwd + "/lib/libgamma_ramp.so", cwd + "/build-debug/libgamma_ramp.so", cwd + "/build-release/libgamma_ramp.so"]
    }
    for p in paths {
      s.gammaRampLib = ffi.open(p)
      if ffi.ptr_to_uint(s.gammaRampLib) != 0 { break }
    }
    if ffi.ptr_to_uint(s.gammaRampLib) == 0 { return false }
    s.fillGammaRamp = ffi.sym(s.gammaRampLib, "fill_gamma_ramp")
  }
  return ffi.ptr_to_uint(s.fillGammaRamp) != 0
}

// === Display connection management (persistent connection) ===
fn _ensureDisplay() {
  s = _S()
  if s.display == 0 {
    s.display = ffi.call(s.XOpenDisplay, "pointer", ["pointer"], 0)
    if s.display == 0 { return false }
    scr = ffi.call(s.XDefaultScreen, "int32", ["pointer"], s.display)
    s.rootWin = ffi.call(s.XRootWindow, "uint64", ["pointer", "int32"], s.display, scr)
    if s.rootWin == 0 {
      ffi.call(s.XCloseDisplay, "int32", ["pointer"], s.display)
      s.display = 0
      return false
    }
    cs = ffi.cstring("Brightness")
    s.brightnessAtom = ffi.call(s.XInternAtom, "uint64", ["pointer", "pointer", "int32"], s.display, cs, 0)
    ffi.free(cs)
    // Enable async mode for better performance
    ffi.call(s.XSynchronize, "int32", ["pointer", "int32"], s.display, 0)
  }
  true
}

fn _releaseDisplay() {
  // Keep display open for performance - only close on module unload
  // s = _S()
  // if s.display != 0 {
  //   ffi.call(s.XCloseDisplay, "int32", ["pointer"], s.display)
  //   s.display = 0
  //   s.rootWin = 0
  //   s.brightnessAtom = 0
  // }
  true
}

// === Monitor enumeration (cached) ===
fn _enumMonitors() {
  s = _S()
  if !s.hasXRR { return }
  if !_ensureDisplay() { return }

  res = ffi.call(s.XRRGetScreenResourcesCurrent, "pointer", ["pointer", "uint64"], s.display, s.rootWin)
  if res == 0 { _releaseDisplay(); return }

  noutput = ffi.get_i32(ffi.ptr_add(res, 32))
  outputsPtr = ffi.get_ptr(ffi.ptr_add(res, 40))
  primaryOutput = ffi.call(s.XRRGetOutputPrimary, "uint64", ["pointer", "uint64"], s.display, s.rootWin)

  s.monitors = []
  s.monitorIndexByName = {}

  i = 0
  while i < noutput {
    outputId = ffi.get_u64(ffi.ptr_add(outputsPtr, i * 8))
    oinfo = ffi.call(s.XRRGetOutputInfo, "pointer", ["pointer", "pointer", "uint64"], s.display, res, outputId)
    if oinfo != 0 {
      conn = ffi.get_u16(ffi.ptr_add(oinfo, 48))
      crtc = ffi.get_u64(ffi.ptr_add(oinfo, 8))
      namePtr = ffi.get_ptr(ffi.ptr_add(oinfo, 16))
      nameLen = ffi.get_i32(ffi.ptr_add(oinfo, 24))
      monName = ""
      if namePtr != 0 { monName = ffi.string(namePtr, nameLen) }
      if conn == 0 && crtc != 0 && monName != "" {
        gammaSize = ffi.call(s.XRRGetCrtcGammaSize, "int32", ["pointer", "uint64"], s.display, crtc)
        if gammaSize <= 0 { gammaSize = GAMMA_RAMP_SIZE }
        s.monitors.push({name: monName, crtc: crtc, output: outputId, primary: outputId == primaryOutput, gammaSize: gammaSize})
        s.monitorIndexByName.set(monName, #s.monitors - 1)
      }
      ffi.call(s.XRRFreeOutputInfo, "void", ["pointer"], oinfo)
    }
    i = i + 1
  }
  ffi.call(s.XRRFreeScreenResources, "void", ["pointer"], res)
  _releaseDisplay()
}

// === Gamma ramp operations (always uses native lib) ===
fn _applyGammaRamp(monitorName, brightness, gammaR, gammaG, gammaB, tempK, shadowLiftVal) {
  s = _S()
  if !s.hasXRR { return false }
  if !_ensureDisplay() { return false }

  mi = s.monitorIndexByName.get(monitorName)
  if mi == null || mi < 0 { return false }
  mon = s.monitors[mi]
  if mon.crtc == 0 { return false }

  gammaSize = mon.gammaSize
  gamma = ffi.call(s.XRRAllocGamma, "pointer", ["int32"], gammaSize)
  if gamma == 0 { return false }

  redPtr = ffi.get_ptr(ffi.ptr_add(gamma, 8))
  greenPtr = ffi.get_ptr(ffi.ptr_add(gamma, 16))
  bluePtr = ffi.get_ptr(ffi.ptr_add(gamma, 24))

  if s.fillGammaRamp != 0 {
    ffi.call(s.fillGammaRamp, "void",
      ["pointer", "pointer", "pointer", "int32", "double", "double", "double", "double", "double", "double"],
      redPtr, greenPtr, bluePtr, gammaSize, brightness, gammaR, gammaG, gammaB, tempK, shadowLiftVal)
  } else {
    cacheKey = monitorName + "|" + str(brightness) + "|" + str(gammaR) + "|" + str(gammaG) + "|" + str(gammaB) + "|" + str(tempK) + "|" + str(shadowLiftVal)
    cached = s.gammaRampCache.get(cacheKey)
    if cached != null && cached.size == gammaSize {
      j = 0
      while j < gammaSize {
        ffi.set_u16(ffi.ptr_add(redPtr, j * 2), cached.red[j])
        ffi.set_u16(ffi.ptr_add(greenPtr, j * 2), cached.green[j])
        ffi.set_u16(ffi.ptr_add(bluePtr, j * 2), cached.blue[j])
        j = j + 1
      }
    } else {
      tempColor = _kelvinToRGB(tempK)
      orig = s.originalGamma.get(monitorName)
      haveOrig = orig != null && orig.size == gammaSize

      invGammaR = 1.0 / gammaR; invGammaG = 1.0 / gammaG; invGammaB = 1.0 / gammaB
      skipGamma = math.abs(gammaR - 1.0) < 0.001 && math.abs(gammaG - 1.0) < 0.001 && math.abs(gammaB - 1.0) < 0.001
      skipShadow = shadowLiftVal <= 0.0001

      cacheRed = []; cacheGreen = []; cacheBlue = []

      j = 0
      while j < gammaSize {
        if haveOrig {
          normR = num(orig.red[j]) / 65535.0
          normG = num(orig.green[j]) / 65535.0
          normB = num(orig.blue[j]) / 65535.0
          if skipGamma { gammaRampR = normR; gammaRampG = normG; gammaRampB = normB }
          else { gammaRampR = math.pow(normR, invGammaR); gammaRampG = math.pow(normG, invGammaG); gammaRampB = math.pow(normB, invGammaB) }
        } else {
          norm = num(j) / num(gammaSize - 1)
          if skipGamma { gammaRampR = norm; gammaRampG = norm; gammaRampB = norm }
          else { gammaRampR = math.pow(norm, invGammaR); gammaRampG = math.pow(norm, invGammaG); gammaRampB = math.pow(normB, invGammaB) }
        }
        if !skipShadow {
          lifted = _applyShadowLiftColor(gammaRampR, gammaRampG, gammaRampB, shadowLiftVal)
          gammaRampR = lifted.r; gammaRampG = lifted.g; gammaRampB = lifted.b
        }
        ri = int(_clamp(gammaRampR * tempColor.r * brightness * 65535.0, 0.0, 65535.0))
        gi = int(_clamp(gammaRampG * tempColor.g * brightness * 65535.0, 0.0, 65535.0))
        bi = int(_clamp(gammaRampB * tempColor.b * brightness * 65535.0, 0.0, 65535.0))
        ffi.set_u16(ffi.ptr_add(redPtr, j * 2), ri)
        ffi.set_u16(ffi.ptr_add(greenPtr, j * 2), gi)
        ffi.set_u16(ffi.ptr_add(bluePtr, j * 2), bi)
        cacheRed.push(ri); cacheGreen.push(gi); cacheBlue.push(bi)
        j = j + 1
      }
      s.gammaRampCache.set(cacheKey, {red: cacheRed, green: cacheGreen, blue: cacheBlue, size: gammaSize})
    }
  }

  ffi.call(s.XRRSetCrtcGamma, "void", ["pointer", "uint64", "pointer"], s.display, mon.crtc, gamma)
  // Don't flush here - batch flush at end
  ffi.call(s.XRRFreeGamma, "void", ["pointer"], gamma)
  true
}

fn _flush() {
  s = _S()
  if s.display != 0 { ffi.call(s.XFlush, "int32", ["pointer"], s.display) }
}

// === Capture original gamma ramp ===
fn _captureOriginalGamma(monitorName) {
  s = _S()
  if !s.hasXRR { return }
  if !_ensureDisplay() { return }

  mi = s.monitorIndexByName.get(monitorName)
  if mi == null || mi < 0 { _releaseDisplay(); return }
  mon = s.monitors[mi]
  if mon.crtc == 0 { _releaseDisplay(); return }

  gammaSize = mon.gammaSize
  gamma = ffi.call(s.XRRGetCrtcGamma, "pointer", ["pointer", "uint64"], s.display, mon.crtc)
  if gamma == 0 { _releaseDisplay(); return }

  redPtr = ffi.get_ptr(ffi.ptr_add(gamma, 8))
  greenPtr = ffi.get_ptr(ffi.ptr_add(gamma, 16))
  bluePtr = ffi.get_ptr(ffi.ptr_add(gamma, 24))

  rArr = []; gArr = []; bArr = []
  i = 0
  while i < gammaSize {
    rArr.push(ffi.get_u16(ffi.ptr_add(redPtr, i * 2)))
    gArr.push(ffi.get_u16(ffi.ptr_add(greenPtr, i * 2)))
    bArr.push(ffi.get_u16(ffi.ptr_add(bluePtr, i * 2)))
    i = i + 1
  }
  s.originalGamma.set(monitorName, {red: rArr, green: gArr, blue: bArr, size: gammaSize})

  ffi.call(s.XRRFreeGamma, "void", ["pointer"], gamma)
  _releaseDisplay()
}

// === Read current gamma ===
fn _readCurrentGamma(monitorName) {
  s = _S()
  if !s.hasXRR { return {r: 1.0, g: 1.0, b: 1.0} }
  if !_ensureDisplay() { return {r: 1.0, g: 1.0, b: 1.0} }

  mi = s.monitorIndexByName.get(monitorName)
  if mi == null || mi < 0 { _releaseDisplay(); return {r: 1.0, g: 1.0, b: 1.0} }
  mon = s.monitors[mi]
  if mon.crtc == 0 { _releaseDisplay(); return {r: 1.0, g: 1.0, b: 1.0} }

  gamma = ffi.call(s.XRRGetCrtcGamma, "pointer", ["pointer", "uint64"], s.display, mon.crtc)
  if gamma == 0 { _releaseDisplay(); return {r: 1.0, g: 1.0, b: 1.0} }

  gammaSize = ffi.get_i32(gamma)
  redPtr = ffi.get_ptr(ffi.ptr_add(gamma, 8))
  greenPtr = ffi.get_ptr(ffi.ptr_add(gamma, 16))
  bluePtr = ffi.get_ptr(ffi.ptr_add(gamma, 24))

  mid = gammaSize / 2
  r = _clamp(num(ffi.get_u16(ffi.ptr_add(redPtr, mid * 2))) / 65535.0, 0.1, 10.0)
  g = _clamp(num(ffi.get_u16(ffi.ptr_add(greenPtr, mid * 2))) / 65535.0, 0.1, 10.0)
  b = _clamp(num(ffi.get_u16(ffi.ptr_add(bluePtr, mid * 2))) / 65535.0, 0.1, 10.0)

  ffi.call(s.XRRFreeGamma, "void", ["pointer"], gamma)
  _releaseDisplay()
  {r: r, g: g, b: b}
}

// === Gamma ramp brightness ===
fn _getGammaRampBrightness(monitorName) {
  s = _S()
  if !s.hasXRR { return -1.0 }
  if !_ensureDisplay() { return -1.0 }

  mi = s.monitorIndexByName.get(monitorName)
  if mi == null || mi < 0 { _releaseDisplay(); return -1.0 }
  mon = s.monitors[mi]
  if mon.crtc == 0 { _releaseDisplay(); return -1.0 }

  gamma = ffi.call(s.XRRGetCrtcGamma, "pointer", ["pointer", "uint64"], s.display, mon.crtc)
  if gamma == 0 { _releaseDisplay(); return -1.0 }

  gammaSize = ffi.get_i32(gamma)
  redPtr = ffi.get_ptr(ffi.ptr_add(gamma, 8))

  total = 0.0
  j = 0
  while j < gammaSize {
    total = total + num(ffi.get_u16(ffi.ptr_add(redPtr, j * 2)))
    j = j + 1
  }
  brightness = total / (num(gammaSize) * 65535.0)
  ffi.call(s.XRRFreeGamma, "void", ["pointer"], gamma)
  _releaseDisplay()
  brightness
}

// === Xrandr backlight property ===
fn _getBacklightProp(monitorName) {
  s = _S()
  if !s.hasXRR || s.brightnessAtom == 0 { return -1.0 }
  if !_ensureDisplay() { return -1.0 }

  mi = s.monitorIndexByName.get(monitorName)
  if mi == null || mi < 0 { _releaseDisplay(); return -1.0 }
  mon = s.monitors[mi]

  typePtr = ffi.allocBytes(8)
  fmtPtr = ffi.allocBytes(4)
  nitemsPtr = ffi.allocBytes(4)
  afterPtr = ffi.allocBytes(4)
  dataPtr = ffi.allocBytes(8)

  result = ffi.call(s.XRRGetOutputProperty, "int32",
    ["pointer", "uint64", "uint64", "uint64", "int64", "int64", "int32", "uint64",
     "pointer", "pointer", "pointer", "pointer", "pointer"],
    s.display, mon.output, s.brightnessAtom, 0, 8, 0, 0,
    typePtr, fmtPtr, nitemsPtr, afterPtr, dataPtr)

  v = -1.0
  if result == 0 {
    fmt = ffi.get_i32(fmtPtr)
    nitems = ffi.get_i32(nitemsPtr)
    data = ffi.get_ptr(dataPtr)
    if data != 0 && fmt == 32 && nitems >= 1 {
      raw = ffi.get_u32(data)
      if nitems >= 2 {
        minVal = ffi.get_u32(data)
        maxVal = ffi.get_u32(ffi.ptr_add(data, 4))
        if maxVal > minVal { v = num(raw) / num(maxVal - minVal) }
      } else { v = num(raw) / 65535.0 }
    }
    if data != 0 { ffi.call(s.XFree, "void", ["pointer"], data) }
  }
  ffi.free(typePtr); ffi.free(fmtPtr); ffi.free(nitemsPtr); ffi.free(afterPtr); ffi.free(dataPtr)
  _releaseDisplay()
  v
}

fn _setBacklightProp(monitorName, vue) {
  s = _S()
  if !s.hasXRR || s.brightnessAtom == 0 { return false }
  if !_ensureDisplay() { return false }

  mi = s.monitorIndexByName.get(monitorName)
  if mi == null || mi < 0 { _releaseDisplay(); return false }
  mon = s.monitors[mi]

  v = _clamp(vue, 0.0, 1.0)
  data = ffi.allocBytes(4)
  ffi.set_u32(data, int(v * 65535))

  ffi.call(s.XRRChangeOutputProperty, "int32",
    ["pointer", "uint64", "uint64", "uint64", "int32", "int32", "pointer", "int32"],
    s.display, mon.output, s.brightnessAtom, 32, 0, data, 1)
  _flush()
  ffi.free(data)
  _releaseDisplay()
  true
}

// === Sysfs fallback ===
fn _getSysfsBrightness() {
  paths = shell.exec("ls /sys/class/backlight/*/brightness 2>/dev/null; ls /sys/class/backlight/*/max_brightness 2>/dev/null")
  if !paths.success { return -1.0 }
  lines = paths.stdout.trim().split("\n")
  if #lines < 2 { return -1.0 }
  blPath = lines[0].trim(); maxPath = lines[1].trim()
  if blPath == "" || maxPath == "" { return -1.0 }
  blStr = fs.read(blPath).trim(); maxStr = fs.read(maxPath).trim()
  if blStr == "" || maxStr == "" { return -1.0 }
  cur = num(blStr); max = num(maxStr)
  if max > 0 { cur / max } else { -1.0 }
}

fn _setSysfsBrightness(vue) {
  maxPath = _shell("ls /sys/class/backlight/*/max_brightness 2>/dev/null | head -1")
  if maxPath == "" { return false }
  maxStr = fs.read(maxPath).trim()
  if maxStr == "" { return false }
  maxVal = int(maxStr)
  if maxVal <= 0 { return false }
  dir = maxPath[0:maxPath.rfind("/")]
  blPath = dir + "/brightness"
  newVal = int(_clamp(vue, 0.0, 1.0) * maxVal)
  r = shell.exec("echo " + str(newVal) + " | tee " + blPath + " >/dev/null 2>&1")
  r.success
}

// === Gammastep fallback ===
fn _setGammastep(kelvin, brightnessVal) {
  if brightnessVal == null { brightnessVal = -1.0 }
  cmd = "gammastep -P -l 0:0 -t " + str(kelvin) + ":" + str(kelvin) + " -o"
  if brightnessVal > 0.0 { cmd = cmd + " -b " + str(brightnessVal) + ":" + str(brightnessVal) }
  r = shell.exec(cmd + " 2>&1")
  if !r.success { r = shell.exec("redshift -O " + str(kelvin) + " 2>&1") }
  r.success
}

fn _resetGammastep() {
  r = shell.exec("gammastep -x 2>&1")
  if !r.success { r = shell.exec("redshift -x 2>&1") }
  r.success
}

// === Color math ===
fn _kelvinToRGB(kelvin) {
  k = _clamp(kelvin, MIN_TEMP, MAX_TEMP)
  temp = num(k) / 100.0
  if temp <= 66.0 {
    r = 255.0
    g = 99.4708025861 * math.log(temp) - 161.1195681661; g = _clamp(g, 0.0, 255.0)
    if temp <= 19.0 { b = 0.0 }
    else { b = 138.5177312231 * math.log(temp - 10.0) - 305.0447927307; b = _clamp(b, 0.0, 255.0) }
  } else {
    r = 329.698727446 * math.pow(temp - 60.0, -0.1332047592); r = _clamp(r, 0.0, 255.0)
    g = 288.1221695283 * math.pow(temp - 60.0, -0.0755148492); g = _clamp(g, 0.0, 255.0)
    b = 255.0
  }
  {r: r / 255.0, g: g / 255.0, b: b / 255.0}
}

fn _applyShadowLiftColor(r, g, b, lift) {
  if lift <= 0.0001 { return {r: r, g: g, b: b} }
  fn process(ch) {
    norm = _clamp(ch, 0.0, 1.0)
    effLift = lift
    gammaAdj = 1.0 / (1.0 + effLift)
    math.pow(norm, gammaAdj)
  }
  {r: process(r), g: process(g), b: process(b)}
}

// === Monitor name resolution ===
fn _getMonitorName(mi) {
  s = _S()
  if mi == null || mi < 0 { if #s.monitors > 0 { s.monitors[0].name } else { "" } }
  else if mi >= 0 && mi < #s.monitors { s.monitors[mi].name } else { "" }
}

// === Apply settings to single monitor ===
fn _applySettings(monitorName) {
  s = _S()
  br = s.cachedBrightness.get(monitorName)
  if br == null { br = 1.0 }
  gammaRGB = s.gammaRGB.get(monitorName)
  if gammaRGB == null { gammaRGB = {r: 1.0, g: 1.0, b: 1.0} }
  temp = s.temperature.get(monitorName)
  if temp == null { temp = 6500 }
  sl = s.shadowLift.get(monitorName)
  if sl == null { sl = 0.0 }
  _applyGammaRamp(monitorName, br, gammaRGB.r, gammaRGB.g, gammaRGB.b, temp, sl)
}

// === Apply combined settings to ALL monitors ===
fn _applyAll() {
  s = _S()
  if !s.hasXRR { return }
  if !_ensureDisplay() { return }

  for mon in s.monitors {
    br = s.cachedBrightness.get(mon.name)
    if br == null { br = 1.0 }
    gammaRGB = s.gammaRGB.get(mon.name)
    if gammaRGB == null { gammaRGB = {r: 1.0, g: 1.0, b: 1.0} }
    temp = s.temperature.get(mon.name)
    if temp == null { temp = 6500 }
    sl = s.shadowLift.get(mon.name)
    if sl == null { sl = 0.0 }
    _applyGammaRamp(mon.name, br, gammaRGB.r, gammaRGB.g, gammaRGB.b, temp, sl)
  }
  _flush()
}

// === Initialization ===
fn init() {
  s = _S()
  if s.initialized { return }
  _loadLibraries()
  _loadNativeRampBuilder()
  print("[brightness] init: hasXRR=" + str(s.hasXRR) + " x11=" + str(s.x11 != 0) + " xrandr=" + str(s.xrandr != 0))
  print("[brightness] init: native ramp=" + str(s.fillGammaRamp != 0))
  _enumMonitors()
  print("[brightness] init: monitors=" + str(#s.monitors))
  for mon in s.monitors {
    s.temperature.set(mon.name, 6500)
    s.gammaRGB.set(mon.name, {r: 1.0, g: 1.0, b: 1.0})
    s.shadowLift.set(mon.name, 0.0)
    s.cachedBrightness.set(mon.name, 1.0)
    _captureOriginalGamma(mon.name)
  }
  s.initialized = true
}

// Auto-initialization helper
fn _ensureInit() {
  s = _S()
  if !s.initialized { init() }
}

// === Public API ===

fn getBrightness(monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  monName = _getMonitorName(mi)
  if monName == "" { return 1.0 }
  cached = s.cachedBrightness.get(monName)
  if cached != null { return cached }
  br = _getGammaRampBrightness(monName)
  if br < 0 { br = _getBacklightProp(monName) }
  if br < 0 { br = _getSysfsBrightness() }
  if br < 0 { br = 1.0 }
  s.cachedBrightness.set(monName, br)
  br
}

fn getHardwareBrightness(monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  monName = _getMonitorName(mi)
  if monName == "" { return -1.0 }
  v = _getSysfsBrightness()
  if v >= 0 { return v }
  v = _getBacklightProp(monName)
  if v >= 0 { return v }
  -1.0
}

fn getXrandrBrightness(monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  monName = _getMonitorName(mi)
  if monName == "" { return -1.0 }
  out = _shell("xrandr --verbose --query")
  if out == "" { return -1.0 }
  lines = out.split("\n")
  foundMon = false; i = 0
  while i < #lines {
    line = lines[i]
    if line.startsWith(monName + " ") || line.startsWith(monName + "\t") { foundMon = true }
    if foundMon && line.find("Brightness:") >= 0 {
      parts = line.split(":")
      if #parts >= 2 { return _clamp(num(parts[1].trim()), 0.0, 2.0) }
    }
    if foundMon && line != "" && !line.startsWith("\t") && !line.startsWith(" ") && !line.startsWith(monName + " connected") { foundMon = false }
    i = i + 1
  }
  -1.0
}

fn setBrightness(vue, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        v = _clamp(vue, 0.0, 1.0)
        s.cachedBrightness.set(monName, v)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    v = _clamp(vue, 0.0, 1.0)
    s.cachedBrightness.set(monName, v)
    _applySettings(monName)
  }
}

fn increaseBrightness(step, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if step == null || step <= 0 { step = DEFAULT_BRIGHTNESS_AMOUNT }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getBrightness(i)
        setBrightness(_clamp(cur + step, 0.0, 1.0), i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName != "" {
      cur = getBrightness(mi)
      setBrightness(_clamp(cur + step, 0.0, 1.0), mi)
    }
  }
}

fn decreaseBrightness(step, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if step == null { step = DEFAULT_BRIGHTNESS_AMOUNT }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getBrightness(i)
        setBrightness(_clamp(cur - step, 0.0, 1.0), i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName != "" {
      cur = getBrightness(mi)
      setBrightness(_clamp(cur - step, 0.0, 1.0), mi)
    }
  }
}

fn getTemperature(monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  monName = _getMonitorName(mi)
  if monName == "" { return 6500 }
  t = s.temperature.get(monName)
  if t != null { print("[brightness] getTemperature: monitor=" + monName + " temp=" + str(t)); return t }
  print("[brightness] getTemperature: monitor=" + monName + " temp=6500 (default)")
  return 6500
}

fn setTemperature(kelvin, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        k = int(_clamp(kelvin, MIN_TEMP, MAX_TEMP))
        s.temperature.set(monName, k)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    k = int(_clamp(kelvin, MIN_TEMP, MAX_TEMP))
    s.temperature.set(monName, k)
    _applySettings(monName)
  }
}

fn increaseTemperature(amount, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if amount == null { amount = DEFAULT_TEMP_AMOUNT }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getTemperature(i)
        setTemperature(cur + amount, i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    cur = getTemperature(mi)
    setTemperature(cur + amount, mi)
  }
}

fn decreaseTemperature(amount, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if amount == null { amount = DEFAULT_TEMP_AMOUNT }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getTemperature(i)
        setTemperature(cur - amount, i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    cur = getTemperature(mi)
    setTemperature(cur - amount, mi)
  }
}

fn setGammaRGB(r, g, b, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        gr = _clamp(r, 0.1, 10.0); gg = _clamp(g, 0.1, 10.0); gb = _clamp(b, 0.1, 10.0)
        s.gammaRGB.set(monName, {r: gr, g: gg, b: gb})
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    gr = _clamp(r, 0.1, 10.0); gg = _clamp(g, 0.1, 10.0); gb = _clamp(b, 0.1, 10.0)
    s.gammaRGB.set(monName, {r: gr, g: gg, b: gb})
    _applySettings(monName)
  }
}

fn getGammaRGB(monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  monName = _getMonitorName(mi)
  if monName == "" { return {r: 1.0, g: 1.0, b: 1.0} }
  cached = s.gammaRGB.get(monName)
  if cached != null { cached }
  else { rgb = _readCurrentGamma(monName); s.gammaRGB.set(monName, rgb); rgb }
}

fn getGammaR(monitorIndex) { rgb = getGammaRGB(monitorIndex); if rgb != null { rgb.r } else { 1.0 } }
fn getGammaG(monitorIndex) { rgb = getGammaRGB(monitorIndex); if rgb != null { rgb.g } else { 1.0 } }
fn getGammaB(monitorIndex) { rgb = getGammaRGB(monitorIndex); if rgb != null { rgb.b } else { 1.0 } }
fn getGamma(monitorIndex) { getGammaR(monitorIndex) }

fn setGamma(gamma, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 { i = 0; while i < #s.monitors { setGamma(gamma, i); i = i + 1 } }
  else {
    g = _clamp(gamma, 0.1, 10.0)
    setGammaRGB(g, g, g, mi)
  }
}

fn increaseGamma(amount, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if amount == null { amount = DEFAULT_GAMMA_AMOUNT }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getGammaRGB(i)
        step = num(amount) / 1000.0
        setGammaRGB(cur.r + step, cur.g + step, cur.b + step, i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    cur = getGammaRGB(mi)
    step = num(amount) / 1000.0
    setGammaRGB(cur.r + step, cur.g + step, cur.b + step, mi)
  }
}

fn decreaseGamma(amount, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if amount == null { amount = DEFAULT_GAMMA_AMOUNT }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getGammaRGB(i)
        step = num(amount) / 1000.0
        setGammaRGB(math.max(0.1, cur.r - step), math.max(0.1, cur.g - step), math.max(0.1, cur.b - step), i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    cur = getGammaRGB(mi)
    step = num(amount) / 1000.0
    setGammaRGB(math.max(0.1, cur.r - step), math.max(0.1, cur.g - step), math.max(0.1, cur.b - step), mi)
  }
}

fn getShadowLift(monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  monName = _getMonitorName(mi)
  if monName == "" { return 0.0 }
  v = s.shadowLift.get(monName); if v != null { v } else { 0.0 }
}

fn setShadowLift(lift, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        if lift > SHADOW_LIFT_MAX { return }
        if lift < 0.0 { return }
        s.shadowLift.set(monName, lift)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    if lift > SHADOW_LIFT_MAX { return }
    if lift < 0.0 { return }
    s.shadowLift.set(monName, lift)
    _applySettings(monName)
  }
}

fn increaseShadowLift(amount, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if amount == null { amount = 0.1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getShadowLift(i)
        setShadowLift(cur + amount, i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    cur = getShadowLift(mi); setShadowLift(cur + amount, mi)
  }
}

fn decreaseShadowLift(amount, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if amount == null { amount = 0.1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        cur = getShadowLift(i)
        setShadowLift(cur - amount, i)
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    cur = getShadowLift(mi); setShadowLift(cur - amount, mi)
  }
}

// Combined setters
fn setBrightnessAndRGB(brightness, r, g, b, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        s.cachedBrightness.set(monName, _clamp(brightness, 0.0, 1.0))
        s.gammaRGB.set(monName, {r: _clamp(r, 0.1, 10.0), g: _clamp(g, 0.1, 10.0), b: _clamp(b, 0.1, 10.0)})
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    s.cachedBrightness.set(monName, _clamp(brightness, 0.0, 1.0))
    s.gammaRGB.set(monName, {r: _clamp(r, 0.1, 10.0), g: _clamp(g, 0.1, 10.0), b: _clamp(b, 0.1, 10.0)})
    _applySettings(monName)
  }
}

fn setBrightnessAndTemperature(brightness, kelvin, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        s.cachedBrightness.set(monName, _clamp(brightness, 0.0, 1.0))
        s.temperature.set(monName, int(_clamp(kelvin, MIN_TEMP, MAX_TEMP)))
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    s.cachedBrightness.set(monName, _clamp(brightness, 0.0, 1.0))
    s.temperature.set(monName, int(_clamp(kelvin, MIN_TEMP, MAX_TEMP)))
    _applySettings(monName)
  }
}

fn setBrightnessAndShadowLift(brightness, lift, monitorIndex) {
  _ensureInit()
  s = _S()
  mi = monitorIndex; if mi == null { mi = -1 }
  if mi < 0 {
    i = 0
    while i < #s.monitors {
      monName = _getMonitorName(i)
      if monName != "" {
        s.cachedBrightness.set(monName, _clamp(brightness, 0.0, 1.0))
        if lift <= SHADOW_LIFT_MAX && lift >= 0.0 {
          s.shadowLift.set(monName, lift)
        }
      }
      i = i + 1
    }
    _applyAll()
  } else {
    monName = _getMonitorName(mi)
    if monName == "" { return }
    s.cachedBrightness.set(monName, _clamp(brightness, 0.0, 1.0))
    if lift <= SHADOW_LIFT_MAX && lift >= 0.0 {
      s.shadowLift.set(monName, lift)
    }
    _applySettings(monName)
  }
}

fn getMonitors() {
  _ensureInit()
  s = _S()
  names = []
  for m in s.monitors { names.push(m.name) }
  names
}

fn getMonitor(index) {
  _ensureInit()
  s = _S()
  if index >= 0 && index < #s.monitors { s.monitors[index] } else { null }
}

// Aliases for convenience (top-level so the module loader exposes them)
// Note: 'get = getBrightness' triggers a compiler bug that breaks all exports
set = setBrightness
increase = increaseBrightness
decrease = decreaseBrightness

init()