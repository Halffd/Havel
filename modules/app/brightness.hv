  _ensureInit()
  s = _S()
  if amount == null { amount = DEFAULT_TEMP_AMOUNT }
  if monitor == null { monitor = s.primaryMonitor }
  t = s.temperature.get(monitor)
  if t == null { t = 6500 }
  t = _clamp(t + amount, MIN_TEMP, MAX_TEMP)
  s.temperature.set(monitor, t)
  _applyGamma(monitor, s.gammaRGB.get(monitor).r, s.gammaRGB.get(monitor).g, s.gammaRGB.get(monitor).b, s.cachedBrightness.get(monitor))
}

fn decreaseTemperature(amount, monitor) {
  _ensureInit()
  s = _S()
  if amount == null { amount = DEFAULT_TEMP_AMOUNT }
  if monitor == null { monitor = s.primaryMonitor }
  t = s.temperature.get(monitor)
  if t == null { t = 6500 }
  t = _clamp(t - amount, MIN_TEMP, MAX_TEMP)
  s.temperature.set(monitor, t)
  _applyGamma(monitor, s.gammaRGB.get(monitor).r, s.gammaRGB.get(monitor).g, s.gammaRGB.get(monitor).b, s.cachedBrightness.get(monitor))
}

fn getShadowLift(monitor) {
  _ensureInit()
  s = _S()
  if monitor == null { return s.shadowLift.get(s.primaryMonitor) }
  s.shadowLift.get(monitor)
}

fn setShadowLift(lift, monitor) {
  _ensureInit()
  s = _S()
  l = _clamp(lift, 0.0, SHADOW_LIFT_MAX)
  if monitor == null { monitor = s.primaryMonitor }
  s.shadowLift.set(monitor, l)
  _applyGamma(monitor, s.gammaRGB.get(monitor).r, s.gammaRGB.get(monitor).g, s.gammaRGB.get(monitor).b, s.cachedBrightness.get(monitor))
}

// Aliases for convenience (top-level so the module loader exposes them)
set = setBrightness
increase = increaseBrightness
decrease = decreaseBrightness

init()
