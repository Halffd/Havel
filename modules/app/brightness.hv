// brightness.hv — Brightness/gamma/temperature control via host functions
// Provides a clean API over the C++ BrightnessManager
//
// Usage:
//   use "app/brightness" as brightness
//   b = brightness.get()
//   brightness.set(0.5)
//
// Per-monitor control:
//   brightness.increase(amount, monitorName)   // name or numeric index
//   brightness.decrease(amount, monitorName)   // name or numeric index

// Host functions are registered as global brightness.* functions
// No need to import anything - they're available as brightness.get(), etc.

fn get() {
    brightness.get()
}

fn set(val) {
    brightness.set(val)
}

fn getTemperature() {
    brightness.getTemperature()
}

fn setTemperature(kelvin) {
    brightness.setTemperature(kelvin)
}

fn getGamma() {
    brightness.getGamma()
}

fn setGamma(r, g, b) {
    brightness.setGamma(r, g, b)
}

fn setGammaRGB(r, g, b) {
    brightness.setGammaRGB(r, g, b)
}

fn getShadowLift() {
    brightness.getShadowLift()
}

fn setShadowLift(lift) {
    brightness.setShadowLift(lift)
}

fn getMonitors() {
    brightness.getMonitors()
}

// Convenience functions. No monitor argument: step ALL monitors, each
// from its own current value (host per-monitor increment, preserves
// relative differences). With a monitor name or numeric index: step
// only that monitor.
fn increase(amount = 0.02, monitor = nil) {
    if monitor != nil {
        brightness.increase(amount, monitor)
    } else {
        brightness.increase(amount)
    }
}

fn decrease(amount = 0.02, monitor = nil) {
    if monitor != nil {
        brightness.decrease(amount, monitor)
    } else {
        brightness.decrease(amount)
    }
}

// Per-monitor brightness control (delegates to the host functions):
//   brightness.increase(0.1, "HDMI-0")   // by output name
//   brightness.increase(0.1, 0)          // by monitor index
//   let monitors = brightness.getMonitors()
//   let m0 = monitors[0]
//   brightness.increase(0.1, m0)
//   brightness.decrease(0.1, m0)

fn toggle() {
    let current = brightness.get()
    if current > 0.5 {
        brightness.set(0.0)
    } else {
        brightness.set(1.0)
    }
}

fn increaseTemperature(amount = 200) {
    let current = brightness.getTemperature()
    brightness.setTemperature(current + amount)
}

fn decreaseTemperature(amount = 200) {
    let current = brightness.getTemperature()
    brightness.setTemperature(current - amount)
}

fn increaseGamma(amount = 0.1) {
    let g = brightness.getGamma()
    brightness.setGamma(g.red + amount, g.green + amount, g.blue + amount)
}

fn decreaseGamma(amount = 0.1) {
    let g = brightness.getGamma()
    brightness.setGamma(g.red - amount, g.green - amount, g.blue - amount)
}

// Mode helpers (day/night)
fn setMode(mode) {
    // mode: "day" or "night"
    if mode == "day" {
        brightness.set(1.0)
        brightness.setTemperature(6500)
        brightness.setGamma(1.0, 1.0, 1.0)
    } else if mode == "night" {
        brightness.set(0.3)
        brightness.setTemperature(3000)
        brightness.setGamma(1.2, 1.1, 1.0)
    }
}

fn getMode() {
    // Simple heuristic based on brightness
    let b = brightness.get()
    if b > 0.7 { "day" } else { "night" }
}

// Individual gamma component getters
fn getGammaR() { let g = brightness.getGamma(); g.red }
fn getGammaG() { let g = brightness.getGamma(); g.green }
fn getGammaB() { let g = brightness.getGamma(); g.blue }
