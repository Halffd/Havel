// compositor.hv — Wayland/X11 compositor and desktop environment detection
// Provides: detect(), isWayland(), isX11(), name(), desktop(),
// checkUinput(), uinputStatus(),
// createWorkspace(name), switchWorkspace(name)
//
// Usage:
//   use compositor
//   print(compositor.detect())      // "hyprland"
//   print(compositor.isWayland())   // true
//   print(compositor.checkUinput()) // {ok: true, err: ""}
//   print(compositor.createWorkspace("AI_Gaming")) // {ok: true, err: ""}

use env
use shell

_cached = null

fn detect() {
	if _cached != null { return _cached }
	if env.get("HYPRLAND_INSTANCE_SIGNATURE") != null {
		_cached = "hyprland"
		return _cached
	}
	if env.get("SWAYSOCK") != null {
		_cached = "sway"
		return _cached
	}
	_xdg = env.get("XDG_CURRENT_DESKTOP") ?? ""
	_xdgLower = _xdg.lower()
	if _xdgLower ~ "hyprland" {
		_cached = "hyprland"
		return _cached
	}
	if _xdgLower ~ "sway" {
		_cached = "sway"
		return _cached
	}
	if _xdgLower ~ "gnome" {
		_cached = "gnome"
		return _cached
	}
	if _xdgLower ~ "kde" {
		_cached = "kde"
		return _cached
	}
	if _xdgLower ~ "cinnamon" {
		_cached = "cinnamon"
		return _cached
	}
	if _xdgLower ~ "xfce" {
		_cached = "xfce"
		return _cached
	}
	if _xdgLower ~ "mate" {
		_cached = "mate"
		return _cached
	}
	if _xdgLower ~ "lxqt" {
		_cached = "lxqt"
		return _cached
	}
	_r = shell.exec("pgrep -x hyprland 2>/dev/null")
	if _r.code == 0 { _cached = "hyprland"; return _cached }
	_r = shell.exec("pgrep -x sway 2>/dev/null")
	if _r.code == 0 { _cached = "sway"; return _cached }
	_r = shell.exec("pgrep -x kwin_wayland 2>/dev/null")
	if _r.code == 0 { _cached = "kde"; return _cached }
	_r = shell.exec("pgrep -x gnome-shell 2>/dev/null")
	if _r.code == 0 { _cached = "gnome"; return _cached }
	_r = shell.exec("pgrep -x cinnamon 2>/dev/null")
	if _r.code == 0 { _cached = "cinnamon"; return _cached }
	_r = shell.exec("pgrep -x wayfire 2>/dev/null")
	if _r.code == 0 { _cached = "wayfire"; return _cached }
	_r = shell.exec("pgrep -x river 2>/dev/null")
	if _r.code == 0 { _cached = "river"; return _cached }
	if env.get("WAYLAND_DISPLAY") != null {
		_cached = "wayland"
		return _cached
	}
	if env.get("DISPLAY") != null {
		_r = shell.exec("pgrep -x kwin_x11 2>/dev/null")
		if _r.code == 0 { _cached = "kde"; return _cached }
		_r = shell.exec("pgrep -x i3 2>/dev/null")
		if _r.code == 0 { _cached = "i3"; return _cached }
		_r = shell.exec("pgrep -x bspwm 2>/dev/null")
		if _r.code == 0 { _cached = "bspwm"; return _cached }
		_r = shell.exec("pgrep -x dwm 2>/dev/null")
		if _r.code == 0 { _cached = "dwm"; return _cached }
		_r = shell.exec("pgrep -x openbox 2>/dev/null")
		if _r.code == 0 { _cached = "openbox"; return _cached }
		_cached = "x11"
		return _cached
	}
	_cached = "unknown"
	_cached
}

fn isWayland() {
	_c = detect()
	_c == "hyprland" || _c == "sway" || _c == "gnome" || _c == "kde" || _c == "cinnamon" || _c == "wayfire" || _c == "river" || _c == "wayland"
}

// ---- Workspaces --------------------------------------------------------
//
// createWorkspace(name) creates a workspace with the given name and, on the
// compositors whose IPC creates-and-switches, switches to it. Returns
// {ok: bool, err: ""} - never throws, so a script can branch on it.
//
// Per-compositor IPC:
//   sway      swaymsg workspace <name>          (creates and switches)
//   hyprland  hyprctl dispatch workspace <name> (creates implicitly)
//   i3        i3-msg workspace <name>         (creates and switches)
//   kde       qdbus org.kde.KWin /KWin org.kde.KWin.showDesktopInterface? no -
//             KWin 6 exposes workspaces over qdbus; creating one by name is
//             not supported, so the name is reported as unsupported.
//   gnome     gnome-shell has no create-by-name IPC; unsupported.
//   x11/wm    unsupported.

fn _runCmd(cmd) {
	shell.exec(cmd)
}

fn createWorkspace(name) {
	if name == null || name == "" {
		return {ok: false, err: "workspace name is required"}
	}
	_c = detect()
	_q = "'" + name.replace("'", "") + "'"
	_res = null
	if _c == "sway" {
		_res = _runCmd("swaymsg workspace " + _q + " 2>&1")
	} else if _c == "hyprland" {
		_res = _runCmd("hyprctl dispatch workspace " + _q + " 2>&1")
	} else if _c == "i3" {
		_res = _runCmd("i3-msg workspace " + _q + " 2>&1")
	} else if _c == "kde" {
		return {ok: false, err: "KDE Plasma does not support creating a workspace by name"}
	} else if _c == "gnome" {
		return {ok: false, err: "GNOME does not support creating a workspace by name"}
	} else {
		return {ok: false, err: "compositor '" + _c + "' does not support workspace creation"}
	}
	if _res == null {
		return {ok: false, err: "no result"}
	}
	_out = (_res.stdout ?? "") + (_res.stderr ?? "")
	if _res.code != 0 {
		return {ok: false, err: _out.trim()}
	}
	{ok: true, err: ""}
}

// switchWorkspace(name) - switch to an existing workspace (no creation).
fn switchWorkspace(name) {
	if name == null || name == "" {
		return {ok: false, err: "workspace name is required"}
	}
	_c = detect()
	_q = "'" + name.replace("'", "") + "'"
	_res = null
	if _c == "sway" {
		_res = _runCmd("swaymsg workspace " + _q + " 2>&1")
	} else if _c == "hyprland" {
		_res = _runCmd("hyprctl dispatch workspace " + _q + " 2>&1")
	} else if _c == "i3" {
		_res = _runCmd("i3-msg workspace " + _q + " 2>&1")
	} else {
		return {ok: false, err: "compositor '" + _c + "' does not support workspace switching"}
	}
	_out = (_res.stdout ?? "") + (_res.stderr ?? "")
	if _res.code != 0 {
		return {ok: false, err: _out.trim()}
	}
	{ok: true, err: ""}
}

fn isX11() {
	_c = detect()
	_c == "i3" || _c == "bspwm" || _c == "dwm" || _c == "openbox" || _c == "xfce" || _c == "mate" || _c == "lxqt" || _c == "x11"
}

fn name() { detect() }

fn desktop() { env.get("XDG_CURRENT_DESKTOP") ?? "" }

fn session() { env.get("XDG_SESSION_TYPE") ?? "" }

fn reset() { _cached = null }

fn checkUinput() {
	if !fs.exists("/dev/uinput") {
		return {ok: false, err: "uinput device not found — kernel uinput module required (modprobe uinput)"}
	}
	if !fs.writable("/dev/uinput") {
		return {ok: false, err: "no write access to /dev/uinput — run: sudo usermod -aG input $USER"}
	}
	{ok: true, err: ""}
}

fn uinputStatus() {
	_r = checkUinput()
	if _r.ok {
		return "uinput: available"
	}
	"uinput: {_r.err}"
}
