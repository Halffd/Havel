// modules/app/io.hv - Pure Havel IO module
// Bridge functions (io._*) registered at startup by VMHostFunctions.cpp.
// This module builds the io namespace and public API entirely in Havel.

// Build io namespace object from dotted host function globals.
// Bridge fns are registered as globals named "io._send", "io._map", etc.
// Pull them into an object so wrapper functions can close over it.
io = {}
io._send              = _G["io._send"]
io._sendX11Key        = _G["io._sendX11Key"]
io._map               = _G["io._map"]
io._remap             = _G["io._remap"]
io._unmap             = _G["io._unmap"]
io._emergencyRelease  = _G["io._emergencyRelease"]
io._ungrabAll         = _G["io._ungrabAll"]
io._setEvdevGrab      = _G["io._setEvdevGrab"]
io._setBlockInput     = _G["io._setBlockInput"]
io._getEvdevGrab      = _G["io._getEvdevGrab"]
io._suspend           = _G["io._suspend"]
io._resume            = _G["io._resume"]
io._isSuspended       = _G["io._isSuspended"]
io._isKeyPressed      = _G["io._isKeyPressed"]
io._isShiftPressed    = _G["io._isShiftPressed"]
io._isCtrlPressed     = _G["io._isCtrlPressed"]
io._isAltPressed      = _G["io._isAltPressed"]
io._isWinPressed      = _G["io._isWinPressed"]
io._getCurrentModifiers = _G["io._getCurrentModifiers"]
io._setExecutorMode   = _G["io._setExecutorMode"]
io._getExecutorMode   = _G["io._getExecutorMode"]
io._mouseMove         = _G["io._mouseMove"]
io._mouseMoveTo       = _G["io._mouseMoveTo"]
io._mouseClick        = _G["io._mouseClick"]
io._mouseDown         = _G["io._mouseDown"]
io._mouseUp           = _G["io._mouseUp"]
io._scroll            = _G["io._scroll"]
io._getMousePosition  = _G["io._getMousePosition"]
io._setMouseSensitivity = _G["io._setMouseSensitivity"]
io._getMouseSensitivity = _G["io._getMouseSensitivity"]
io._sleepMs           = _G["io._sleepMs"]
io._mouseState        = _G["io._mouseState"]
io._lastLocks         = _G["io._lastLocks"]
io._locks             = _G["io._locks"]
io._setLock           = _G["io._setLock"]
io._devices           = _G["io._devices"]
io._addDevice         = _G["io._addDevice"]
io._isRecording       = _G["io._isRecording"]
io._recordStart       = _G["io._recordStart"]
io._recordStop        = _G["io._recordStop"]

// Mode mapping
_modeMap = {
  "scheduler": 0,
  "executor": 1,
  "sync": 2,
  "thread": 3
}

_modeNames = ["scheduler", "executor", "sync", "thread"]

fn _modeToInt(mode) {
  m = mode.lower()
  v = _modeMap[m]
  if v != nil { v } else { 0 }
}

fn _intToMode(idx) {
  if idx >= 0 && idx < #_modeNames { _modeNames[idx] } else { "scheduler" }
}

fn sendKeys(keys) { io._send(str(keys)) }

fn sendKey(key) {
  io._sendX11Key(str(key), true)
  io._sleepMs(50)
  io._sendX11Key(str(key), false)
}

fn keyDown(key) { io._sendX11Key(str(key), true) }

fn keyUp(key) { io._sendX11Key(str(key), false) }

fn map(src, dst) { io._map(str(src), str(dst)) }

fn remap(src, dst) { io._remap(str(src), str(dst)) }

fn unmap(src) { io._unmap(str(src)) }

fn block() { io._setBlockInput(true); io._setEvdevGrab(true) }

fn unblock() { io._setEvdevGrab(false); io._ungrabAll(); io._setBlockInput(false) }

fn suspend() { io._suspend() }

fn resume() { io._resume() }

fn isSuspended() { io._isSuspended() }

fn grab() { io._setEvdevGrab(true) }

fn ungrab() { io._setEvdevGrab(false); io._ungrabAll(); io._setBlockInput(false) }

fn emergencyRelease() { io._emergencyRelease() }

fn isKeyPressed(key) { io._isKeyPressed(str(key)) }

fn isShiftPressed() { io._isShiftPressed() }

fn isCtrlPressed() { io._isCtrlPressed() }

fn isAltPressed() { io._isAltPressed() }

fn isWinPressed() { io._isWinPressed() }

fn getCurrentModifiers() { io._getCurrentModifiers() }

fn setExecutorMode(mode) { io._setExecutorMode(_modeToInt(mode)) }

fn getExecutorMode() { _intToMode(io._getExecutorMode()) }

fn mouseMove(dx, dy, speed) { io._mouseMove(dx, dy, speed || 1) }

fn mouseMoveTo(x, y, speed) { io._mouseMoveTo(x, y, speed || 1) }

fn mouseClick(button) { io._mouseClick(button || 1) }

fn mouseDoubleClick(button) {
  b = button || 1
  io._mouseClick(b)
  io._sleepMs(50)
  io._mouseClick(b)
}

fn mousePress(button) { io._mouseDown(button || 1) }

fn mouseRelease(button) { io._mouseUp(button || 1) }

fn scroll(dy, dx) { io._scroll(dy || 0, dx || 0) }

fn getMousePosition() { io._getMousePosition() }

fn setMouseSensitivity(s) { io._setMouseSensitivity(s) }

fn getMouseSensitivity() { io._getMouseSensitivity() }

fn sleepMs(ms) { io._sleepMs(ms) }

fn mouseState(button) { io._mouseState(button || 1) }

fn lastLocks() { io._lastLocks() }

fn locks() { io._locks() }

fn setLock(name, state) { io._setLock(name, state) }

fn devices() { io._devices() }

fn addDevice(path, type) { io._addDevice(path, type || nil) }

fn _modeToInt(mode) {
  m = mode.lower()
  v = _modeMap[m]
  if v != nil { v } else { 0 }
}

fn _intToMode(idx) {
  if idx >= 0 && idx < #_modeNames { _modeNames[idx] } else { "scheduler" }
}

fn _sendModifiersAt(parts, press, i) {
  if i >= #parts { nil }
  else {
    p = parts[i]
    if p == "ctrl" || p == "control" { io._sendX11Key("ctrl", press) }
    else if p == "shift" { io._sendX11Key("shift", press) }
    else if p == "alt" { io._sendX11Key("alt", press) }
    else if p == "super" || p == "win" || p == "meta" { io._sendX11Key("super", press) }
    _sendModifiersAt(parts, press, i + 1)
  }
}

fn sendModifiers(mods, press) {
  if mods == nil || mods == "" {
    if !press { io._sendX11Key("ctrl", false); io._sendX11Key("shift", false); io._sendX11Key("alt", false); io._sendX11Key("super", false) }
    nil
  } else {
    parts = str(mods).lower().split("+")
    _sendModifiersRec(parts, press, 0)
    nil
  }
}

fn _sendModifiersRec(parts, press, i) {
  if i >= #parts { nil }
  else {
    p = parts[i]
    if p == "ctrl" || p == "control" { io._sendX11Key("ctrl", press) }
    else if p == "shift" { io._sendX11Key("shift", press) }
    else if p == "alt" { io._sendX11Key("alt", press) }
    else if p == "super" || p == "win" || p == "meta" { io._sendX11Key("super", press) }
    _sendModifiersRec(parts, press, i + 1)
  }
}

fn sendKeyState(key, press) {
  if press { io._sendX11Key(str(key), true) }
  else { io._sendX11Key(str(key), false) }
}

fn sendKeyState(key, state) {
  if state == "down" || state == "press" || state == true { io._sendX11Key(str(key), true) }
  else if state == "release" || state == "up" || state == false { io._sendX11Key(str(key), false) }
  else { io._sendX11Key(str(key), state == "press" || state == true) }
}

fn record(stopKey) {
  io._recordStart("")
  while io._isRecording() { io._sleepMs(10) }
  evs = io._recordStop()
  if evs == nil { [] } else { evs }
}

fn play(events) {
  if events == nil { nil }
  else {
    last = 0.0
    for ev in events {
      dt = ev.time - last
      if dt > 0.5 { io._sleepMs(int(dt)) }
      last = ev.time
      if ev.type == 0 {
        if ev.keyName != nil && ev.keyName != "" { sendKeyState(ev.keyName, ev.down) }
      } else if ev.type == 1 {
        btn = ev.buttonNumber != nil && ev.buttonNumber > 0 ? ev.buttonNumber : 1
        if ev.down { mousePress(btn) } else { mouseRelease(btn) }
      } else if ev.type == 2 {
        io._mouseMove(ev.dx, ev.dy, 1)
      } else if ev.type == 3 {
        io._scroll(ev.value > 0 ? 1.0 : -1.0, 0.0)
      }
    }
    nil
  }
}

fn recordScript(stopKey) {
  events = record(stopKey)
  n = #events
  if n == 0 { "" } else {
    result = "// recorded " + str(n) + " events\nio.play([\n"
    for i in 0..n {
      ev = events[i]
      sep = i < n - 1 ? "," : ""
      kn = ""
      bn = ""
      if ev.keyName != nil && ev.keyName != "" { kn = ", keyName: \"" + ev.keyName + "\"" }
      if ev.buttonNumber != nil && ev.buttonNumber > 0 { bn = ", buttonNumber: " + str(ev.buttonNumber) }
      result += "  {type: " + str(ev.type) + ", code: " + str(ev.code) + ", value: " + str(ev.value) + ", down: " + str(ev.down) + ", dx: " + str(ev.dx) + ", dy: " + str(ev.dy) + ", time: " + str(ev.time) + kn + bn + "}" + sep + "\n"
    }
    result += "])\n"
    result
  }
}

// Attach public API functions as fields so io.map / io.unmap / etc. work
// when io is used as a global object (without `use io`).
io.sendKeys = sendKeys
io.sendKey = sendKey
io.keyDown = keyDown
io.keyUp = keyUp
io.map = map
io.remap = remap
io.unmap = unmap
io.block = block
io.unblock = unblock
io.suspend = suspend
io.resume = resume
io.isSuspended = isSuspended
io.grab = grab
io.ungrab = ungrab
io.emergencyRelease = emergencyRelease
io.isKeyPressed = isKeyPressed
io.isShiftPressed = isShiftPressed
io.isCtrlPressed = isCtrlPressed
io.isAltPressed = isAltPressed
io.isWinPressed = isWinPressed
io.getCurrentModifiers = getCurrentModifiers
io.setExecutorMode = setExecutorMode
io.getExecutorMode = getExecutorMode
io.mouseMove = mouseMove
io.mouseMoveTo = mouseMoveTo
io.mouseClick = mouseClick
io.mouseDoubleClick = mouseDoubleClick
io.mousePress = mousePress
io.mouseRelease = mouseRelease
io.scroll = scroll
io.getMousePosition = getMousePosition
io.setMouseSensitivity = setMouseSensitivity
io.getMouseSensitivity = getMouseSensitivity
io.sleepMs = sleepMs
io.mouseState = mouseState
io.lastLocks = lastLocks
io.locks = locks
io.setLock = setLock
io.devices = devices
io.addDevice = addDevice
io.sendModifiers = sendModifiers
io.sendKeyState = sendKeyState
io.record = record
io.play = play
io.recordScript = recordScript

// Set io as global for backward compat
_G["io"] = io
