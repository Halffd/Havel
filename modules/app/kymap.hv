_name_to_key = {}
_evdev_to_name = {}
_x11_to_name = {}
_win_to_name = {}

fn _addKey(name, evdev, x11, win) {
  _name_to_key[name] = {evdev: evdev, x11: x11, win: win, aliases: []}
  if evdev != 0 { _evdev_to_name[evdev] = name }
  if x11 != 0 { _x11_to_name[x11] = name }
  if win != 0 { _win_to_name[win] = name }
}

fn _addAlias(alias, primary) {
  _entry = _name_to_key[primary]
  if _entry == null { return }
  _entry.aliases.push(alias)
  // Mirrors the C++ struct copy: the alias entry carries the primary's codes
  // and a snapshot of its alias list taken at this point.
  _name_to_key[alias] = {
    evdev: _entry.evdev,
    x11: _entry.x11,
    win: _entry.win,
    aliases: _entry.aliases.copy(),
  }
}

fn _init() {
  _i = 0
  _len = #_KEY_TABLE
  while _i < _len {
    _row = _KEY_TABLE[_i]
    _addKey(_row[0], _row[1], _row[2], _row[3])
    _i = _i + 1
  }
  _i = 0
  _len = #_ALIAS_TABLE
  while _i < _len {
    _row = _ALIAS_TABLE[_i]
    _addAlias(_row[0], _row[1])
    _i = _i + 1
  }
}

_init()

fn fromString(name) {
  _e = _name_to_key[name]
  if _e == null { return 0 }
  _e.evdev
}

fn toX11(name) {
  _e = _name_to_key[name]
  if _e == null { return 0 }
  _e.x11
}

fn toWindows(name) {
  _e = _name_to_key[name]
  if _e == null { return 0 }
  _e.win
}

fn evdevToString(code) {
  _n = _evdev_to_name[code]
  if _n == null { return "" }
  _n
}

fn x11ToString(keysym) {
  _n = _x11_to_name[keysym]
  if _n == null { return "" }
  _n
}

fn windowsToString(vk) {
  _n = _win_to_name[vk]
  if _n == null { return "" }
  _n
}

fn evdevToX11(evdev) {
  _n = _evdev_to_name[evdev]
  if _n == null { return 0 }
  toX11(_n)
}

fn x11ToEvdev(keysym) {
  _n = _x11_to_name[keysym]
  if _n == null { return 0 }
  fromString(_n)
}

fn evdevToWindows(evdev) {
  _n = _evdev_to_name[evdev]
  if _n == null { return 0 }
  toWindows(_n)
}

fn windowsToEvdev(vk) {
  _n = _win_to_name[vk]
  if _n == null { return 0 }
  fromString(_n)
}

fn getAliases(name) {
  _e = _name_to_key[name]
  if _e == null { return [] }
  _e.aliases
}

fn keyNames() {
  _out = []
  _i = 0
  _len = #_KEY_TABLE
  while _i < _len {
    _out.push(_KEY_TABLE[_i][0])
    _i = _i + 1
  }
  _out
}

fn keyCount() {
  #_name_to_key
}

// Bulk export for the C++ loader: rows of [name, evdev, x11, win, aliases].
fn allEntries() {
  _out = []
  _i = 0
  _len = #_KEY_TABLE
  while _i < _len {
    _name = _KEY_TABLE[_i][0]
    _e = _name_to_key[_name]
    _out.push({
      name: _name,
      evdev: _e.evdev,
      x11: _e.x11,
      win: _e.win,
      aliases: _e.aliases,
    })
    _i = _i + 1
  }
  _out
}

// Modifier evdev codes, used by the C++ event loop.
_MODIFIER_EVDEV = [29, 97, 42, 54, 56, 100, 125, 126]

fn isModifier(evdev) {
  _i = 0
  _len = #_MODIFIER_EVDEV
  while _i < _len {
    if _MODIFIER_EVDEV[_i] == evdev { return true }
    _i = _i + 1
  }
  false
}

// C++ IsMouseButton: BTN_LEFT .. BTN_TASK inclusive.
fn isMouseButton(evdev) {
  evdev >= 272 && evdev <= 279
}

// C++ IsJoystickButton: BTN_JOYSTICK .. BTN_THUMBR inclusive.
fn isJoystickButton(evdev) {
  evdev >= 288 && evdev <= 318
}
