// mouse.hv — Mouse/pointer control and state querying via X11/Xtst FFI
// Provides: mouse.position, mouse.buttons, mouse.mods, mouse.move,
// mouse.click, mouse.press, mouse.release, mouse.scroll,
// mouse.drag, mouse.grab, mouse.ungrab, mouse.mapping, mouse.screen

use ffi

_mmx_xlib = ffi.open("libX11.so.6")
if _mmx_xlib == 0 { _mmx_xlib = ffi.open("libX11.so") }

_mmx_xtst = ffi.open("libXtst.so.6")
if _mmx_xtst == 0 { _mmx_xtst = ffi.open("libXtst.so") }

_mmx_c = ffi.open("libc.so.6")
if _mmx_c == 0 { _mmx_c = ffi.open("libc.so") }

_mmx_XOpenDisplay = ffi.sym(_mmx_xlib, "XOpenDisplay")
_mmx_XCloseDisplay = ffi.sym(_mmx_xlib, "XCloseDisplay")
_mmx_DefaultRootWindow = ffi.sym(_mmx_xlib, "XDefaultRootWindow")
_mmx_XQueryPointer = ffi.sym(_mmx_xlib, "XQueryPointer")
_mmx_XWarpPointer = ffi.sym(_mmx_xlib, "XWarpPointer")
_mmx_XFlush = ffi.sym(_mmx_xlib, "XFlush")
_mmx_XGrabButton = ffi.sym(_mmx_xlib, "XGrabButton")
_mmx_XUngrabButton = ffi.sym(_mmx_xlib, "XUngrabButton")
_mmx_XGetPointerMapping = ffi.sym(_mmx_xlib, "XGetPointerMapping")
_mmx_XGetWindowAttributes = ffi.sym(_mmx_xlib, "XGetWindowAttributes")

_mmx_XTestFakeMotionEvent = ffi.sym(_mmx_xtst, "XTestFakeMotionEvent")
_mmx_XTestFakeButtonEvent = ffi.sym(_mmx_xtst, "XTestFakeButtonEvent")

// XDisplayWidth/Height are macros — use XGetWindowAttributes on root instead

_mmx_t_p = ["pointer"]
_mmx_t_ppppppppu = ["pointer", "uint64", "pointer", "pointer", "pointer", "pointer", "pointer", "pointer", "pointer"]
_mmx_t_ppuuuiiuii = ["pointer", "uint64", "uint64", "int32", "int32", "uint32", "uint32", "int32", "int32"]
_mmx_t_piiiI = ["pointer", "int32", "int32", "int32", "uint64"]
_mmx_t_puIuI = ["pointer", "uint32", "int32", "uint64"]
_mmx_t_ppuuuiiuuiiuu = ["pointer", "uint32", "uint32", "uint64", "int32", "uint32", "int32", "int32", "uint64", "uint64"]
_mmx_t_puuu = ["pointer", "uint32", "uint32", "uint64"]
_mmx_t_ppi = ["pointer", "pointer", "int32"]

BUTTON1_MASK = 256
BUTTON2_MASK = 512
BUTTON3_MASK = 1024
BUTTON4_MASK = 2048
BUTTON5_MASK = 4096

SHIFT_MASK = 1
LOCK_MASK = 2
CONTROL_MASK = 4
MOD1_MASK = 8
MOD2_MASK = 16
MOD3_MASK = 32
MOD4_MASK = 64
MOD5_MASK = 128

BUTTON1 = 1
BUTTON2 = 2
BUTTON3 = 3
BUTTON4 = 4
BUTTON5 = 5

_mmx_cached_dpy = 0

fn _mmx_openDisplay() {
    if _mmx_cached_dpy == 0 {
        _mmx_cached_dpy = ffi.call(_mmx_XOpenDisplay, "pointer", _mmx_t_p, 0)
        if _mmx_cached_dpy != 0 {
            sys.registerExitCleanup(fn() {
                if _mmx_cached_dpy != 0 {
                    ffi.call(_mmx_XCloseDisplay, "int32", _mmx_t_p, _mmx_cached_dpy)
                    _mmx_cached_dpy = 0
                }
            })
        }
    }
    _mmx_cached_dpy
}

fn _mmx_rootWindow(dpy) {
    ffi.call(_mmx_DefaultRootWindow, "uint64", _mmx_t_p, dpy)
}

fn _mmx_closeDisplay(dpy) {
    if dpy != 0 {
        ffi.call(_mmx_XFlush, "int32", _mmx_t_p, dpy)
    }
}

fn _mmx_flush(dpy) {
    ffi.call(_mmx_XFlush, "int32", _mmx_t_p, dpy)
}

fn _queryPointer(dpy, root) {
    _root_ret = ffi.allocBytes(8)
    _child_ret = ffi.allocBytes(8)
    _rx_ret = ffi.allocBytes(4)
    _ry_ret = ffi.allocBytes(4)
    _wx_ret = ffi.allocBytes(4)
    _wy_ret = ffi.allocBytes(4)
    _mask_ret = ffi.allocBytes(4)
    ffi.call(_mmx_XQueryPointer, "int32", _mmx_t_ppppppppu, dpy, root, _root_ret, _child_ret, _rx_ret, _ry_ret, _wx_ret, _wy_ret, _mask_ret)
    _rx = ffi.get_i32(_rx_ret)
    _ry = ffi.get_i32(_ry_ret)
    _mask = ffi.get_u32(_mask_ret)
    ffi.free(_root_ret)
    ffi.free(_child_ret)
    ffi.free(_rx_ret)
    ffi.free(_ry_ret)
    ffi.free(_wx_ret)
    ffi.free(_wy_ret)
    ffi.free(_mask_ret)
    ({x: _rx, y: _ry, mask: _mask})
}

fn position() {
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return null }
    _root = _mmx_rootWindow(_mmx_dpy)
    _info = _queryPointer(_mmx_dpy, _root)
    _mmx_closeDisplay(_mmx_dpy)
    ({x: _info.x, y: _info.y})
}

fn buttons() {
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return null }
    _root = _mmx_rootWindow(_mmx_dpy)
    _info = _queryPointer(_mmx_dpy, _root)
    _mmx_closeDisplay(_mmx_dpy)
    _m = _info.mask
    {
        left: (_m & BUTTON1_MASK) != 0,
        middle: (_m & BUTTON2_MASK) != 0,
        right: (_m & BUTTON3_MASK) != 0,
        wheelUp: (_m & BUTTON4_MASK) != 0,
        wheelDown: (_m & BUTTON5_MASK) != 0
    }
}

fn mods() {
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return null }
    _root = _mmx_rootWindow(_mmx_dpy)
    _info = _queryPointer(_mmx_dpy, _root)
    _mmx_closeDisplay(_mmx_dpy)
    _m = _info.mask
    {
        shift: (_m & SHIFT_MASK) != 0,
        ctrl: (_m & CONTROL_MASK) != 0,
        alt: (_m & MOD1_MASK) != 0,
        super: (_m & MOD4_MASK) != 0,
        capsLock: (_m & LOCK_MASK) != 0,
        numLock: (_m & MOD2_MASK) != 0
    }
}

fn move(x, y, relative) {
    if relative == null { relative = false }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _root = _mmx_rootWindow(_mmx_dpy)
    if relative {
        ffi.call(_mmx_XWarpPointer, "void", _mmx_t_ppuuuiiuii, _mmx_dpy, 0, 0, 0, 0, 0, 0, x, y)
    } else {
        ffi.call(_mmx_XWarpPointer, "void", _mmx_t_ppuuuiiuii, _mmx_dpy, 0, _root, 0, 0, 0, 0, x, y)
    }
    _mmx_flush(_mmx_dpy)
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn _mmx_fakeButton(dpy, button, is_press) {
    ffi.call(_mmx_XTestFakeButtonEvent, "int32", _mmx_t_puIuI, dpy, button, is_press, 0)
}

fn press(button) {
    if button == null { button = BUTTON1 }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _mmx_fakeButton(_mmx_dpy, button, 1)
    _mmx_flush(_mmx_dpy)
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn release(button) {
    if button == null { button = BUTTON1 }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _mmx_fakeButton(_mmx_dpy, button, 0)
    _mmx_flush(_mmx_dpy)
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn click(button, count) {
    if button == null { button = BUTTON1 }
    if count == null { count = 1 }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _i = 0
    while _i < count {
        _mmx_fakeButton(_mmx_dpy, button, 1)
        _mmx_flush(_mmx_dpy)
        time.sleep(10)
        _mmx_fakeButton(_mmx_dpy, button, 0)
        _mmx_flush(_mmx_dpy)
        if _i < count - 1 {
            time.sleep(50)
        }
        _i += 1
    }
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn scroll(dy, dx) {
    if dy == null { dy = 0 }
    if dx == null { dx = 0 }
_mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _i = 0
    if dy > 0 {
        _i = 0
        while _i < dy {
            _mmx_fakeButton(_mmx_dpy, BUTTON4, 1)
            _mmx_flush(_mmx_dpy)
            _mmx_fakeButton(_mmx_dpy, BUTTON4, 0)
            _mmx_flush(_mmx_dpy)
            time.sleep(10)
            _i += 1
        }
    }
    if dy < 0 {
        _n = -dy
        _i = 0
        while _i < _n {
            _mmx_fakeButton(_mmx_dpy, BUTTON5, 1)
            _mmx_flush(_mmx_dpy)
            _mmx_fakeButton(_mmx_dpy, BUTTON5, 0)
            _mmx_flush(_mmx_dpy)
            time.sleep(10)
            _i += 1
        }
    }
    // horizontal scroll: dx > 0 = right (button 6), dx < 0 = left (button 7)
    // most X11 setups map buttons 6/7 for horizontal scroll
    if dx > 0 {
        _i = 0
        while _i < dx {
            _mmx_fakeButton(_mmx_dpy, 6, 1)
            _mmx_flush(_mmx_dpy)
            _mmx_fakeButton(_mmx_dpy, 6, 0)
            _mmx_flush(_mmx_dpy)
            time.sleep(10)
            _i += 1
        }
    }
    if dx < 0 {
        _n = -dx
        _i = 0
        while _i < _n {
            _mmx_fakeButton(_mmx_dpy, 7, 1)
            _mmx_flush(_mmx_dpy)
            _mmx_fakeButton(_mmx_dpy, 7, 0)
            _mmx_flush(_mmx_dpy)
            time.sleep(10)
            _i += 1
        }
    }
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn drag(fromX, fromY, toX, toY, button) {
    if button == null { button = BUTTON1 }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _root = _mmx_rootWindow(_mmx_dpy)
    // move to start position
    ffi.call(_mmx_XWarpPointer, "void", _mmx_t_ppuuuiiuii, _mmx_dpy, 0, _root, 0, 0, 0, 0, fromX, fromY)
    _mmx_flush(_mmx_dpy)
    time.sleep(30)
    // press button
    _mmx_fakeButton(_mmx_dpy, button, 1)
    _mmx_flush(_mmx_dpy)
    time.sleep(30)
    // move to end position
    ffi.call(_mmx_XWarpPointer, "void", _mmx_t_ppuuuiiuii, _mmx_dpy, 0, _root, 0, 0, 0, 0, toX, toY)
    _mmx_flush(_mmx_dpy)
    time.sleep(30)
    // release button
    _mmx_fakeButton(_mmx_dpy, button, 0)
    _mmx_flush(_mmx_dpy)
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn grab(button, modifiers) {
    if button == null { button = BUTTON1 }
    if modifiers == null { modifiers = 0 }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _root = _mmx_rootWindow(_mmx_dpy)
    // XGrabButton(dpy, button, modifiers, grab_window, owner_events,
    //   event_mask, pointer_mode, keyboard_mode, confine_to, cursor)
    // owner_events=1, event_mask=ButtonPressMask|ButtonReleaseMask=0x18000
    // pointer_mode=GrabModeAsync=1, keyboard_mode=GrabModeAsync=1
    // confine_to=0, cursor=0
    ffi.call(_mmx_XGrabButton, "int32", _mmx_t_ppuuuiiuuiiuu, _mmx_dpy, button, modifiers, _root, 1, 98304, 1, 1, 0, 0)
    _mmx_flush(_mmx_dpy)
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn ungrab(button, modifiers) {
    if button == null { button = BUTTON1 }
    if modifiers == null { modifiers = 0 }
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return false }
    _root = _mmx_rootWindow(_mmx_dpy)
    ffi.call(_mmx_XUngrabButton, "int32", _mmx_t_puuu, _mmx_dpy, button, modifiers, _root)
    _mmx_flush(_mmx_dpy)
    _mmx_closeDisplay(_mmx_dpy)
    true
}

fn mapping() {
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return [] }
    // XGetPointerMapping returns count, max 256 buttons
    _map = ffi.allocBytes(256)
    _n = ffi.call(_mmx_XGetPointerMapping, "int32", _mmx_t_ppi, _mmx_dpy, _map, 256)
    _result = []
    _i = 0
    if _n > 0 {
        _i = 0
        while _i < _n {
            _result.push(ffi.get_u8(ffi.ptr_add(_map, _i)))
            _i += 1
        }
    }
    ffi.free(_map)
    _mmx_closeDisplay(_mmx_dpy)
    _result
}

fn screen() {
    _mmx_dpy = _mmx_openDisplay()
    if _mmx_dpy == 0 { return null }
    _root = _mmx_rootWindow(_mmx_dpy)
    // XDisplayWidth/Height are macros in Xlib.h that dereference the Display struct
    // they access: ((Display*)_mmx_dpy)->screens[DefaultScreen(_mmx_dpy)].width/height
    // instead we use XGetWindowAttributes on the root window
    _attr = ffi.allocBytes(104)
    ffi.call(_mmx_XGetWindowAttributes, "int32", ["pointer", "uint64", "pointer"], _mmx_dpy, _root, _attr)
    _w = ffi.get_i32(ffi.ptr_add(_attr, 40))
    _h = ffi.get_i32(ffi.ptr_add(_attr, 44))
    ffi.free(_attr)
    _mmx_closeDisplay(_mmx_dpy)
    ({width: _w, height: _h})
}
