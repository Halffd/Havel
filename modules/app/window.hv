// window.hv — Full window manipulation via X11/EWMH (OOP)
// Provides: Window class, Desktop class, module-level functions
//
// Usage:
//   use window
//   w = window.active()
//   print(w.title)
//   w.close()
//
//   wins = window.list()
//   for w in wins { print(w.title) }
//
//   w = Window(12345)
//   w.move(100, 200).resize(800, 600)
//
//   d = Desktop()
//   d.switchTo(2)

use x11
use protocols
use display
use ffi
use process
 use time

// ============================================================
// Display helpers (private)
// ============================================================

fn _dpy() { display.open() }

// ============================================================
// Timing instrumentation (gated behind HAVEL_DEBUG_WINDOW_TIMING)
// ============================================================
_win_timing = shell.getenv("HAVEL_DEBUG_WINDOW_TIMING") != null && shell.getenv("HAVEL_DEBUG_WINDOW_TIMING") != ""

fn _tstart() {
    if _win_timing { time.now() } else { 0 }
}

fn _tend(label, t0) {
    if _win_timing && t0 != 0 {
        elapsed = time.now() - t0
        print("[window.timing] $label duration=${elapsed}ms")
    }
}

// ------------------------------------------------------------
// Active-window TTL cache
// ------------------------------------------------------------
// Hotkey handlers and event loops often call window.active() several
// times in the same tick (focus check, snapshot, etc). Each call does
// several X property round-trips; subsequent calls within the TTL
// reuse the cached snapshot instead of re-querying the server.
//
// Tunable via HAVEL_WINDOW_ACTIVE_TTL (milliseconds, default 16).
// Set to 0 to disable the cache (every call hits X).
_active_ttl = 16
try {
    _env_ttl = shell.getenv("HAVEL_WINDOW_ACTIVE_TTL")
    if _env_ttl != null && _env_ttl != "" {
        _parsed = int(_env_ttl)
        if _parsed >= 0 { _active_ttl = _parsed }
    }
} catch {
    // ignore non-integer env; keep default
}
_active_cache_result = null
_active_cache_ts = 0
// activeId() uses the same TTL. Polling loops (goroutines watching the
// active window) call activeId() directly; without a cache every poll
// does an X round-trip that blocks the single VM thread. The id cache
// makes polls nearly free between expiries.
_active_id_cache = 0
_active_id_ts = 0

fn _activeIdCached() {
    if _active_ttl > 0 && _active_id_cache != 0 {
        if (time.now() - _active_id_ts) <= _active_ttl {
            return true
        }
    }
    false
}

fn active() {
    _t0 = _tstart()
    if _active_ttl > 0 && _active_cache_result != null {
        if (time.now() - _active_cache_ts) <= _active_ttl {
            _tend("active.total", _t0)
            return _active_cache_result
        }
    }
    _aid = activeId()
    if _aid == null || _aid == 0 {
        _tend("active.total", _t0)
        return null
    }
    _result = _snapshot(Window(_aid))
    _active_cache_result = _result
    _active_cache_ts = time.now()
    _tend("active.total", _t0)
    _result
}
fn _root() {
	_d = _dpy()
	if _d == 0 { 0 } else { x11.rootWindow(_d) }
}

fn _shell(cmd) {
	_r = shell.exec(cmd + " 2>/dev/null")
	_r.stdout
}

// Resolve /proc fields from a pid already fetched via X, avoiding a
// second _NET_WM_PID round-trip in _snapshot (saves ~10ms/call).
fn _procExe(_pid) {
	if _pid == 0 { return "" }
	fs.readlink("/proc/${_pid}/exe")
}

fn _procCmdline(_pid) {
	if _pid == 0 { return "" }
	_raw = fs.read("/proc/${_pid}/cmdline")
	if _raw == "" { "" } else { _raw.replace("\0", " ").trim() }
}

// ============================================================
// Window class — wraps a window ID with all per-window operations
// ============================================================

class Window {
	id: int

	fn @(id) {
		@id = id
	}

	fn valid() {
		if @id == 0 { return false }
		_d = _dpy()
		if _d == 0 { return false }
		_attrs = x11.getWindowAttributes(_d, @id)
		_attrs != null
	}

	// ---- Properties (getters) ----

	fn title() {
		_d = _dpy()
		if _d == 0 { return "" }
		_name = protocols.getStringProp(_d, @id, protocols.netWmName())
		if _name != "" { return _name }
		x11.getWMName(_d, @id)
	}

	fn className() {
		_d = _dpy()
		if _d == 0 { return "" }
		_hint = x11.getClassHint(_d, @id)
		_hint.resClass
	}

	fn class() {
		@className()
	}

	fn pid() {
		_d = _dpy()
		if _d == 0 { return 0 }
		protocols.getCardinalProp(_d, @id, protocols.netWmPid())
	}

	fn exe() {
		_p = @pid()
		if _p == 0 { return "" }
		_path = fs.readlink("/proc/${_p}/exe")
		if _path == "" { "" } else { _path }
	}

	fn cmdline() {
		_p = @pid()
		if _p == 0 { return "" }
		_raw = fs.read("/proc/${_p}/cmdline")
		if _raw == "" { "" } else { _raw.replace("\0", " ").trim() }
	}

	fn type() {
		_d = _dpy()
		if _d == 0 { return "normal" }
		_atoms = protocols.getAtomProp(_d, @id, protocols.netWmWindowType())
		if #_atoms == 0 { return "normal" }
		_first = _atoms[0]
		if _first == protocols.netWmWindowTypeDesktop() { "desktop" }
		else if _first == protocols.netWmWindowTypeDock() { "dock" }
		else if _first == protocols.netWmWindowTypeToolbar() { "toolbar" }
		else if _first == protocols.netWmWindowTypeMenu() { "menu" }
		else if _first == protocols.netWmWindowTypeUtility() { "utility" }
		else if _first == protocols.netWmWindowTypeSplash() { "splash" }
		else if _first == protocols.netWmWindowTypeDialog() { "dialog" }
		else if _first == protocols.netWmWindowTypeNormal() { "normal" }
		else { x11.getAtomName(_d, _first) }
	}

	fn role() {
		_d = _dpy()
		if _d == 0 { return "" }
		_atom = x11.internAtom(_d, "WM_WINDOW_ROLE", 1)
		if _atom == 0 { "" } else { protocols.getStringProp(_d, @id, _atom) }
	}

	fn transient() {
		_d = _dpy()
		if _d == 0 { return 0 }
		_r = x11.getTransientForHint(_d, @id)
		if _r.rcode == 0 { _r.transientFor } else { 0 }
	}

	fn desktop() {
		_d = _dpy()
		if _d == 0 { return -1 }
		protocols.getCardinalProp(_d, @id, protocols.netWmDesktop())
	}

	// ---- Geometry ----

	fn geometry(id = 0) {
		_id = id != 0 ? id : @id
		_d = _dpy()
		print("[dbg.geometry] _id=${_id} _d=${_d}")
		if _d == 0 || _id == 0 { return null }
		_r = x11.getGeometry(_d, _id)
		print("[dbg.geometry] rcode=${_r.rcode}")
		if _r.rcode == 0 { null }
		else { {x: _r.x, y: _r.y, width: _r.width, height: _r.height, border: _r.border, depth: _r.depth} }
	}

	// Get current position
	// relative = false: absolute screen position (root coordinates)
	// relative = true: position relative to parent window
	// windowId: override window id (defaults to this window's own id)
	fn pos(relative = false, windowId = 0) {
		_id = windowId != 0 ? windowId : @id
		if (_id == 0) { return null }

		_d = _dpy()
		if (_d == 0) { return null }

		// Try screen position first (root translation) for absolute coords
		if (!relative) {
			_root = _root()
			if (_root != 0) {
				_r = x11.translateCoordinates(_d, _id, _root, 0, 0)
				// rcode: 1 = success, 0 = failure (xcb status)
				if (_r.rcode != 0) { return {x: _r.x, y: _r.y} }
			}
		}

		// For relative, or as fallback when root translation fails
		_g = @geometry(_id)
		if (_g == null) { return null }
		{x: _g.x, y: _g.y}
	}

	fn size() {
		// Client-area geometry plus frame extents; width/height include frame.
		_g = @geometry()
		if _g == null { return null }
		_ext = @frameExtents()
		{
			width: _g.width + _ext.left + _ext.right,
			height: _g.height + _ext.top + _ext.bottom,
			clientWidth: _g.width,
			clientHeight: _g.height,
			frame: _ext
		}
	}

	fn setSize(w, h) {
		// Resize via _NET_MOVERESIZE_WINDOW (EWMH) so the WM handles
		// decorations/constraints; falls back to XResizeWindow when no root.
		@resize(w, h)
		@
	}

	fn screenPos() {
		_d = _dpy()
		if _d == 0 { return null }
		_root = _root()
		if _root == 0 { return null }
		_r = x11.translateCoordinates(_d, @id, _root, 0, 0)
		if _r.rcode == 0 { null }
		else { {x: _r.x, y: _r.y} }
	}

	fn frameExtents() {
		_d = _dpy()
		if _d == 0 { return {left: 0, right: 0, top: 0, bottom: 0} }
		_atom = x11.internAtom(_d, "_NET_FRAME_EXTENTS", 1)
		if _atom == 0 { return {left: 0, right: 0, top: 0, bottom: 0} }
		_r = x11.getWindowProperty(_d, @id, _atom, 0, 4, 0, x11.XA_CARDINAL)
		if _r.ret == 0 && _r.nitems >= 4 && _r.prop != 0 {
			_left = ffi.get_i32(_r.prop)
			_right = ffi.get_i32(ffi.ptr_add(_r.prop, 4))
			_top = ffi.get_i32(ffi.ptr_add(_r.prop, 8))
			_bottom = ffi.get_i32(ffi.ptr_add(_r.prop, 12))
			x11.free(_r.prop)
			return {left: _left, right: _right, top: _top, bottom: _bottom}
		}
		{left: 0, right: 0, top: 0, bottom: 0}
	}

	// ---- State queries ----

	fn state() {
		_d = _dpy()
		if _d == 0 { return [] }
		protocols.getAtomProp(_d, @id, protocols.netWmState())
	}

	fn states() {
		_atoms = @state()
		_names = []
		for _a in _atoms {
			_d = _dpy()
			if _d != 0 { _names.push(x11.getAtomName(_d, _a)) }
		}
		_names
	}

	fn isMinimized() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.hasState(_d, @id, protocols.netWmStateHidden())
	}

	fn isMaximized() {
		// Returns {horizontal, vertical, any} per EWMH _NET_WM_STATE.
		_d = _dpy()
		if _d == 0 { return {horizontal: false, vertical: false, any: false} }
		_h = protocols.hasState(_d, @id, protocols.netWmStateMaximizedHorz())
		_v = protocols.hasState(_d, @id, protocols.netWmStateMaximizedVert())
		{horizontal: _h, vertical: _v, any: _h || _v}
	}

	fn isFullscreen() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.hasState(_d, @id, protocols.netWmStateFullscreen())
	}

	fn isHidden() {
		_d = _dpy()
		if _d == 0 { return false }
		_attrs = x11.getWindowAttributes(_d, @id)
		if _attrs == null { false } else { _attrs.mapState == x11.IsUnmapped }
	}

	fn isAbove() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.hasState(_d, @id, protocols.netWmStateAbove())
	}

	fn isBelow() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.hasState(_d, @id, protocols.netWmStateBelow())
	}

	fn decorated() {
		_d = _dpy()
		if _d == 0 { return true }
		_atom = x11.internAtom(_d, "_GTK_FRAME_EXTENTS", 1)
		if _atom == 0 { return true }
		_r = x11.getWindowProperty(_d, @id, _atom, 0, 4, 0, x11.XA_CARDINAL)
		_r.ret == 0 && _r.nitems > 0
	}

	fn focusable() { true }

	fn exists() {
		@valid()
	}

	// ---- Full info dump ----

	fn info() {
		if @id == 0 { return null }
		_g = @geometry()
		if _g == null { return null }
		({id: @id, title: @title(), windowClass: @className(), pid: @pid(),
			exe: @exe(), cmdline: @cmdline(),
			x: _g.x, y: _g.y, width: _g.width, height: _g.height,
			desktop: @desktop(), type: @type(), state: @states(),
			isMinimized: @isMinimized(), isMaximized: @isMaximized(),
			isFullscreen: @isFullscreen()})
	}

	// ---- Focus / activation ----

	fn activate() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendActiveMessage(_d, @id, protocols.SOURCE_APPLICATION)
		true
	}

	fn raise() {
		_d = _dpy()
		if _d == 0 { return false }
		_changes = x11.makeWindowChanges(0, 0, 0, 0, 0, 0, x11.Above)
		x11.configureWindow(_d, @id, x11.CWStackMode, _changes)
		x11.flush(_d)
		x11.freeClientMessage(_changes)
		true
	}

	fn lower() {
		_d = _dpy()
		if _d == 0 { return false }
		_changes = x11.makeWindowChanges(0, 0, 0, 0, 0, 0, x11.Below)
		x11.configureWindow(_d, @id, x11.CWStackMode, _changes)
		x11.flush(_d)
		x11.freeClientMessage(_changes)
		true
	}

	// ---- Visibility ----

	fn close() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendCloseMessage(_d, @id)
		true
	}

	fn kill() {
		_d = _dpy()
		if _d == 0 { return false }
		x11.killClient(_d, @id)
		x11.flush(_d)
		true
	}

	fn minimize() {
		_d = _dpy()
		if _d == 0 { return false }
		_screen = x11.defaultScreen(_d)
		x11.iconifyWindow(_d, @id, _screen)
		x11.flush(_d)
		true
	}

	fn maximize() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendStateMessage(_d, @id, protocols.STATE_ADD,
			protocols.netWmStateMaximizedVert(), protocols.netWmStateMaximizedHorz())
		true
	}

	fn restore() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendStateMessage(_d, @id, protocols.STATE_REMOVE,
			protocols.netWmStateMaximizedVert(), protocols.netWmStateMaximizedHorz())
		true
	}

	fn hide() {
		_d = _dpy()
		if _d == 0 { return false }
		x11.unmapWindow(_d, @id)
		x11.flush(_d)
		true
	}

	fn show() {
		_d = _dpy()
		if _d == 0 { return false }
		x11.mapWindow(_d, @id)
		x11.flush(_d)
		true
	}

	// ---- Movement / resizing ----

	// Move window
	// speed: optional animation speed hint (ignored by X11 but kept for API compat)
	// winId: move this window (defaults to this window)
	// relative = false: move to absolute (x, y)
	// relative = true: move by delta (dx, dy) from current position
	fn move(x, y, speed = 0.0, winId = 0, relative = false) {
		_target = winId != 0 ? winId : @id
		_d = _dpy()
		if (_d == 0 || _target == 0) { return @ }

		if (relative) {
			// Get current position and add to deltas
			_cur = @pos(false, _target)
			if (_cur == null) { return @ }
			x += _cur.x
			y += _cur.y
		}
		if (_root() != 0) {
			protocols.sendMoveResizeMessage(_d, _target, x, y, 0, 0, true, true, false, false)
		} else {
			x11.moveWindow(_d, _target, x, y)
			x11.flush(_d)
		}
		@
	}

	// Resize window
	// winId: resize this window (defaults to this window)
	// relative = false: resize to absolute (w, h)
	// relative = true: resize by delta (dw, dh) from current size
	fn resize(w, h, winId = 0, relative = false) {
		_target = winId != 0 ? winId : @id
		_d = _dpy()
		if (_d == 0 || _target == 0) { return @ }

		if (relative) {
			_g = @geometry(_target)
			if (_g == null) { return @ }
			w += _g.width
			h += _g.height
		}
		if (_root() != 0) {
			protocols.sendMoveResizeMessage(_d, _target, 0, 0, w, h, false, false, true, true)
		} else {
			x11.resizeWindow(_d, _target, w, h)
			x11.flush(_d)
		}
		@
	}

	fn moveResize(x, y, w, h) {
		_d = _dpy()
		if _d == 0 { return @ }
		_r = _root()
		if _r != 0 {
			protocols.sendMoveResizeMessage(_d, @id, x, y, w, h)
		}
		x11.moveResizeWindow(_d, @id, x, y, w, h)
		x11.flush(_d)
		@
	}

	fn center() {
		_d = _dpy()
		if _d == 0 { return @ }
		_g = @geometry()
		if _g == null { return @ }
		_mon = display.primaryMonitor()
		_cx = _mon.x + ((_mon.width - _g.width) / 2)
		_cy = _mon.y + ((_mon.height - _g.height) / 2)
		@moveResize(_cx, _cy, _g.width, _g.height)
	}

	fn moveToCorner(corner) {
		_d = _dpy()
		if _d == 0 { return @ }
		_g = @geometry()
		if _g == null { return @ }
		_mon = display.primaryMonitor()
		_x = _mon.x; _y = _mon.y
		if corner == "tr" { _x = _mon.x + _mon.width - _g.width }
		else if corner == "bl" { _y = _mon.y + _mon.height - _g.height }
		else if corner == "br" {
			_x = _mon.x + _mon.width - _g.width
			_y = _mon.y + _mon.height - _g.height
		}
		@moveResize(_x, _y, _g.width, _g.height)
	}

	fn moveToMonitor(monitorIndex) {
		_mons = display.monitors()
		if monitorIndex < 0 || monitorIndex >= #_mons { return @ }
		_target = _mons[monitorIndex]
		_d = _dpy()
		if _d == 0 { return @ }
		_g = @geometry()
		if _g == null { return @ }
		_cx = _target.x + ((_target.width - _g.width) / 2)
		_cy = _target.y + ((_target.height - _g.height) / 2)
		@moveResize(_cx, _cy, _g.width, _g.height)
	}

	// EWMH-style monitor movement aliases per spec
	fn moveMonitor(i = 0, follow = true) {
		@moveToMonitor(i)
		if follow { @activate() }
		@
	}
	fn moveMonitorNext(follow = true) {
		_mons = display.monitors()
		if #_mons < 2 { return @ }
		_cur = @getCurrentMonitor()
		_next = (_cur + 1) % #_mons
		@moveMonitor(_next, follow)
	}
	fn moveMonitorPrev(follow = true) {
		_mons = display.monitors()
		if #_mons < 2 { return @ }
		_cur = @getCurrentMonitor()
		_prev = (_cur - 1 + #_mons) % #_mons
		@moveMonitor(_prev, follow)
	}
	fn getCurrentMonitor() {
		_pos = @pos()
		if _pos == null { return 0 }
		_mons = display.monitors()
		_i = 0
		while _i < #_mons {
			_m = _mons[_i]
			if _pos.x >= _m.x && _pos.x < _m.x + _m.width && _pos.y >= _m.y && _pos.y < _m.y + _m.height {
				return _i
			}
			_i = _i + 1
		}
		0
	}

	fn snap(position) {
		_d = _dpy()
		if _d == 0 { return @ }
		_g = @geometry()
		if _g == null { return @ }
		_mon = display.primaryMonitor()
		_mx = _mon.x; _my = _mon.y
		_mw = _mon.width; _mh = _mon.height
		_hw = _mw / 2; _hh = _mh / 2
		_x = _mx; _y = _my; _w = _mw; _h = _mh
		if position == 1 { _w = _hw }
		else if position == 2 { _x = _mx + _hw; _w = _hw }
		else if position == 3 { _h = _hh }
		else if position == 4 { _y = _my + _hh; _h = _hh }
		else if position == 5 { _w = _hw; _h = _hh }
		else if position == 6 { _x = _mx + _hw; _w = _hw; _h = _hh }
		else if position == 7 { _w = _hw; _y = _my + _hh; _h = _hh }
		else if position == 8 { _x = _mx + _hw; _w = _hw; _y = _my + _hh; _h = _hh }
		@moveResize(_x, _y, _w, _h)
	}

	fn moveToDesktop(desktopNum) {
		_d = _dpy()
		if _d == 0 { return false }
		_r = _root()
		if _r == 0 { return false }
		_ev = x11.makeClientMessage(@id, protocols.netWmDesktop(), 32, desktopNum, x11.CurrentTime, 0, 0, 0)
		_mask = ((x11.SubstructureRedirectMask | x11.SubstructureNotifyMask))
		x11.sendEvent(_d, _r, x11.XFalse, _mask, _ev)
		x11.flush(_d)
		x11.freeClientMessage(_ev)
		true
	}

	// ---- Fullscreen / layer ----

	fn toggleFullscreen() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendStateMessage(_d, @id, protocols.STATE_TOGGLE,
			protocols.netWmStateFullscreen(), 0)
		true
	}

	fn fullscreen(enable = true) {
		_d = _dpy()
		if _d == 0 { return false }
		_cur = @isFullscreen()
		if enable && !_cur {
			protocols.sendStateMessage(_d, @id, protocols.STATE_ADD,
				protocols.netWmStateFullscreen(), 0)
		}
		if !enable && _cur {
			protocols.sendStateMessage(_d, @id, protocols.STATE_REMOVE,
				protocols.netWmStateFullscreen(), 0)
		}
		true
	}

	fn alwaysOnTop() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendStateMessage(_d, @id, protocols.STATE_ADD,
			protocols.netWmStateAbove(), 0)
		true
	}

	fn alwaysOnBottom() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendStateMessage(_d, @id, protocols.STATE_ADD,
			protocols.netWmStateBelow(), 0)
		true
	}

	fn floating() {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendStateMessage(_d, @id, protocols.STATE_REMOVE,
			protocols.netWmStateAbove(), 0)
		protocols.sendStateMessage(_d, @id, protocols.STATE_REMOVE,
			protocols.netWmStateBelow(), 0)
		true
	}

	fn above() {
		_d = _dpy()
		if _d == 0 { return false }
		if !protocols.hasState(_d, @id, protocols.netWmStateAbove()) {
			protocols.sendStateMessage(_d, @id, protocols.STATE_ADD,
				protocols.netWmStateAbove(), 0)
		}
		true
	}

	fn below() {
		_d = _dpy()
		if _d == 0 { return false }
		if !protocols.hasState(_d, @id, protocols.netWmStateBelow()) {
			protocols.sendStateMessage(_d, @id, protocols.STATE_ADD,
				protocols.netWmStateBelow(), 0)
		}
		true
	}

	// ---- Opacity ----

	fn opacity(value) {
		_d = _dpy()
		if _d == 0 { return false }
		_cardinal = int(value * 4294967295.0)
		_data = ffi.allocBytes(4)
		ffi.set_u32(_data, _cardinal)
		x11.changeProp(_d, @id, protocols.netWmWindowOpacity(),
			x11.XA_CARDINAL, 32, x11.PropModeReplace, _data, 1)
		x11.flush(_d)
		ffi.free(_data)
		true
	}

	// ---- Decoration / focus control ----

	fn setFocusable(focusable) {
		_d = _dpy()
		if _d == 0 { return false }
		true
	}

	fn setDecorated(decoratedVal) {
		_d = _dpy()
		if _d == 0 { return false }
		_atom = x11.internAtom(_d, "_MOTIF_WM_HINTS", 1)
		if _atom == 0 { return false }
		_data = ffi.allocBytes(20)
		ffi.set_i32(_data, 2)
		ffi.set_i32(ffi.ptr_add(_data, 4), 0)
		ffi.set_i32(ffi.ptr_add(_data, 8), decoratedVal ? 1 : 0)
		ffi.set_i32(ffi.ptr_add(_data, 12), 0)
		ffi.set_i32(ffi.ptr_add(_data, 16), 0)
		x11.changeProp(_d, @id, _atom, _atom, 32, x11.PropModeReplace, _data, 5)
		x11.flush(_d)
		ffi.free(_data)
		true
	}

	// Borderless via _MOTIF_WM_HINTS (set decorations = 0).
	fn borderless(enable = true) {
		@setDecorated(!enable)
		@
	}
	fn isBorderless() {
		_d = _dpy()
		if _d == 0 { return false }
		_atom = x11.internAtom(_d, "_MOTIF_WM_HINTS", 1)
		if _atom == 0 { return false }
		_r = x11.getWindowProperty(_d, @id, _atom, 0, 5, 0, _atom)
		if _r.ret == 0 && _r.nitems >= 3 && _r.prop != 0 {
			_decorations = ffi.get_i32(ffi.ptr_add(_r.prop, 8))
			x11.free(_r.prop)
			return _decorations == 0
		}
		false
	}
	fn toggleBorderless() {
		@borderless(!@isBorderless())
		@
	}

	// ---- Raw property / event access ----

	fn setProperty(prop, type, format, data) {
		_d = _dpy()
		if _d == 0 { return false }
		_propAtom = x11.internAtom(_d, prop, 0)
		_typeAtom = x11.internAtom(_d, type, 0)
		if _propAtom == 0 || _typeAtom == 0 { return false }
		_cs = ffi.cstring(data)
		x11.changeProp(_d, @id, _propAtom, _typeAtom, format, x11.PropModeReplace, _cs, 1)
		x11.flush(_d)
		ffi.free(_cs)
		true
	}

	fn getProperty(prop, type) {
		_d = _dpy()
		if _d == 0 { return null }
		_propAtom = x11.internAtom(_d, prop, 1)
		_typeAtom = 0
		if type != "" { _typeAtom = x11.internAtom(_d, type, 1) }
		if _propAtom == 0 { return null }
		_r = x11.getWindowProperty(_d, @id, _propAtom, 0, 4096, 0, _typeAtom)
		if _r.ret == 0 && _r.nitems > 0 && _r.prop != 0 {
			_val = ffi.string(_r.prop)
			x11.free(_r.prop)
			return _val
		}
		null
	}

	fn sendEvent(eventType, d0, d1, d2, d3, d4) {
		_d = _dpy()
		if _d == 0 { return false }
		_atom = x11.internAtom(_d, eventType, 1)
		if _atom == 0 { return false }
		_ev = x11.makeClientMessage(@id, _atom, 32, d0, d1, d2, d3, d4)
		_mask = ((x11.SubstructureRedirectMask | x11.SubstructureNotifyMask))
		_r = _root()
		if _r != 0 {
			x11.sendEvent(_d, _r, x11.XFalse, _mask, _ev)
		}
		x11.flush(_d)
		x11.freeClientMessage(_ev)
		true
	}

	fn focus() { @activate() }
	fn min() { @minimize() }
	fn unmin() {
		// Restore from minimized: map + activate
		_d = _dpy()
		if _d == 0 { return @ }
		x11.mapWindow(_d, @id)
		x11.flush(_d)
		@activate()
		@
	}
	fn max(horizontal = true, vertical = true) {
		_d = _dpy()
		if _d == 0 { return @ }
		if horizontal { protocols.sendStateMessage(_d, @id, protocols.STATE_ADD, protocols.netWmStateMaximizedHorz(), 0) }
		if vertical { protocols.sendStateMessage(_d, @id, protocols.STATE_ADD, protocols.netWmStateMaximizedVert(), 0) }
		@
	}
	fn unmax(horizontal = true, vertical = true) {
		_d = _dpy()
		if _d == 0 { return @ }
		if horizontal { protocols.sendStateMessage(_d, @id, protocols.STATE_REMOVE, protocols.netWmStateMaximizedHorz(), 0) }
		if vertical { protocols.sendStateMessage(_d, @id, protocols.STATE_REMOVE, protocols.netWmStateMaximizedVert(), 0) }
		@
	}
	fn toggleMax(horizontal = true, vertical = true) {
		_d = _dpy()
		if _d == 0 { return @ }
		if horizontal { protocols.sendStateMessage(_d, @id, protocols.STATE_TOGGLE, protocols.netWmStateMaximizedHorz(), 0) }
		if vertical   { protocols.sendStateMessage(_d, @id, protocols.STATE_TOGGLE, protocols.netWmStateMaximizedVert(), 0) }
		@
	}

	// ---- EWMH state toggles (chainable) ----

	fn _ewmhToggle(atomFn, enableFlag) {
		_d = _dpy()
		if _d == 0 { return @ }
		_action = enableFlag ? protocols.STATE_ADD : protocols.STATE_REMOVE
		protocols.sendStateMessage(_d, @id, _action, atomFn(), 0)
		@
	}
	fn _ewmhState(atomFn) {
		_d = _dpy()
		if _d == 0 { return false }
		_x = protocols.hasState(_d, @id, atomFn())
		_x
	}

	fn sticky(enable = true) { @_ewmhToggle(protocols.netWmStateSticky, enable) }
	fn isSticky() { @_ewmhState(protocols.netWmStateSticky) }
	fn shade(enable = true) { @_ewmhToggle(protocols.netWmStateShaded, enable) }
	fn isShaded() { @_ewmhState(protocols.netWmStateShaded) }
	fn skipTaskbar(enable = true) { @_ewmhToggle(protocols.netWmStateSkipTaskbar, enable) }
	fn isSkipTaskbar() { @_ewmhState(protocols.netWmStateSkipTaskbar) }
	fn skipPager(enable = true) { @_ewmhToggle(protocols.netWmStateSkipPager, enable) }
	fn isSkipPager() { @_ewmhState(protocols.netWmStateSkipPager) }
	fn alwaysOnTopState(enable = true) { @_ewmhToggle(protocols.netWmStateAbove, enable) }
	fn isAlwaysOnTopState() { @_ewmhState(protocols.netWmStateAbove) }

	// SIGTERM process termination
	fn terminate() {
		_pid = @pid()
		if _pid == 0 { return @ }
		process.sendSignal(_pid, 15)
		@
	}

	fn getOpacity() {
		_d = _dpy()
		if _d == 0 { return 1.0 }
		_r = x11.getWindowProperty(_d, @id, protocols.netWmWindowOpacity(), 0, 1, 0, x11.XA_CARDINAL)
		if _r.rcode == 0 && _r.nitems >= 1 && _r.prop != 0 {
			_v = ffi.get_u32(_r.prop)
			x11.free(_r.prop)
			return _v / 4294967295.0
		}
		1.0
	}
	fn setAlwaysOnTop(b) {
		if b == null || b { @alwaysOnTop() }
		else { @floating() }
	}
	fn name() { @title() }
}

// ============================================================
// Desktop class — workspace / virtual desktop operations
// ============================================================

class Desktop {
	fn workspaces() {
		_d = _dpy()
		if _d == 0 { return [] }
		_r = _root()
		if _r == 0 { return [] }
		_num = protocols.getCardinalProp(_d, _r, protocols.netNumberOfDesktops())
		_names = []
		_i = 0
		while _i < _num {
			_names.push(str(_i))
			_i = _i + 1
		}
		_namesAtom = protocols.netDesktopNames()
		_result = x11.getWindowProperty(_d, _r, _namesAtom, 0, 4096, 0, 0)
		if _result.rcode == 0 && _result.nitems > 0 && _result.prop != 0 {
			_raw = ffi.string(_result.prop)
			x11.free(_result.prop)
			_decoded = _raw.split("\0")
			_clean = []
			for _n in _decoded {
				if _n != "" { _clean.push(_n) }
			}
			if #_clean > 0 { _names = _clean }
		}
		_names
	}

	fn current() {
		_d = _dpy()
		if _d == 0 { return -1 }
		_r = _root()
		if _r == 0 { return -1 }
		protocols.getCardinalProp(_d, _r, protocols.netCurrentDesktop())
	}

	fn switchTo(desktopNum) {
		_d = _dpy()
		if _d == 0 { return false }
		protocols.sendDesktopMessage(_d, desktopNum)
		true
	}
}

// ============================================================
// Private: enumerate all window IDs
// ============================================================

fn _allWindows() {
	_d = _dpy()
	if _d == 0 { return [] }
	_r = _root()
	if _r == 0 { return [] }
	_result = x11.getWindowProperty(_d, _r, protocols.netClientList(), 0, 4096, 0, x11.XA_WINDOW)
	if _result.ret == 0 && _result.nitems > 0 && _result.prop != 0 {
		_wins = []
		_i = 0
		while _i < _result.nitems {
			_w = ffi.get_u64(ffi.ptr_add(_result.prop, _i * 8))
			_wins.push(_w)
			_i = _i + 1
		}
		x11.free(_result.prop)
		return _wins
	}
	_tree = x11.queryTree(_d, _r)
	if _tree.ret == 0 || _tree.children == 0 || _tree.nchildren == 0 { return [] }
	_wins = []
	_i = 0
	while _i < _tree.nchildren {
		_w = ffi.get_u64(ffi.ptr_add(_tree.children, _i * 8))
		_wins.push(_w)
		_i = _i + 1
	}
	if _tree.children != 0 { x11.free(_tree.children) }
	_wins
}

// ============================================================
// Snapshot — frozen property-style view of a Window
// ============================================================

fn _snapshot(_w) {
	_t0 = _tstart()
	_t_title = _tstart()
	_title = _w.title()
	_tend("snapshot.title", _t_title)
	_t_class = _tstart()
	_class = _w.className()
	_tend("snapshot.class", _t_class)
	_t_pid = _tstart()
	_pid = _w.pid()
	_tend("snapshot.pid", _t_pid)
	_t_exe = _tstart()
	_exe = _procExe(_pid)
	_tend("snapshot.exe", _t_exe)
	_t_cmd = _tstart()
	_cmd = _procCmdline(_pid)
	_tend("snapshot.cmdline", _t_cmd)
	_tend("snapshot.total", _t0)
	{
		id: _w.id,
		title: _title,
		class: _class,
		pid: _pid,
		exe: _exe,
		cmdline: _cmd,
		close: fn() { _w.close() },
		hide: fn() { _w.hide() },
		show: fn() { _w.show() },
		focus: fn() { _w.activate() },
		min: fn() { _w.minimize() },
		max: fn(_h = true, _v = true) { _w.max(_h, _v) },
		unmax: fn(_h = true, _v = true) { _w.unmax(_h, _v) },
		toggleMax: fn(_h = true, _v = true) { _w.toggleMax(_h, _v) },
		unmin: fn() { _w.unmin() },
		restore: fn() { _w.restore() },
		snap: fn(pos) { _w.snap(pos) },
		center: fn() { _w.center() },
		fullscreen: fn(_on = true) { _w.fullscreen(_on) },
		toggleFullscreen: fn() { _w.toggleFullscreen() },
		borderless: fn(_on = true) { _w.borderless(_on) },
		isBorderless: fn() { _w.isBorderless() },
		toggleBorderless: fn() { _w.toggleBorderless() },
		setDecorated: fn(_on) { _w.setDecorated(_on) },
		size: fn() { _w.size() },
		setSize: fn(_w2, _h2) { _w.setSize(_w2, _h2) },
		isMaximized: fn() { _w.isMaximized() },
		isMinimized: fn() { _w.isMinimized() },
		isFullscreen: fn() { _w.isFullscreen() },
		moveMonitor: fn(_i = 0, _follow = true) { _w.moveMonitor(_i, _follow) },
		moveMonitorNext: fn(_follow = true) { _w.moveMonitorNext(_follow) },
		moveMonitorPrev: fn(_follow = true) { _w.moveMonitorPrev(_follow) },
		getCurrentMonitor: fn() { _w.getCurrentMonitor() },
		move: fn(x, y) { _w.move(x, y) },
		moveResize: fn(x, y, w, h) { _w.moveResize(x, y, w, h) },
		resize: fn(w, h) { _w.resize(w, h) },
		setAlwaysOnTop: fn(b) { _w.setAlwaysOnTop(b) },
		alwaysOnTop: fn(_enable = true) { _w.alwaysOnTopState(_enable) },
		isAlwaysOnTop: fn() { _w.isAlwaysOnTopState() },
		sticky: fn(_enable = true) { _w.sticky(_enable) },
		isSticky: fn() { _w.isSticky() },
		shade: fn(_enable = true) { _w.shade(_enable) },
		isShaded: fn() { _w.isShaded() },
		skipTaskbar: fn(_enable = true) { _w.skipTaskbar(_enable) },
		isSkipTaskbar: fn() { _w.isSkipTaskbar() },
		skipPager: fn(_enable = true) { _w.skipPager(_enable) },
		isSkipPager: fn() { _w.isSkipPager() },
		setOpacity: fn(_a) { _w.opacity(_a) },
		getOpacity: fn() { _w.getOpacity() },
		terminate: fn() { _w.terminate() },
		pos: fn(_rel = false) { _w.pos(_rel) },
	}
}

// ============================================================
// Module-level functions — return Window snapshots
// ============================================================

fn activeId() {
	_t0 = _tstart()
	if _activeIdCached() {
		_tend("activeId.total", _t0)
		return _active_id_cache
	}
	_d = _dpy()
	if _d == 0 { return 0 }
	_rw = _root()
	if _rw != 0 {
		_t_prop = _tstart()
		_aid = protocols.getWindowProp(_d, _rw, protocols.netActiveWindow())
		_tend("activeId.getWindowProp", _t_prop)
		if _aid != 0 && _aid != _rw {
			_active_id_cache = _aid
			_active_id_ts = time.now()
			_tend("activeId.total", _t0)
			return _aid
		}
	}
	_t_focus = _tstart()
	_info = x11.getInputFocus(_d)
	_tend("activeId.getInputFocus", _t_focus)
	if _info.rcode != 0 && _info.focus != 0 && _info.focus != 1 && _info.focus != _rw {
		_active_id_cache = _info.focus
		_active_id_ts = time.now()
		_tend("activeId.total", _t0)
		return _info.focus
	}
	// Don't cache 0 - it means "no active window" which is a valid transient state
	// Return 0 but don't cache it so we re-check on next call
	0
}

fn list() {
	_ids = _allWindows()
	_wins = []
	for _id in _ids {
		_wins.push(_snapshot(Window(_id)))
	}
	_wins
}

fn find(predicate) {
	for _id in _allWindows() {
		_w = Window(_id)
		if predicate(_w.info()) { return _w }
	}
	null
}

fn findByTitle(name) {
	for _id in _allWindows() {
		_w = Window(_id)
		if _w.title() == name { return _w }
	}
	null
}

fn findByClass(name) {
	for _id in _allWindows() {
		_w = Window(_id)
		if _w.className() == name { return _w }
	}
	null
}

fn findByPid(pidVal) {
	for _id in _allWindows() {
		_w = Window(_id)
		if _w.pid() == pidVal { return _w }
	}
	null
}

// ============================================================
// Spec-based window finding — supports "title chrome", "class steam",
// "cmd konsole", "pid 1234", "id 10000", etc.
// ============================================================

fn _parseSpec(spec) {
	if spec == "" { return null }
	_parts = spec.split(" ")
	if #_parts < 2 { return {type: "title", value: spec, substring: true} }
	_prefix = _parts[0].toLowerCase()
	_value = _parts.slice(1).join(" ")
	if _prefix == "title" { return {type: "title", value: _value, substring: true} }
	else if _prefix == "class" { return {type: "class", value: _value, substring: true} }
	else if _prefix == "cmd" { return {type: "cmd", value: _value, substring: true} }
	else if _prefix == "exe" { return {type: "exe", value: _value, substring: true} }
	else if _prefix == "pid" { return {type: "pid", value: int(_value)} }
	else if _prefix == "id" { return {type: "id", value: int(_value)} }
	else { return {type: "title", value: spec, substring: true} }
}

fn _matchWindow(_w, _spec) {
	if _spec.type == "title" {
		_title = _w.title().toLowerCase()
		if _spec.substring { return _title.contains(_spec.value.toLowerCase()) }
		return _title == _spec.value.toLowerCase()
	}
	else if _spec.type == "class" {
		_class = _w.className().toLowerCase()
		if _spec.substring { return _class.contains(_spec.value.toLowerCase()) }
		return _class == _spec.value.toLowerCase()
	}
	else if _spec.type == "cmd" {
		_cmd = _w.cmdline().toLowerCase()
		if _spec.substring { return _cmd.contains(_spec.value.toLowerCase()) }
		return _cmd == _spec.value.toLowerCase()
	}
	else if _spec.type == "exe" {
		_exe = _w.exe().toLowerCase()
		if _spec.substring { return _exe.contains(_spec.value.toLowerCase()) }
		return _exe == _spec.value.toLowerCase()
	}
	else if _spec.type == "pid" {
		return _w.pid() == _spec.value
	}
	else if _spec.type == "id" {
		return _w.id == _spec.value
	}
	false
}

fn findBySpec(spec) {
	_spec = _parseSpec(spec)
	if _spec == null { return null }
	for _id in _allWindows() {
		_w = Window(_id)
		if _matchWindow(_w, _spec) { return _w }
	}
	null
}

fn findAllBySpec(spec) {
	_spec = _parseSpec(spec)
	if _spec == null { return [] }
	_results = []
	for _id in _allWindows() {
		_w = Window(_id)
		if _matchWindow(_w, _spec) { _results.push(_w) }
	}
	_results
}

// ============================================================
// Spec-aware module-level functions
// ============================================================

fn _resolveTarget(target) {
	if typeof(target) == "int" { return Window(target) }
	_w = findBySpec(target)
	_w
}

