}

fn snapWindow(target, position) {
	_w = _resolveTarget(target)
	if _w == null { return false }
	_w.snap(position)
}

fn groupNames() {
	_wins = _allWindows()
	_groups = {}
	for _id in _wins {
		_d = _dpy()
		if _d != 0 {
			_hint = x11.getClassHint(_d, _id)
			if _hint.resClass != "" {
				_groups.set(_hint.resClass, true)
			}
		}
	}
	_groups.keys()
}

// ============================================================
// Wayland compositor window interfaces
// ============================================================

use compositor

// Safe fallback — never crashes, always logs
class FallbackWindowInterface {
	fn activeId() { 0 }
	fn activeTitle() { "" }
	fn activeClass() { "" }
	fn list() { [] }
	fn activate(id) { log.warn("window.activate: not supported on " + compositor.detect()); false }
	fn close(id) { log.warn("window.close: not supported on " + compositor.detect()); false }
	fn minimize(id) { log.warn("window.minimize: not supported on " + compositor.detect()); false }
	fn maximize(id) { log.warn("window.maximize: not supported on " + compositor.detect()); false }
	fn focus(id) { log.warn("window.focus: not supported on " + compositor.detect()); false }
	fn moveToDesktop(id, d) { log.warn("window.moveToDesktop: not supported on " + compositor.detect()); false }
	fn desktops() { [] }
	fn currentDesktop() { -1 }
	fn compositorName() { compositor.detect() }
}

class SwayWindowInterface {
	fn _swaymsg(cmd) {
		_r = shell.exec("swaymsg -t get_{} 2>/dev/null".format(cmd))
		if _r.code != 0 { return null }
		_r.stdout
	}
	fn _swaymsgRaw(cmd) {
		_r = shell.exec("swaymsg {} 2>/dev/null".format(cmd))
		_r.code == 0
	}
	fn activeId() {
		_out = _swaymsg("tree")
		if _out == null { return 0 }
		_tree = json.parse(_out)
		if _tree == null { return 0 }
		_focused = _tree["focus"]
		if _focused == null || #_focused == 0 { return 0 }
		_focused[0]
	}
	fn activeTitle() {
		_r = shell.exec("swaymsg -r -t get_tree | jq -r '.. | select(.focused?) | .name' 2>/dev/null")
		if _r.code != 0 { return "" }
		_r.stdout.trim()
	}
	fn activeClass() {
		_r = shell.exec("swaymsg -r -t get_tree | jq -r '.. | select(.focused?) | .app_id // .window_properties.class // \"\"' 2>/dev/null")
		if _r.code != 0 { return "" }
		_r.stdout.trim()
	}
	fn list() {
		_r = shell.exec("swaymsg -t get_tree | jq -r '[leaf | {id: .id, name: .name, app_id: .app_id, pid: .pid}]' 2>/dev/null")
		if _r.code != 0 { return [] }
		_val = json.parse(_r.stdout)
		if _val == null { [] } else { _val }
	}
	fn activate(id) { _swaymsgRaw("[con_id={}] focus".format(id)) }
	fn close(id) { _swaymsgRaw("[con_id={}] kill".format(id)) }
	fn minimize(id) { false }
	fn maximize(id) { _swaymsgRaw("[con_id={}] fullscreen toggle".format(id)) }
	fn focus(id) { _swaymsgRaw("[con_id={}] focus".format(id)) }
	fn moveToDesktop(id, d) { _swaymsgRaw("[con_id={}] move to workspace {}".format(id, d)) }
	fn desktops() {
		_r = shell.exec("swaymsg -t get_workspaces | jq -r '[.[] | .name]' 2>/dev/null")
		if _r.code != 0 { return [] }
		_val = json.parse(_r.stdout)
		if _val == null { [] } else { _val }
	}
	fn currentDesktop() {
		_r = shell.exec("swaymsg -t get_workspaces | jq -r '.[] | select(.focused) | .name' 2>/dev/null")
		if _r.code != 0 { return -1 }
		_out = _r.stdout.trim()
		if _out == "" { -1 } else { _out }
	}
	fn compositorName() { "sway" }
}

class HyprlandWindowInterface {
	fn _hyprctl(cmd) {
		_r = shell.exec("hyprctl {} -j 2>/dev/null".format(cmd))
		if _r.code != 0 { return null }
		_r.stdout
	}
	fn _hyprctlRaw(cmd) {
		_r = shell.exec("hyprctl {} 2>/dev/null".format(cmd))
		_r.code == 0
	}
	fn activeId() {
		_out = _hyprctl("activewindow")
		if _out == null { return 0 }
		_win = json.parse(_out)
		if _win == null { return 0 }
		_win["address"] ?? 0
	}
	fn activeTitle() {
		_out = _hyprctl("activewindow")
		if _out == null { return "" }
		_win = json.parse(_out)
		if _win == null { return "" }
		_win["title"] ?? ""
	}
	fn activeClass() {
		_out = _hyprctl("activewindow")
		if _out == null { return "" }
		_win = json.parse(_out)
		if _win == null { return "" }
		_win["class"] ?? ""
	}
	fn list() {
		_out = _hyprctl("clients")
		if _out == null { return [] }
		_val = json.parse(_out)
		if _val == null { [] } else { _val }
	}
	fn activate(addr) { _hyprctlRaw("dispatch focuswindow address:{}".format(addr)) }
	fn close(addr) { _hyprctlRaw("dispatch killactive address:{}".format(addr)) }
	fn minimize(addr) { _hyprctlRaw("dispatch movetoworkspace special:minimize address:{}".format(addr)) }
	fn maximize(addr) { _hyprctlRaw("dispatch fullscreen 0 address:{}".format(addr)) }
	fn focus(addr) { _hyprctlRaw("dispatch focuswindow address:{}".format(addr)) }
	fn moveToDesktop(addr, d) { _hyprctlRaw("dispatch movetoworkspace {} address:{}".format(d, addr)) }
	fn desktops() {
		_out = _hyprctl("workspaces")
		if _out == null { return [] }
		_val = json.parse(_out)
		if _val == null { [] } else { _val.map(fn(w) { w["name"] ?? str(w["id"]) }) }
	}
	fn currentDesktop() {
		_out = _hyprctl("activeworkspace")
		if _out == null { return -1 }
		_ws = json.parse(_out)
		if _ws == null { return -1 }
		_ws["name"] ?? -1
	}
	fn compositorName() { "hyprland" }
}

class KdeWindowInterface {
	fn _kdotool(cmd) {
		_r = shell.exec("kdotool {} 2>/dev/null".format(cmd))
		_r
	}
	fn _qdbus(path, method) {
		_r = shell.exec("qdbus org.kde.KWin /KWin {} 2>/dev/null".format(method))
		if _r.code != 0 { return null }
		_r.stdout.trim()
	}
	fn activeId() {
		_r = _kdotool("getactivewindow")
		if _r.code != 0 { return 0 }
		_val = _r.stdout.trim()
		int(_val)
	}
	fn activeTitle() {
		_r = _kdotool("getactivewindow")
		if _r.code != 0 { return "" }
		_wid = _r.stdout.trim()
		_r2 = shell.exec("xdotool getwindowname {} 2>/dev/null".format(_wid))
		if _r2.code != 0 { return "" }
		_r2.stdout.trim()
	}
	fn activeClass() {
		_r = shell.exec("xdotool getwindowclassname $(xdotool getactivewindow) 2>/dev/null")
		if _r.code != 0 { return "" }
		_r.stdout.trim()
	}
	fn list() { [] }
	fn activate(id) { _r = _kdotool("windowactivate {}".format(id)); _r.code == 0 }
	fn close(id) { _r = _kdotool("windowclose {}".format(id)); _r.code == 0 }
	fn minimize(id) { _r = _kdotool("windowminimize {}".format(id)); _r.code == 0 }
	fn maximize(id) {
		shell.exec("qdbus org.kde.KWin /KWin setFullScreen {} true 2>/dev/null".format(id))
		true
	}
	fn focus(id) { _r = _kdotool("windowactivate {}".format(id)); _r.code == 0 }
	fn moveToDesktop(id, d) { false }
	fn desktops() {
		_r = shell.exec("qdbus org.kde.KWin /KWin getDesktops 2>/dev/null")
		if _r.code != 0 { return [] }
		_names = _r.stdout.trim().split("\n")
		_names
	}
	fn currentDesktop() {
		_out = _qdbus("", "currentDesktop")
		if _out == null { return -1 }
		int(_out)
	}
	fn compositorName() { "kde" }
}

// Factory — returns the appropriate interface for the running compositor
_wlInterface = null

fn getInterface() {
	if _wlInterface != null { return _wlInterface }
	_c = compositor.detect()
	if _c == "hyprland" {
		_wlInterface = HyprlandWindowInterface()
	} else if _c == "sway" {
		_wlInterface = SwayWindowInterface()
	} else if _c == "kde" {
		try { _wlInterface = KdeWindowInterface() }
		catch { _wlInterface = FallbackWindowInterface() }
	} else {
		_wlInterface = FallbackWindowInterface()
	}
	_wlInterface
}

// Wayland-compatible module-level functions
fn wlActiveId() { getInterface().activeId() }
fn wlActiveTitle() { getInterface().activeTitle() }
fn wlActiveClass() { getInterface().activeClass() }
fn wlList() { getInterface().list() }
fn wlDesktops() { getInterface().desktops() }
fn wlCurrentDesktop() { getInterface().currentDesktop() }

// ============================================================
// Spec-level module API (argument conventions from spec)
// ============================================================
// Convention: windowId = 0 means "use the active window" because Havel's
// default arguments cannot call functions. All state toggles accept
// windowId last so existing `window.x(target)` calls keep working
// (windowId defaults to the active window). The functions unwrap
// Window objects into ids via _resolveId().

fn _resolveId(x) {
    if x == 0 || x == null { return activeId() }
    if typeof(x) == "int" { return x }
    // Window instance / snapshot — both have .id
    if typeof(x) == "object" && x.id != null { return x.id }
    0
}

// -- Position / size ------------------------------------------------

fn _posAt(windowId = 0, relative = false) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).pos(relative, _id)
}

fn setPos(x, y, speed = 0.0, winId = 0, relative = false) {
    _id = _resolveId(winId)
    if _id == 0 { return null }
    Window(_id).move(x, y, speed, _id, relative)
}

fn sizeAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).size()
}

fn resizeAt(w, h, winId = 0, relative = false) {
    _id = _resolveId(winId)
    if _id == 0 { return null }
    Window(_id).resize(w, h, _id, relative)
}

fn centerAt(monitor = -1, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    _w = Window(_id)
    if monitor >= 0 {
        _mons = display.monitors()
        if monitor >= #_mons { return _w }
        _m = _mons[monitor]
        _g = _w.geometry()
        _cx = _m.x + ((_m.width - _g.width) / 2)
        _cy = _m.y + ((_m.height - _g.height) / 2)
        _w.move(_cx, _cy)
    } else {
        _w.center()
    }
    _w
}

fn geometryAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).geometry()
}

// -- State toggles ---------------------------------------------------

fn _wmStateToggle(windowId, atomFn, action) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    _d = _dpy()
    if _d == 0 { return null }
    protocols.sendStateMessage(_d, _id, action, atomFn(), 0)
    _id
}

fn maxAt(horizontal = true, vertical = true, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).max(horizontal, vertical)
}

fn unmaxAt(horizontal = true, vertical = true, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).unmax(horizontal, vertical)
}

fn toggleMaxAt(horizontal = true, vertical = true, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).toggleMax(horizontal, vertical)
}

fn isMaximizedAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return {horizontal: false, vertical: false, any: false} }
    Window(_id).isMaximized()
}

fn minAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).min()
}

fn unminAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).unmin()
}

fn isMinimizedAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    Window(_id).isMinimized()
}

fn fullscreenAt(enable = true, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).fullscreen(enable)
}

fn toggleFullscreenAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).toggleFullscreen()
}

fn isFullscreenAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    Window(_id).isFullscreen()
}

fn borderlessAt(enable = true, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).borderless(enable)
}

fn isBorderlessAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    Window(_id).isBorderless()
}

fn toggleBorderlessAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).toggleBorderless()
}

fn alwaysOnTopAt(enable = true, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    _action = enable ? protocols.STATE_ADD : protocols.STATE_REMOVE
    _wmStateToggle(_id, protocols.netWmStateAbove, _action)
}

fn isAlwaysOnTopAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    _d = _dpy()
    if _d == 0 { return false }
    protocols.hasState(_d, _id, protocols.netWmStateAbove())
}

fn stickyAt(enable = true, windowId = 0) {
    _action = enable ? protocols.STATE_ADD : protocols.STATE_REMOVE
    _wmStateToggle(windowId, protocols.netWmStateSticky, _action)
}

fn isStickyAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    _d = _dpy()
    if _d == 0 { return false }
    protocols.hasState(_d, _id, protocols.netWmStateSticky())
}

fn shadeAt(enable = true, windowId = 0) {
    _action = enable ? protocols.STATE_ADD : protocols.STATE_REMOVE
    _wmStateToggle(windowId, protocols.netWmStateShaded, _action)
}

fn isShadedAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    _d = _dpy()
    if _d == 0 { return false }
    protocols.hasState(_d, _id, protocols.netWmStateShaded())
}

fn skipTaskbarAt(enable = true, windowId = 0) {
    _action = enable ? protocols.STATE_ADD : protocols.STATE_REMOVE
    _wmStateToggle(windowId, protocols.netWmStateSkipTaskbar, _action)
}

fn isSkipTaskbarAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    _d = _dpy()
    if _d == 0 { return false }
    protocols.hasState(_d, _id, protocols.netWmStateSkipTaskbar())
}

fn skipPagerAt(enable = true, windowId = 0) {
    _action = enable ? protocols.STATE_ADD : protocols.STATE_REMOVE
    _wmStateToggle(windowId, protocols.netWmStateSkipPager, _action)
}

fn isSkipPagerAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    _d = _dpy()
    if _d == 0 { return false }
    protocols.hasState(_d, _id, protocols.netWmStateSkipPager())
}

// -- Focus / stacking ------------------------------------------------

fn raiseAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).raise()
}

fn lowerAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).lower()
}

fn focusAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).activate()
}

// -- Desktop / workspace ---------------------------------------------

fn moveToDesktopAt(desktop, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).moveToDesktop(desktop)
}

fn getDesktop(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return -1 }
    _d = _dpy()
    if _d == 0 { return -1 }
    protocols.getCardinalProp(_d, _id, protocols.netWmDesktop())
}

fn stickyToDesktop(windowId = 0) {
    // All-desktops via _NET_WM_DESKTOP = 0xFFFFFFFF
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    _d = _dpy()
    if _d == 0 { return null }
    _ev = x11.makeClientMessage(_id, protocols.netWmDesktop(), 32, 0xFFFFFFFF, x11.CurrentTime, 0, 0, 0)
    _r = _root()
    if _r != 0 {
        x11.sendEvent(_d, _r, 0, x11.SubstructureRedirectMask + x11.SubstructureNotifyMask, _ev)
        x11.flush(_d)
    }
    x11.freeClientMessage(_ev)
    _id
}

// -- Opacity ---------------------------------------------------------

fn setOpacityAt(alpha, windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).opacity(alpha)
}

fn getOpacity(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return 1.0 }
    _d = _dpy()
    if _d == 0 { return 1.0 }
    _r = x11.getWindowProperty(_d, _id, protocols.netWmWindowOpacity(), 0, 1, 0, x11.XA_CARDINAL)
    if _r.rcode == 0 && _r.nitems >= 1 && _r.prop != 0 {
        _v = ffi.get_u32(_r.prop)
        x11.free(_r.prop)
        return _v / 4294967295.0
    }
    1.0
}

// -- Lifecycle ------------------------------------------------------

fn closeAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).close()
}

fn killAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    Window(_id).kill()
}

fn terminate(windowId = 0) {
    // SIGTERM to owning process — graceful-ish, lets the app clean up.
    _id = _resolveId(windowId)
    if _id == 0 { return null }
    _pid = Window(_id).pid()
    if _pid == 0 { return null }
    _sigterm = 15
    process.sendSignal(_pid, _sigterm)
    _id
}

// -- Query ---------------------------------------------------------

fn exists(windowId) {
    if windowId == null || windowId == 0 { return false }
    _id = _resolveId(windowId)
    if _id == 0 { return false }
    _d = _dpy()
    if _d == 0 { return false }
    _a = x11.getWindowAttributes(_d, _id)
    _a != null
}

fn isActive(windowId) {
    if windowId == null || windowId == 0 { return false }
    _id = _resolveId(windowId)
    _id == activeId()
}

fn titleAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return "" }
    Window(_id).title()
}

fn classAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return "" }
    Window(_id).className()
}

fn exeAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return "" }
    Window(_id).exe()
}

fn pidAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return 0 }
    Window(_id).pid()
}

fn statesAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return [] }
    Window(_id).states()
}

fn frameExtentsAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return {left: 0, right: 0, top: 0, bottom: 0} }
    Window(_id).frameExtents()
}

fn typeAt(windowId = 0) {
    _id = _resolveId(windowId)
    if _id == 0 { return "normal" }
    Window(_id).type()
}

// -- Workspace viewport ------------------------------------------------

fn workspaceCount() {
    _d = _dpy()
    if _d == 0 { return 0 }
    _r = _root()
    if _r == 0 { return 0 }
    protocols.getCardinalProp(_d, _r, protocols.netNumberOfDesktops())
}

fn workspaceAt(index) {
    // Wayland-aware; X11 fallback — uses the Desktop class
    _desk = Desktop()
    _desk.workspaces()[index] ?? ""
}

fn viewport() {
    _d = _dpy()
    if _d == 0 { return {x: 0, y: 0} }
    _r = _root()
    if _r == 0 { return {x: 0, y: 0} }
    _atom = x11.internAtom(_d, "_NET_DESKTOP_VIEWPORT", 1)
    if _atom == 0 { return {x: 0, y: 0} }
    _rr = x11.getWindowProperty(_d, _r, _atom, 0, 2, 0, x11.XA_CARDINAL)
    if _rr.rcode == 0 && _rr.nitems >= 2 && _rr.prop != 0 {
        _vx = ffi.get_u32(_rr.prop)
        _vy = ffi.get_u32(ffi.ptr_add(_rr.prop, 4))
        x11.free(_rr.prop)
        return {x: _vx, y: _vy}
    }
    {x: 0, y: 0}
}
