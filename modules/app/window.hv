fn moveToCorner(target, corner) {
	_w = _resolveTarget(target)
	if _w == null { return false }
	_w.moveToCorner(corner)
}

fn moveToMonitor(target, monitorIndex) {
	_w = _resolveTarget(target)
	if _w == null { return false }
	_w.moveToMonitor(monitorIndex)
}

fn snapWindow(target, position) {
