// Spec-aware module-level window operations
// ============================================================

fn activate(target) {
	_w = _resolveTarget(target)
	if _w == null { return false }
	_w.activate()
}

fn close(target) {
	_w = _resolveTarget(target)
	if _w == null { return false }
	_w.close()
}

