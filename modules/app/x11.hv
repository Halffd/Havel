// x11.hv — Low-level X11 bindings via FFI
// Provides: open, close, rootWindow, internAtom, getAtomName, getWindowProperty,
// sendEvent, moveResizeWindow, moveWindow, resizeWindow, getGeometry,
// getWindowAttributes, translateCoordinates, queryTree, getInputFocus,
// setInputFocus, getWMName, getClassHint, iconifyWindow, mapWindow, unmapWindow,
// configureWindow, changeProp, flush, xSync, defaultScreen, screenCount,
// displayWidth, displayHeight, widthOfScreen, heightOfScreen

use ffi

_xlib = ffi.open("libX11.so.6")
if _xlib == 0 { _xlib = ffi.open("libX11.so") }
// Don't throw here - allow graceful degradation
// if _xlib == 0 { throw "x11: failed to load libX11" }

_XOpenDisplay = _xlib != 0 ? ffi.sym(_xlib, "XOpenDisplay") : 0
_XCloseDisplay = _xlib != 0 ? ffi.sym(_xlib, "XCloseDisplay") : 0
_XInternAtom = _xlib != 0 ? ffi.sym(_xlib, "XInternAtom") : 0
_XGetAtomName = _xlib != 0 ? ffi.sym(_xlib, "XGetAtomName") : 0
_XGetWindowProperty = _xlib != 0 ? ffi.sym(_xlib, "XGetWindowProperty") : 0
_XSendEvent = _xlib != 0 ? ffi.sym(_xlib, "XSendEvent") : 0
_XMoveResizeWindow = _xlib != 0 ? ffi.sym(_xlib, "XMoveResizeWindow") : 0
_XMoveWindow = _xlib != 0 ? ffi.sym(_xlib, "XMoveWindow") : 0
_XResizeWindow = _xlib != 0 ? ffi.sym(_xlib, "XResizeWindow") : 0
_XGetGeometry = _xlib != 0 ? ffi.sym(_xlib, "XGetGeometry") : 0
_XGetWindowAttributes = _xlib != 0 ? ffi.sym(_xlib, "XGetWindowAttributes") : 0
_XRootWindow = _xlib != 0 ? ffi.sym(_xlib, "XRootWindow") : 0
_XDefaultScreen = _xlib != 0 ? ffi.sym(_xlib, "XDefaultScreen") : 0
_XDefaultRootWindow = _xlib != 0 ? ffi.sym(_xlib, "XDefaultRootWindow") : 0
_XSync = _xlib != 0 ? ffi.sym(_xlib, "XSync") : 0
_XFlush = _xlib != 0 ? ffi.sym(_xlib, "XFlush") : 0
_XScreenNumberOfScreen = _xlib != 0 ? ffi.sym(_xlib, "XScreenNumberOfScreen") : 0
_XTranslateCoordinates = _xlib != 0 ? ffi.sym(_xlib, "XTranslateCoordinates") : 0
_XQueryTree = _xlib != 0 ? ffi.sym(_xlib, "XQueryTree") : 0
_XGetInputFocus = _xlib != 0 ? ffi.sym(_xlib, "XGetInputFocus") : 0
_XSetInputFocus = _xlib != 0 ? ffi.sym(_xlib, "XSetInputFocus") : 0
_XFetchName = _xlib != 0 ? ffi.sym(_xlib, "XFetchName") : 0
_XGetClassHint = _xlib != 0 ? ffi.sym(_xlib, "XGetClassHint") : 0
_XIconifyWindow = _xlib != 0 ? ffi.sym(_xlib, "XIconifyWindow") : 0
_XMapWindow = _xlib != 0 ? ffi.sym(_xlib, "XMapWindow") : 0
_XUnmapWindow = _xlib != 0 ? ffi.sym(_xlib, "XUnmapWindow") : 0
_XConfigureWindow = _xlib != 0 ? ffi.sym(_xlib, "XConfigureWindow") : 0
_XChangeProperty = _xlib != 0 ? ffi.sym(_xlib, "XChangeProperty") : 0
_XFree = _xlib != 0 ? ffi.sym(_xlib, "XFree") : 0

// Type signatures
_t_p = ["pointer"]
_t_pi = ["pointer", "int32"]
_t_ppi = ["pointer", "pointer", "int32"]
_t_ppp = ["pointer", "pointer", "pointer"]
_t_puu = ["pointer", "uint64", "uint64"]
_t_pu = ["pointer", "uint64"]
_t_pii = ["pointer", "int32", "int32"]
_t_piii = ["pointer", "int32", "int32", "int32"]
_t_piiii = ["pointer", "int32", "int32", "int32", "int32"]
_t_puuuu = ["pointer", "uint64", "uint64", "uint64", "uint64"]

// Internal: validate display pointer
fn _checkDpy(dpy) {
    if dpy == 0 { throw "X11 display pointer is null" }
}

fn open(name) {
    if name == null || name == "" {
        _dpy = ffi.call(_XOpenDisplay, "uint64", ["pointer"], 0)
    } else {
        _cs = ffi.cstring(name)
        _dpy = ffi.call(_XOpenDisplay, "uint64", ["pointer"], _cs)
        ffi.free(_cs)
    }
    _dpy
}

fn close(dpy) {
    _checkDpy(dpy)
    ffi.call(_XCloseDisplay, "int32", ["pointer"], dpy)
}

fn rootWindow(dpy) {
    _checkDpy(dpy)
    scr = ffi.call(_XDefaultScreen, "int32", ["pointer"], dpy)
    ffi.call(_XRootWindow, "uint64", ["pointer", "int32"], dpy, scr)
}

fn internAtom(dpy, name, onlyIfExists) {
    _checkDpy(dpy)
    _cs = ffi.cstring(name)
    _atom = ffi.call(_XInternAtom, "uint64", ["pointer", "pointer", "int32"], dpy, _cs, onlyIfExists)
    ffi.free(_cs)
    _atom
}

fn getAtomName(dpy, atom) {
    _checkDpy(dpy)
    _ptr = ffi.call(_XGetAtomName, "pointer", ["pointer", "uint64"], dpy, atom)
    if _ptr == 0 { "" }
    else {
        _name = ffi.string(_ptr)
        ffi.call(_XFree, "int32", ["pointer"], _ptr)
        _name
    }
}

fn getWindowProperty(dpy, win, atom, offset, length, delete, reqType) {
    _checkDpy(dpy)
    _actual_type = ffi.allocBytes(8)
    _actual_format = ffi.allocBytes(4)
    _nitems = ffi.allocBytes(8)
    _bytes_after = ffi.allocBytes(8)
    _prop = ffi.allocBytes(8)
    _result = ffi.call(_XGetWindowProperty, "int32", ["pointer", "uint64", "uint64", "int64", "int64", "int32", "uint64", "pointer", "pointer", "pointer", "pointer", "pointer"],
        dpy, win, atom, offset, length, delete, reqType, _actual_type, _actual_format, _nitems, _bytes_after, _prop)
    _type = ffi.get_i64(_actual_type, 0)
    _format = ffi.get_i32(_actual_format, 0)
    _nitems_val = ffi.get_i64(_nitems, 0)
    _bytes_after_val = ffi.get_i64(_bytes_after, 0)
    _prop_val = ffi.get_ptr(_prop, 0)
    if _prop_val == 0 {
        { rcode: _result, ret: _result, type: _type, format: _format, nitems: _nitems_val, prop: 0 }
    }
    else {
        { rcode: _result, ret: _result, type: _type, format: _format, nitems: _nitems_val, prop: _prop_val }
    }
}

fn free(ptr) {
    // XFree takes only the pointer; no display is involved, so no dpy guard.
    if ptr != 0 { ffi.call(_XFree, "int32", ["pointer"], ptr) }
}

fn sendEvent(dpy, dest, propagate, mask, event) {
    _checkDpy(dpy)
    ffi.call(_XSendEvent, "int32", ["pointer", "uint64", "int32", "int64", "pointer"], dpy, dest, propagate, mask, event)
}

fn moveResizeWindow(dpy, win, x, y, w, h) {
    _checkDpy(dpy)
    ffi.call(_XMoveResizeWindow, "int32", ["pointer", "uint64", "int32", "int32", "uint32", "uint32"], dpy, win, x, y, w, h)
}

fn moveWindow(dpy, win, x, y) {
    _checkDpy(dpy)
    ffi.call(_XMoveWindow, "int32", ["pointer", "uint64", "int32", "int32"], dpy, win, x, y)
}

fn resizeWindow(dpy, win, w, h) {
    _checkDpy(dpy)
    ffi.call(_XResizeWindow, "int32", ["pointer", "uint64", "uint32", "uint32"], dpy, win, w, h)
}

fn getGeometry(dpy, win) {
    _checkDpy(dpy)
    _root = ffi.allocBytes(8)
    _x = ffi.allocBytes(4)
    _y = ffi.allocBytes(4)
    _w = ffi.allocBytes(4)
    _h = ffi.allocBytes(4)
    _bw = ffi.allocBytes(4)
    _depth = ffi.allocBytes(4)
    _result = ffi.call(_XGetGeometry, "int32", ["pointer", "uint64", "pointer", "pointer", "pointer", "pointer", "pointer", "pointer", "pointer"],
        dpy, win, _root, _x, _y, _w, _h, _bw, _depth)
    if _result == 0 {
        { rcode: 0, ret: 0, x: 0, y: 0, width: 0, height: 0, borderWidth: 0, depth: 0 }
    } else {
        { rcode: _result, ret: _result, x: ffi.get_i32(_x, 0), y: ffi.get_i32(_y, 0), width: ffi.get_u32(_w, 0), height: ffi.get_u32(_h, 0), borderWidth: ffi.get_u32(_bw, 0), depth: ffi.get_u32(_depth, 0) }
    }
}

fn getWindowAttributes(dpy, win) {
    _checkDpy(dpy)
    _attrs = ffi.allocBytes(200)
    _result = ffi.call(_XGetWindowAttributes, "int32", ["pointer", "uint64", "pointer"], dpy, win, _attrs)
    if _result == 0 {
        null
    } else {
        { rcode: _result, ret: _result, x: ffi.get_i32(_attrs, 0), y: ffi.get_i32(_attrs, 4), width: ffi.get_u32(_attrs, 8), height: ffi.get_u32(_attrs, 12), borderWidth: ffi.get_u32(_attrs, 16), depth: ffi.get_u32(_attrs, 20), visual: ffi.get_ptr(_attrs, 24), root: ffi.get_ptr(_attrs, 32), class: ffi.get_i32(_attrs, 40), bitGravity: ffi.get_i32(_attrs, 44), winGravity: ffi.get_i32(_attrs, 48), backingStore: ffi.get_i32(_attrs, 52), backingPlanes: ffi.get_u64(_attrs, 56), backingPixel: ffi.get_u64(_attrs, 64), saveUnder: ffi.get_i32(_attrs, 72), mapState: ffi.get_i32(_attrs, 76), allEventMasks: ffi.get_i64(_attrs, 80), yourEventMask: ffi.get_i64(_attrs, 88), doNotPropagateMask: ffi.get_i64(_attrs, 96), overrideRedirect: ffi.get_i32(_attrs, 100), screen: ffi.get_ptr(_attrs, 104) }
    }
}

fn translateCoordinates(dpy, src, dst, x, y) {
    _checkDpy(dpy)
    _dest_x = ffi.allocBytes(4)
    _dest_y = ffi.allocBytes(4)
    _child = ffi.allocBytes(8)
    _result = ffi.call(_XTranslateCoordinates, "int32", ["pointer", "uint64", "uint64", "int32", "int32", "pointer", "pointer", "pointer"], dpy, src, dst, x, y, _dest_x, _dest_y, _child)
    if _result == 0 {
        { rcode: 0, ret: 0, destX: 0, destY: 0, child: 0 }
    } else {
        { rcode: _result, ret: _result, destX: ffi.get_i32(_dest_x, 0), destY: ffi.get_i32(_dest_y, 0), child: ffi.get_ptr(_child, 0) }
    }
}

fn queryTree(dpy, win) {
    _checkDpy(dpy)
    _root = ffi.allocBytes(8)
    _parent = ffi.allocBytes(8)
    _children = ffi.allocBytes(8)
    _nchildren = ffi.allocBytes(4)
    _result = ffi.call(_XQueryTree, "int32", ["pointer", "uint64", "pointer", "pointer", "pointer", "pointer"], dpy, win, _root, _parent, _children, _nchildren)
    _root_val = ffi.get_ptr(_root, 0)
    _parent_val = ffi.get_ptr(_parent, 0)
    _children_ptr = ffi.get_ptr(_children, 0)
    _nchildren_val = ffi.get_i32(_nchildren, 0)
    _children_arr = []
    if _children_ptr != 0 && _nchildren_val > 0 {
        for i in 0 .. _nchildren_val {
            _child_ptr = ffi.get_ptr(_children_ptr, i * 8)
            if _child_ptr != 0 { _children_arr.push(_child_ptr) }
        }
    }
    { rcode: _result, ret: _result, root: _root_val, parent: _parent_val, children: _children_arr }
}

fn getInputFocus(dpy) {
    _checkDpy(dpy)
    _focus = ffi.allocBytes(8)
    _revert = ffi.allocBytes(4)
    _result = ffi.call(_XGetInputFocus, "int32", ["pointer", "pointer", "pointer"], dpy, _focus, _revert)
    if _result == 0 {
        { rcode: 0, ret: 0, focus: 0, revertTo: 0 }
    } else {
        { rcode: _result, ret: _result, focus: ffi.get_ptr(_focus, 0), revertTo: ffi.get_i32(_revert, 0) }
    }
}

fn setInputFocus(dpy, win, revert, time) {
    _checkDpy(dpy)
    ffi.call(_XSetInputFocus, "int32", ["pointer", "uint64", "int32", "uint64"], dpy, win, revert, time)
}

fn getWMName(dpy, win) {
    // XFetchName(Display*, Window, char**) -> int Status. The name is an
    // out-param, so pass a pointer slot and read the string after the call.
    _checkDpy(dpy)
    _nameptr = ffi.allocBytes(8)
    _result = ffi.call(_XFetchName, "int32", ["pointer", "uint64", "pointer"], dpy, win, _nameptr)
    if _result == 0 { "" } else { ffi.string(ffi.get_ptr(_nameptr, 0)) }
}

fn getClassHint(dpy, win) {
    _checkDpy(dpy)
    _hint = ffi.allocBytes(16)
    _result = ffi.call(_XGetClassHint, "int32", ["pointer", "uint64", "pointer"], dpy, win, _hint)
    if _result == 0 {
        { rcode: 0, ret: 0, resName: "", resClass: "" }
    } else {
        _resName = ffi.string(ffi.get_ptr(_hint, 0))
        _resClass = ffi.string(ffi.get_ptr(_hint, 8))
        { rcode: _result, ret: _result, resName: _resName, resClass: _resClass }
    }
}

fn iconifyWindow(dpy, win, screen) {
    _checkDpy(dpy)
    ffi.call(_XIconifyWindow, "int32", ["pointer", "uint64", "int32"], dpy, win, screen)
}

fn mapWindow(dpy, win) {
    _checkDpy(dpy)
    ffi.call(_XMapWindow, "int32", ["pointer", "uint64"], dpy, win)
}

fn unmapWindow(dpy, win) {
    _checkDpy(dpy)
    ffi.call(_XUnmapWindow, "int32", ["pointer", "uint64"], dpy, win)
}

fn configureWindow(dpy, win, mask, changes) {
    _checkDpy(dpy)
    ffi.call(_XConfigureWindow, "int32", ["pointer", "uint64", "uint64", "pointer"], dpy, win, mask, changes)
}

fn changeProp(dpy, win, prop, type, format, propMode, data, nelements) {
    _checkDpy(dpy)
    ffi.call(_XChangeProperty, "int32", ["pointer", "uint64", "uint64", "uint64", "int32", "int32", "pointer", "int32"], dpy, win, prop, type, format, propMode, data, nelements)
}

fn flush(dpy) {
    _checkDpy(dpy)
    ffi.call(_XFlush, "int32", ["pointer"], dpy)
}

fn xSync(dpy, discard) {
    _checkDpy(dpy)
    ffi.call(_XSync, "int32", ["pointer", "int32"], dpy, discard)
}

fn defaultScreen(dpy) {
    _checkDpy(dpy)
    ffi.call(_XDefaultScreen, "int32", ["pointer"], dpy)
}

fn screenCount(dpy) {
    _checkDpy(dpy)
    ffi.call(_XScreenCount, "int32", ["pointer"], dpy)
}

fn displayWidth(dpy, screen) {
    _checkDpy(dpy)
    ffi.call(_XDisplayWidth, "int32", ["pointer", "int32"], dpy, screen)
}

fn displayHeight(dpy, screen) {
    _checkDpy(dpy)
    ffi.call(_XDisplayHeight, "int32", ["pointer", "int32"], dpy, screen)
}

fn widthOfScreen(dpy, screen) {
    _checkDpy(dpy)
    ffi.call(_XWidthOfScreen, "int32", ["pointer", "int32"], dpy, screen)
}

fn heightOfScreen(dpy, screen) {
    _checkDpy(dpy)
    ffi.call(_XHeightOfScreen, "int32", ["pointer", "int32"], dpy, screen)
}
