// zoom.hv — desktop magnification for the compositors that actually expose it.
//
// Transports, by backend:
//   cinnamon   modules/app/cinmagnifier.hv — this fork's magnifier IPC
//              socket (fire-and-forget write() per tick). Not an upstream
//              Cinnamon API; the module documents the latency history.
//   gnome      gsettings org.gnome.desktop.a11y.magnifier mag-factor
//              (double, 0.1-32) + ...a11y.applications
//              screen-magnifier-enabled (bool). The org.gnome.Magnifier
//              D-Bus service that older code used was removed upstream in
//              2020 (gnome-shell MR !1523).
//   kde        qdbus org.kde.kglobalaccel /component/kwin invokeShortcut
//              view_zoom_in | view_zoom_out. KWin exposes no zoom D-Bus
//              method at all (no zoomInDBus/getZoomLevelDBus/…); its zoom
//              is reached through kglobalaccel shortcuts. KWin also has no
//              zoom getter, so level() there is our tracked estimate and
//              step-based to()/reset() need the step from kwinrc
//              [Effect-Zoom] TargetZoom, failing loudly without it.
//   hyprland   hyprctl keyword cursor:zoom_factor, read back with
//              hyprctl getoption cursor:zoom_factor.
//   generic    no drivable magnifier: the old config's key sends.
//
// Backend selection is overridable — see setCompositor() — because
// detection reads the environment, which is wrong under nested sessions,
// remote shells and XDG_CURRENT_DESKTOP lying about the running session.
//
// Note on step(): setStep() drives gnome/hyprland. On cinnamon the magnifier
// owns its own step (1.1 per ZoomIn/ZoomOut tick), so setStep() does not
// apply there — the scroll path stays on the precomputed payloads.
//
// Usage:
//   use "app/zoom" as zoom
//   zoom.down() / zoom.up() / zoom.reset() / zoom.to(1.9)
//   zoom.toggle()       // off -> presetHigh, on -> reset
//   zoom.toggleLast()   // remember/restore level
//   zoom.setCompositor("cinnamon")   // force a backend, skip detection
//   zoom.clearCompositor()           // back to auto-detect

use shell
use compositor
use "app/cinmagnifier" as cinmag

// Magnification filter modes (gnome-mag magnification framework enum).
Nearest = 0
Bilinear = 1
Sharpen = 2
Lanczos = 3

// Local policy, not a platform constant: the range this module will drive.
MIN_LEVEL = 1.0
MAX_LEVEL = 8.0

_state = {
    level: 1.0,       // tracked zoom factor. Read back on cinnamon/gnome/
                      // hyprland; a tracked estimate on kde (no getter) and
                      // generic (no magnifier).
    lastToggle: 1.0,  // toggleLast() memory
    step: 0.25,
    presetHigh: 1.9,
    presetLow: 1.6,
    backend: "none",
    checked: false,
    forced: null,     // forced backend name, or null for auto-detect
    debug: false
}

fn _clamp(level) {
    if level < MIN_LEVEL { return MIN_LEVEL }
    if level > MAX_LEVEL { return MAX_LEVEL }
    level
}

fn _log(msg) {
    if _state.debug { print("zoom: $msg") }
}

// ---------------------------------------------------------------------------
// Backend selection
// ---------------------------------------------------------------------------

fn _has(tool) {
    shell.exec("command -v $tool >/dev/null 2>&1").exitCode == 0
}

// The backends this module can actually drive. "generic" is always
// available: it is the key-send fallback, and it is also how an explicitly
// unsupported name resolves.
fn _known(name) {
    n = name.lower().trim()
    n == "cinnamon" || n == "gnome" || n == "kde" || n == "hyprland" || n == "generic"
}

fn _detectBackend() {
    if _state.checked { return }
    _state.checked = true

    if _state.forced != null {
        _state.backend = _state.forced
        return
    }

    c = compositor.detect()

    if c == "cinnamon" && cinmag.available() {
        _state.backend = "cinnamon"
        return
    }
    if c == "gnome" && _has("gsettings") {
        _state.backend = "gnome"
        return
    }
    if c == "kde" && _has("qdbus") {
        _state.backend = "kde"
        return
    }
    if c == "hyprland" && _has("hyprctl") {
        _state.backend = "hyprland"
        return
    }
    // sway / x11 / unknown / a desktop whose magnifier we cannot drive.
    _state.backend = "generic"
}

fn _backend() {
    if !_state.checked { _detectBackend() }
    _state.backend
}

fn backend() { _backend() }

// Force a backend regardless of what the environment claims. Returns false
// (leaving the current selection untouched) for a name this module cannot
// drive, so a typo cannot silently strand you on the key-send fallback.
fn setCompositor(name) {
    n = name.lower().trim()
    if !_known(n) {
        _log("setCompositor: unsupported backend '" + n + "'; unchanged")
        return false
    }
    _state.forced = n
    _state.checked = false
    _state.backend = "none"
    // Re-resolve immediately so a failed force is visible right away.
    _detectBackend()
    _state.backend == n
}

// Back to auto-detection.
fn clearCompositor() {
    _state.forced = null
    _state.checked = false
    _state.backend = "none"
    true
}

fn forcedCompositor() { _state.forced }

// ---------------------------------------------------------------------------
// gnome: GSettings
// ---------------------------------------------------------------------------

fn _gnomeSet(level) {
    p = "org.gnome.desktop.a11y"
    if level <= MIN_LEVEL {
        // Turning the magnifier off is what actually resets the view; the
        // factor alone only changes the zoom of a disabled magnifier.
        shell.exec("gsettings set $p.applications screen-magnifier-enabled false")
        shell.exec("gsettings set $p.magnifier mag-factor " + str(MIN_LEVEL))
        return
    }
    shell.exec("gsettings set $p.magnifier mag-factor " + str(level))
    shell.exec("gsettings set $p.applications screen-magnifier-enabled true")
}

fn _gnomeGet() {
    p = "org.gnome.desktop.a11y"
    // A disabled magnifier shows nothing no matter what mag-factor says, and
    // the factor survives across disable/enable. Reporting the factor alone
    // would make toggle() think a disabled magnifier is zoomed in and call
    // reset() instead of zooming.
    _e = shell.exec("gsettings get $p.applications screen-magnifier-enabled")
    if _e.exitCode == 0 && _e.stdout.trim() == "false" { return MIN_LEVEL }
    _r = shell.exec("gsettings get $p.magnifier mag-factor")
    if _r.exitCode != 0 { return null }
    num(_r.stdout.trim())
}

// ---------------------------------------------------------------------------
// hyprland: hyprctl
// ---------------------------------------------------------------------------

fn _hyprSet(level) {
    shell.exec("hyprctl keyword cursor:zoom_factor " + str(level))
}

fn _hyprGet() {
    _r = shell.exec("hyprctl getoption cursor:zoom_factor")
    if _r.exitCode != 0 { return null }
    // "float 2.000000"
    _parts = _r.stdout.trim().split(" ")
    if _parts.len() < 2 { return null }
    num(_parts[1])
}

// ---------------------------------------------------------------------------
// kde: kglobalaccel shortcuts (kwin has no zoom D-Bus method)
// ---------------------------------------------------------------------------

fn _kdeStep() {
    _r = shell.exec("kreadconfig5 --file kwinrc --group Effect-Zoom --key TargetZoom")
    if _r.exitCode != 0 { return null }
    _s = _r.stdout.trim()
    if _s == "" { return null }
    _v = num(_s)
    if _v == null || _v <= 1.0 { return null }
    _v
}

fn _kdeShortcut(dir) {
    if dir > 0 {
        shell.exec("qdbus org.kde.kglobalaccel /component/kwin invokeShortcut view_zoom_in")
    } else {
        shell.exec("qdbus org.kde.kglobalaccel /component/kwin invokeShortcut view_zoom_out")
    }
}

// KWin exposes no zoom getter, so the level is only reachable by counting
// steps. Without a known step this refuses rather than sending N blind
// shortcut invocations.
fn _kdeToLevel(target) {
    step = _kwinStep()
    if step == null {
        _log("kde: no kwinrc [Effect-Zoom] TargetZoom; cannot set an absolute level")
        return false
    }
    delta = target - _state.level
    if delta > 0 {
        n = int(delta / step + 0.5)
        for i in 0 .. n { _kdeShortcut(1) }
    } else if delta < 0 {
        n = int(-delta / step + 0.5)
        for i in 0 .. n { _kdeShortcut(-1) }
    }
    _state.level = target
    true
}

// ---------------------------------------------------------------------------
// Core operations
// ---------------------------------------------------------------------------

fn down() {
    b = _backend()
    _log("down backend=$b level=" + str(_state.level))

    if b == "cinnamon" { cinmag.zoomOut(); return }
    if b == "gnome" { _gnomeSet(_clamp(_state.level - _state.step)); return }
    if b == "hyprland" { _hyprSet(_clamp(_state.level - _state.step)); return }
    if b == "kde" { if _state.level > MIN_LEVEL { _kdeShortcut(-1) }; return }
    // No compositor magnifier to drive: keep the old config's behaviour.
    send("^{Down}")
}

fn up() {
    b = _backend()
    _log("up backend=$b level=" + str(_state.level))

    if b == "cinnamon" { cinmag.zoomIn(); return }
    if b == "gnome" { _gnomeSet(_clamp(_state.level + _state.step)); return }
    if b == "hyprland" { _hyprSet(_clamp(_state.level + _state.step)); return }
    if b == "kde" { if _state.level < MAX_LEVEL { _kdeShortcut(1) }; return }
    send("^{Up}")
}

fn reset() {
    b = _backend()
    _log("reset backend=$b")

    if b == "cinnamon" { cinmag.reset(); _state.level = MIN_LEVEL; return }
    if b == "gnome" { _gnomeSet(MIN_LEVEL); _state.level = MIN_LEVEL; return }
    if b == "hyprland" { _hyprSet(MIN_LEVEL); _state.level = MIN_LEVEL; return }
    if b == "kde" { _kdeToLevel(MIN_LEVEL); return }
    send("^/")
    _state.level = MIN_LEVEL
}

fn to(level) {
    level = _clamp(level)
    b = _backend()
    _log("to backend=$b level=" + str(level))

    if b == "cinnamon" { cinmag.setLevel(level); _state.level = level; return }
    if b == "gnome" { _gnomeSet(level); _state.level = level; return }
    if b == "hyprland" { _hyprSet(level); _state.level = level; return }
    if b == "kde" { _kdeToLevel(level); return }
    // generic: no absolute level exists to set
    _state.level = level
}

fn presetHigh() {
    b = _backend()
    if b == "cinnamon" { to(_state.presetHigh); return }
    if b == "gnome" { to(_state.presetHigh); return }
    if b == "hyprland" { to(1.7); return }
    if b == "kde" { to(1.9); return }
    send("^+/")
    send("^Up")
    send("^Up")
}

fn presetLow() {
    b = _backend()
    if b == "cinnamon" { to(_state.presetLow); return }
    if b == "gnome" { to(_state.presetLow); return }
    if b == "hyprland" { to(2.0); return }
    if b == "kde" { to(1.6); return }
    send("^+/")
    _state.level = 1.5
}

// Swap the current level with 1.0.
fn toggleLast() {
    if _state.level != MIN_LEVEL {
        _state.lastToggle = _state.level
        reset()
    } else if _state.lastToggle != MIN_LEVEL {
        to(_state.lastToggle)
    } else {
        _log("toggleLast: never zoomed, nothing to restore")
    }
}

// preset-high when off, reset when on.
fn toggle() {
    if _state.level <= MIN_LEVEL {
        presetHigh()
    } else {
        reset()
    }
}

// Cinnamon lens shape / zoom mode cyclers. The magnifier's kc89 bindings
// call these. Other backends have no equivalent surface, so they report
// failure instead of pretending.
fn cycleLens() {
    if _backend() != "cinnamon" {
        _log("cycleLens: cinnamon only")
        return false
    }
    cinmag.cycleLens()
    true
}

fn cycleMode() {
    if _backend() != "cinnamon" {
        _log("cycleMode: cinnamon only")
        return false
    }
    cinmag.cycleMode()
    true
}

fn lensShape() { cinmag.lensShape() }
fn zoomMode() { cinmag.zoomMode() }

// ---------------------------------------------------------------------------
// Introspection
// ---------------------------------------------------------------------------

fn level() { _state.level }

fn getLevel() {
    b = _backend()
    if b == "cinnamon" {
        v = cinmag.getLevel()
        if v != null { _state.level = _clamp(v) }
        return _state.level
    }
    if b == "gnome" {
        v = _gnomeGet()
        if v != null && v >= MIN_LEVEL { _state.level = v }
        return _state.level
    }
    if b == "hyprland" {
        v = _hyprGet()
        if v != null && v >= MIN_LEVEL { _state.level = v }
        return _state.level
    }
    // kde has no zoom getter; generic has no magnifier at all.
    _state.level
}

fn syncLevel() { getLevel() }

fn setStep(s) { _state.step = s }
fn step() { _state.step }

fn setPresetHigh(v) { _state.presetHigh = v }
fn setPresetLow(v) { _state.presetLow = v }

fn setDebug(enabled) { _state.debug = enabled }