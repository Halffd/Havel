// zoom.hv — desktop magnification for the compositors that actually expose it.
//
// Every transport below was verified against upstream sources. What used to
// live here did not exist and never ran:
//   - a Cinnamon magnifier libc IPC socket at /tmp/cinnamon-magnifier-ipc
//     speaking '{"params":[1.1],"method":"ZoomIn"}' — muffin has no such
//     socket and no magnifier IPC of any kind.
//   - org.cinnamon.Muffin.Zoom DBus calls (ZoomIn/ZoomOut/SetZoomLevel/
//     GetZoomLevel/SetLensShapeForMonitor) — muffin exports no Zoom service;
//     `gdbus introspect --dest org.cinnamon.Muffin.Zoom` answers
//     ServiceUnknown.
//   - org.gnome.Magnifier DBus calls — the service existed, but gnome-shell
//     removed it in 2020 (MR !1523, "magnifier: Stop exposing D-Bus
//     interface"). The magnifier is driven by GSettings since.
//   - org.kde.KWin.Effect.Zoom.{zoomInDBus,zoomOutDBus,getZoomLevelDBus,
//     zoomToValueDBus,zoomTo140DBus,resetZoomDBus} — kwin exposes no zoom
//     DBus method; its zoom is reached through kglobalaccel shortcuts.
//
// The verified transports:
//   cinnamon / gnome   gsettings <prefix>.magnifier mag-factor (double,
//                      0.1-32) + <prefix>.applications
//                      screen-magnifier-enabled (bool), where <prefix> is
//                      org.cinnamon.desktop.a11y or org.gnome.desktop.a11y
//                      (linuxmint/cinnamon's cs_accessibility.py uses
//                      exactly these two schema ids).
//   hyprland           hyprctl keyword cursor:zoom_factor <float>,
//                      read back with hyprctl getoption cursor:zoom_factor
//                      ("float 2.000000").
//   kde                qdbus org.kde.kglobalaccel /component/kwin
//                      invokeShortcut view_zoom_in | view_zoom_out. KWin has
//                      no zoom getter, so level() on kde is our own tracked
//                      estimate and step-based to()/reset() need the step from
//                      kwinrc [Effect-Zoom] TargetZoom; without it they
//                      report failure instead of guessing.
//
// Usage:
//   use "app/zoom" as zoom
//   zoom.down()         // step out
//   zoom.up()
//   zoom.reset()
//   zoom.to(1.9)
//   zoom.toggle()       // off -> presetHigh, on -> reset
//   zoom.toggleLast()   // remember/restore level
//   zoom.presetHigh()   // 1.9 mutter / 1.7 hyprland
//   zoom.presetLow()    // 1.6 mutter / 2.0 hyprland

use shell
use compositor

// Magnification filter modes (gnome-mag magnification framework enum).
Nearest = 0
Bilinear = 1
Sharpen = 2
Lanczos = 3

// Local policy, not a platform constant: what this module considers the
// usable zoom range. Both stay inside every backend's own limits.
MIN_LEVEL = 1.0
MAX_LEVEL = 8.0

_state = {
    level: 1.0,       // tracked zoom factor. Authoritative for
                      // cinnamon/gnome (read back) and hyprland (read back);
                      // an estimate for kde (no getter) and generic.
    lastToggle: 1.0,  // toggleLast() memory
    step: 0.25,
    presetHigh: 1.9,
    presetLow: 1.6,
    backend: "none",
    checked: false,
    debug: false
}

fn _clamp(level) {
    if level < MIN_LEVEL { return MIN_LEVEL }
    if level > MAX_LEVEL { return MAX_LEVEL }
    level
}

fn _log(msg) {
    if _state.debug { print("zoom: $msg") }
}

// ---------------------------------------------------------------------------
// Backend detection
// ---------------------------------------------------------------------------

fn _has(tool) {
    shell.exec("command -v $tool >/dev/null 2>&1").exitCode == 0
}

fn _detectBackend() {
    if _state.checked { return }
    _state.checked = true
    c = compositor.detect()

    if c == "cinnamon" && _has("gsettings") {
        _state.backend = "cinnamon"
        return
    }
    if c == "gnome" && _has("gsettings") {
        _state.backend = "gnome"
        return
    }
    if c == "kde" && _has("qdbus") {
        _state.backend = "kde"
        return
    }
    if c == "hyprland" && _has("hyprctl") {
        _state.backend = "hyprland"
        return
    }
    // sway / x11 / unknown / a desktop whose magnifier we cannot drive.
    _state.backend = "generic"
}

fn _backend() {
    if !_state.checked { _detectBackend() }
    _state.backend
}

fn backend() { _backend() }

fn _isMutter(b) { b == "cinnamon" || b == "gnome" }

// ---------------------------------------------------------------------------
// mutter family (cinnamon / gnome): GSettings
// ---------------------------------------------------------------------------

fn _a11yPrefix(b) {
    if b == "cinnamon" { return "org.cinnamon.desktop.a11y" }
    "org.gnome.desktop.a11y"
}

fn _mutterSet(level) {
    p = _a11yPrefix(_backend())
    if level <= MIN_LEVEL {
        // Turning the magnifier off is what actually resets the view; the
        // factor alone only changes the zoom of a disabled magnifier.
        shell.exec("gsettings set $p.applications screen-magnifier-enabled false")
        shell.exec("gsettings set $p.magnifier mag-factor " + str(MIN_LEVEL))
        return
    }
    shell.exec("gsettings set $p.magnifier mag-factor " + str(level))
    shell.exec("gsettings set $p.applications screen-magnifier-enabled true")
}

fn _mutterGet() {
    p = _a11yPrefix(_backend())
    // A disabled magnifier shows nothing no matter what mag-factor says, and
    // the factor survives across disable/enable. Reporting the factor alone
    // would make toggle() think a disabled magnifier is zoomed in and call
    // reset() instead of zooming.
    _e = shell.exec("gsettings get $p.applications screen-magnifier-enabled")
    if _e.exitCode == 0 && _e.stdout.trim() == "false" { return MIN_LEVEL }
    _r = shell.exec("gsettings get $p.magnifier mag-factor")
    if _r.exitCode != 0 { return null }
    num(_r.stdout.trim())
}

// ---------------------------------------------------------------------------
// hyprland: hyprctl
// ---------------------------------------------------------------------------

fn _hyprSet(level) {
    shell.exec("hyprctl keyword cursor:zoom_factor " + str(level))
}

fn _hyprGet() {
    _r = shell.exec("hyprctl getoption cursor:zoom_factor")
    if _r.exitCode != 0 { return null }
    // "float 2.000000"
    _parts = _r.stdout.trim().split(" ")
    if _parts.len() < 2 { return null }
    num(_parts[1])
}

// ---------------------------------------------------------------------------
// kde: kglobalaccel shortcuts (kwin has no zoom DBus method)
// ---------------------------------------------------------------------------

fn _kdeStep() {
    _r = shell.exec("kreadconfig5 --file kwinrc --group Effect-Zoom --key TargetZoom")
    if _r.exitCode != 0 { return null }
    _s = _r.stdout.trim()
    if _s == "" { return null }
    _v = num(_s)
    if _v == null || _v <= 1.0 { return null }
    _v
}

fn _kdeShortcut(dir) {
    if dir > 0 {
        shell.exec("qdbus org.kde.kglobalaccel /component/kwin invokeShortcut view_zoom_in")
    } else {
        shell.exec("qdbus org.kde.kglobalaccel /component/kwin invokeShortcut view_zoom_out")
    }
}

// KWin exposes no zoom getter, so the level is only reachable by counting
// steps. Without a known step this refuses rather than sending N blind
// shortcut invocations.
fn _kdeToLevel(target) {
    step = _kwinStep()
    if step == null {
        _log("kde: no kwinrc [Effect-Zoom] TargetZoom; cannot set an absolute level")
        return false
    }
    delta = target - _state.level
    if delta > 0 {
        n = int(delta / step + 0.5)
        for i in 0 .. n { _kdeShortcut(1) }
    } else if delta < 0 {
        n = int(-delta / step + 0.5)
        for i in 0 .. n { _kdeShortcut(-1) }
    }
    _state.level = target
    true
}

// ---------------------------------------------------------------------------
// Core operations
// ---------------------------------------------------------------------------

fn down() {
    b = _backend()
    _log("down backend=$b level=" + str(_state.level))

    if _isMutter(b) {
        _mutterSet(_clamp(_state.level - _state.step))
        return
    }
    if b == "hyprland" {
        _hyprSet(_clamp(_state.level - _state.step))
        return
    }
    if b == "kde" {
        if _state.level > MIN_LEVEL { _kdeShortcut(-1) }
        return
    }
    // No compositor magnifier to drive: keep the old config's behaviour.
    send("^{Down}")
}

fn up() {
    b = _backend()
    _log("up backend=$b level=" + str(_state.level))

    if _isMutter(b) {
        _mutterSet(_clamp(_state.level + _state.step))
        return
    }
    if b == "hyprland" {
        _hyprSet(_clamp(_state.level + _state.step))
        return
    }
    if b == "kde" {
        if _state.level < MAX_LEVEL { _kdeShortcut(1) }
        return
    }
    send("^{Up}")
}

fn reset() {
    b = _backend()
    _log("reset backend=$b")

    if _isMutter(b) { _mutterSet(MIN_LEVEL); _state.level = MIN_LEVEL; return }
    if b == "hyprland" { _hyprSet(MIN_LEVEL); _state.level = MIN_LEVEL; return }
    if b == "kde" { _kdeToLevel(MIN_LEVEL); return }
    send("^/")
    _state.level = MIN_LEVEL
}

fn to(level) {
    level = _clamp(level)
    b = _backend()
    _log("to backend=$b level=" + str(level))

    if _isMutter(b) { _mutterSet(level); _state.level = level; return }
    if b == "hyprland" { _hyprSet(level); _state.level = level; return }
    if b == "kde" { _kdeToLevel(level); return }
    // generic: no absolute level exists to set
    _state.level = level
}

fn presetHigh() {
    b = _backend()
    if _isMutter(b) { to(_state.presetHigh); return }
    if b == "hyprland" { to(1.7); return }
    if b == "kde" { to(1.9); return }
    send("^+/")
    send("^Up")
    send("^Up")
}

fn presetLow() {
    b = _backend()
    if _isMutter(b) { to(_state.presetLow); return }
    if b == "hyprland" { to(2.0); return }
    if b == "kde" { to(1.6); return }
    send("^+/")
    _state.level = 1.5
}

// Swap the current level with 1.0.
fn toggleLast() {
    if _state.level != MIN_LEVEL {
        _state.lastToggle = _state.level
        reset()
    } else if _state.lastToggle != MIN_LEVEL {
        to(_state.lastToggle)
    } else {
        _log("toggleLast: never zoomed, nothing to restore")
    }
}

// preset-high when off, reset when on.
fn toggle() {
    if _state.level <= MIN_LEVEL {
        presetHigh()
    } else {
        reset()
    }
}

// ---------------------------------------------------------------------------
// Introspection
// ---------------------------------------------------------------------------

fn level() { _state.level }

fn getLevel() {
    b = _backend()
    if _isMutter(b) {
        v = _mutterGet()
        if v != null && v >= MIN_LEVEL { _state.level = v }
        return _state.level
    }
    if b == "hyprland" {
        v = _hyprGet()
        if v != null && v >= MIN_LEVEL { _state.level = v }
        return _state.level
    }
    // kde has no zoom getter; generic has no magnifier at all.
    _state.level
}

fn syncLevel() { getLevel() }

fn setStep(s) { _state.step = s }
fn step() { _state.step }

fn setPresetHigh(v) { _state.presetHigh = v }
fn setPresetLow(v) { _state.presetLow = v }

fn setDebug(enabled) { _state.debug = enabled }