// launcher.hv - pure Havel script launcher
// Handles --run, --test, --lint modes via the self-hosted pipeline
// Usage: havel --run launcher.hv -- [flags] script.hv

fn now() {
    time.now()
}

fn measure(label, t0) {
    print("TIMING: ${label} = ${str(time.now() - t0)}ms")
}

fn loadCompiler() {
    t0 = now()
    use { parse, parseTokens } from "pratt"
    measure("load pratt", t0)

    t0 = now()
    use { tokenize } from "lexer"
    measure("load lexer", t0)

    t0 = now()
    use { Emitter, compileProgram } from "emitter"
    measure("load emitter", t0)

    t0 = now()
    use { inferProgram } from "types"
    measure("load types", t0)

    t0 = now()
    use { setFlag, isOn, dumpBytecodeSummary, dumpBytecode, traceBytecode } from "debug"
    measure("load debug", t0)
}

loadCompiler()

fn readScriptFile(path) {
    if !fs.exists(path) {
        return null
    }
    content = fs.read(path)
    if content == null { return null }
    // Strip shebang line
    if #content >= 2 && content[0] == "#" && content[1] == "!" {
        idx = content.find("\n")
        if idx != null && idx >= 0 {
            content = content.substr(idx + 1)
        }
        else {
            content = ""
        }
    }
    content
}

fn parseArgs(args) {
    cfg = {
        mode: "run",
        scriptFiles: [],
        scriptArgs: [],
        evalString: null,
        testDir: null,
        testTimeout: 10,
        lintOnly: false,
        formatOnly: false,
        debugBytecode: false,
        debugLexer: false,
        debugParser: false,
        debugAst: false,
        stopOnError: false,
    }
    i = 0
    while i < #args {
        arg = args[i]
        if arg == "--run" || arg == "run" {
            cfg.mode = "run"
        }
        else if arg == "--repl" {
            cfg.mode = "repl"
        }
        else if arg == "--test" || arg == "-t" {
            cfg.mode = "test"
            i = i + 1
            if i < #args { cfg.testDir = args[i] }
            // Optional timeout
            i = i + 1
            if i < #args {
                n = int(args[i])
                if n != null && n > 0 {
                    cfg.testTimeout = n
                }
                else {
                    i = i - 1
                }
            }
        }
        else if arg == "--lint" {
            cfg.lintOnly = true
            i = i + 1
        }
        else if arg == "--format" {
            cfg.formatOnly = true
            i = i + 1
        }
        else if arg == "--eval" || arg == "-E" {
            i = i + 1
            if i < #args {
                cfg.evalString = args[i]
                cfg.mode = "run"
            }
        }
        else if arg == "--debug-bytecode" || arg == "-dbc" {
            cfg.debugBytecode = true
        }
        else if arg == "--debug-lexer" || arg == "-dl" {
            cfg.debugLexer = true
        }
        else if arg == "--debug-parser" || arg == "-dp" {
            cfg.debugParser = true
        }
        else if arg == "--debug-ast" || arg == "-da" {
            cfg.debugAst = true
        }
        else if arg == "--error" || arg == "-e" {
            cfg.stopOnError = true
        }
        else if arg == "--" {
            // Everything after -- is script arguments
            j = i + 1
            while j < #args {
                cfg.scriptArgs.push(args[j])
                j = j + 1
            }
            i = #args
        }
        else if arg == "--help" || arg == "-h" {
            print("Usage: havel --run launcher.hv -- [flags] script.hv")
            print("")
            print("Modes:")
            print("  --run script.hv    Run script via self-hosted pipeline")
            print("  --repl             Interactive REPL (optional script.hv loaded first)")
            print("  --test dir/ [N]    Run all .hv files in directory (timeout N seconds)")
            print("  --lint script.hv   Check syntax/type errors without running")
            print("  --format script.hv Format script (pretty-print AST)")
            print("  --eval CODE        Run inline code")
            print("")
            print("Flags:")
            print("  --debug-bytecode   Print bytecode debug info")
            print("  --debug-lexer      Print lexer debug info")
            print("  --debug-parser     Print parser debug info")
            print("  --debug-ast        Print AST debug info")
            print("  --error            Stop on first error")
            print("  --                 Pass remaining args to script as app.args")
            shell.exit(0)
        }
        else {
            // Bare argument = script file
            cfg.scriptFiles.push(arg)
        }
        i = i + 1
    }
    cfg
}

fn runScript(cfg) {
    t_total = now()
    // Combine all script files
    combinedCode = ""
    combinedNames = ""
    for f in cfg.scriptFiles {
        content = readScriptFile(f)
        if content == null {
            print("Error: Cannot open script file: ${f}")
            return 2
        }
        combinedCode = "${combinedCode}${content}\n"
        if combinedNames != "" { combinedNames = "${combinedNames} + " }
        combinedNames = "${combinedNames}${f}"
    }
    if cfg.evalString != null {
        combinedCode = "${combinedCode}${cfg.evalString}\n"
        if combinedNames != "" { combinedNames = "${combinedNames} + " }
        combinedNames = "${combinedNames}<eval>"
    }
    // Read from stdin if no source
    if combinedCode == "" && !shell.isatty() {
        combinedCode = shell.read()
        combinedNames = "<stdin>"
    }
    if combinedCode == "" { return 0 }

    // Parse (split into tokenize + parseTokens)
    t = now()
    tokenList = tokenize(combinedCode)
    measure("parse: tokenize", t)
    t = now()
    result = parseTokens(tokenList)
    measure("parse: parseAST", t)
    if result.errors != null && #result.errors > 0 {
        for err in result.errors {
            print("Parse error: ${str(err.msg)} at line ${str(err.line)} col ${str(err.col)}")
        }
        return 1
    }

    // Format-only mode: parse and pretty-print AST
    if cfg.formatOnly {
        print(str(result.ast))
        shell.exit(0)
    }

    // Lint-only mode: parse + typecheck, no execution
    if cfg.lintOnly {
        t = now()
        types = inferProgram(result)
        measure("lint typecheck", t)
        print("Linting successful")
        shell.exit(0)
    }

    // Typecheck
    t = now()
    inferProgram(result)
    measure("typecheck", t)

    // Compile and execute
    t = now()
    emitter = Emitter()
    bc.reset()
    setFlag("emitter", true)
    sourceFile = null
    if #cfg.scriptFiles > 0 { sourceFile = cfg.scriptFiles[0] }
    if sourceFile == null { sourceFile = combinedNames }
    bcChunk = compileProgram(emitter, result.ast, true, sourceFile)
    measure("emit", t)

    // Point the VM script dir at the user script's own directory so bare
    // module imports (use "name") resolve against scriptDir/name.hv and
    // scriptDir/name/name.hv. Without this the dir stays at the launcher's
    // directory (modules/lang) and colocated modules are never found.
    if #cfg.scriptFiles > 0 {
        scriptPath = cfg.scriptFiles[0]
        slash = scriptPath.lastIndexOf("/")
        if slash != null && slash >= 0 {
            dir = scriptPath.slice(0, slash)
            if dir.startsWith("/") {
                bc.set_script_dir(dir)
            }
            else {
                bc.set_script_dir("${shell.cwd()}/${dir}")
            }
        }
        else {
            bc.set_script_dir(shell.cwd())
        }
    }

    // Spawn the user script as a goroutine
    spawnUserScript(bcChunk)
    measure("TOTAL runScript", t_total)
    return 0
}

// Load script for the REPL via execute_persistent so its globals/functions
// live in the same namespace the REPL evaluates against.
fn loadScriptForRepl(cfg) {
    combinedCode = ""
    combinedNames = ""
    for f in cfg.scriptFiles {
        content = readScriptFile(f)
        if content == null {
            print("Error: Cannot open script file: ${f}")
            return 2
        }
        combinedCode = "${combinedCode}${content}\n"
        if combinedNames != "" { combinedNames = "${combinedNames} + " }
        combinedNames = "${combinedNames}${f}"
    }
    if cfg.evalString != null {
        combinedCode = "${combinedCode}${cfg.evalString}\n"
        if combinedNames != "" { combinedNames = "${combinedNames} + " }
        combinedNames = "${combinedNames}<eval>"
    }
    if combinedCode == "" { return 0 }

    result = parse(combinedCode)
    if result.errors != null && #result.errors > 0 {
        for err in result.errors {
            print("Parse error: ${str(err.msg)} at line ${str(err.line)} col ${str(err.col)}")
        }
        return 1
    }
    inferProgram(result)
    // Track globals from script
    for line in combinedCode.split("\n") {
        for name in extractGlobalsFromLine(line) {
            if !(name in knownGlobals) { 
                knownGlobals.push(name)
                if useReadline { readline.add_completion_word(name) }
            }
        }
    }
    bc.reset()
    setFlag("emitter", true)
    emitter = Emitter()
    compileProgram(emitter, result.ast, true, combinedNames)
    bc.execute_persistent("__main__")
    bc.tick()
    return 0
}

// ============================================================
// Self-hosted REPL
// ============================================================

// Track known globals for :globals command
knownGlobals = ["process", "sys", "shell"]
useReadline = false

// Simple text-based global extraction from REPL line
// Handles: fn name(...), x = ..., class Name, etc.
fn extractGlobalsFromLine(line) {
    names = []
    stripped = line.trim()
    if stripped == "" { return names }
    
    // Function declaration: fn name(...)
    if stripped.startsWith("fn ") {
        rest = stripped.slice(3).trim()
        paren = rest.find("(")
        if paren != null && paren > 0 {
            name = rest.slice(0, paren).trim()
            if name != "" { names.push(name) }
        }
    }
    
    // Class declaration: class Name
    if stripped.startsWith("class ") {
        rest = stripped.slice(6).trim()
        space = rest.find(" ")
        brace = rest.find("{")
        end = -1
        if space != null && brace != null {
            end = space < brace ? space : brace
        } else if space != null {
            end = space
        } else if brace != null {
            end = brace
        }
        if end > 0 {
            name = rest.slice(0, end).trim()
            if name != "" { names.push(name) }
        } else {
            name = rest
            if name != "" { names.push(name) }
        }
    }
    
    // Simple assignment at start of line: name = ...
    // (not compound assignment, not inside expression)
    // Match: ^name =  (where name is identifier)
    if !stripped.startsWith("fn ") && !stripped.startsWith("class ") {
        eq = stripped.find("=")
        if eq != null && eq > 0 {
            before = stripped.slice(0, eq).trim()
            // Check if it's a simple identifier (not compound assignment)
            if before != "" && before[-1] != "+" && before[-1] != "-" && before[-1] != "*" && before[-1] != "/" && before[-1] != "%" && before[-1] != "&" && before[-1] != "|" && before[-1] != "^" && before[-1] != ">" && before[-1] != "<" {
                // Verify it's a valid identifier
                valid = true
                for c in before {
                    if !(c >= "a" && c <= "z" || c >= "A" && c <= "Z" || c >= "0" && c <= "9" || c == "_") {
                        valid = false
                    }
                }
                if valid && !(before[0] >= "0" && before[0] <= "9") {
                    names.push(before)
                }
            }
        }
    }
    
    names
}

fn replEvaluate(cfg, line) {
    result = parse(line)
    if result.errors != null && #result.errors > 0 {
        for err in result.errors {
            print("Parse error: ${str(err.msg)} at line ${str(err.line)} col ${str(err.col)}")
        }
        return null
    }
    try {
        inferProgram(result)
    } catch {
        return null
    }
    // Track new globals from this line
    for name in extractGlobalsFromLine(line) {
        if !(name in knownGlobals) { 
            knownGlobals.push(name)
            if useReadline { readline.add_completion_word(name) }
        }
    }
    bc.reset()
    setFlag("emitter", true)
    emitter = Emitter()
    compileProgram(emitter, result.ast, true, "<repl>")
    try {
        value = bc.execute_persistent("__main__")
        if value != null && value != nil {
            print("// ${str(value)}")
        }
    } catch (e) {
        print("Runtime error: ${str(e)}")
    }
    bc.tick()
}

fn replBalanced(code) {
    brace = 0
    bracket = 0
    paren = 0
    in_string = false
    esc = false
    n = #code
    i = 0
    while i < n {
        c = code[i]
        if esc {
            esc = false
        }
        else if c == "\\" {
            esc = true
        }
        else if c == "\"" {
            in_string = !in_string
        }
        else if !in_string {
            if c == "{" { brace = brace + 1 }
            else if c == "}" { brace = brace - 1 }
            else if c == "[" { bracket = bracket + 1 }
            else if c == "]" { bracket = bracket - 1 }
            else if c == "(" { paren = paren + 1 }
            else if c == ")" { paren = paren - 1 }
            else if c == "/" && i + 1 < n && code[i + 1] == "/" {
                i = n
            }
        }
        i = i + 1
    }
    !in_string && brace == 0 && bracket == 0 && paren == 0
}

fn replLoop(cfg) {
    interactive = shell.isatty(0)
    if interactive {
        // Try to load readline module for line editing/history
        useReadline = true
        try {
            use { readline } from "readline"
            print("Havel self-hosted REPL (Ctrl-D or 'exit' to quit)")
            readline.read_history()  // Load history from default file
        } catch {
            useReadline = false
            print("Havel self-hosted REPL (Ctrl-D or 'exit' to quit)")
        }
    }
    while true {
        pending = ""
        while true {
            if useReadline {
                prompt = (pending == "") ? "havel> " : "...> "
                line = readline.readline(prompt)
                if line != null && line != "" {
                    readline.add_history(line)
                }
            } else {
                while !shell.ready(5) {
                    bc.tick()
                }
                if interactive {
                    if pending == "" {
                        shell.write("havel> ")
                    }
                    else {
                        shell.write("...> ")
                    }
                }
                line = shell.read()
            }
            if line == null {
                if interactive { print("") }
                if pending != "" {
                    replEvaluate(cfg, pending)
                }
                if useReadline {
                    readline.write_history()
                }
                return
            }
            if pending == "" {
                stripped = line.trim()
                if stripped == "" { continue }
                if stripped == "exit" || stripped == "quit" || stripped == ":q" {
                    if useReadline {
                        readline.write_history()
                    }
                    return
                }
                if stripped == "help" || stripped == "?" {
                    print("Commands: exit | quit | :q, help | ?, clear | :clear")
                    print("        :bytecode  - toggle bytecode debug + show summary")
                    print("        :globals   - list known globals")
                    print("        :debug     - toggle debug mode (attach/detach VM debugger)")
                    print("Multi-line: keep typing until braces/brackets/parens balance")
                    continue
                }
                if stripped == "clear" || stripped == ":clear" {
                    print("\033[2J\033[H")
                    continue
                }
                if stripped == ":bytecode" || stripped == ":bc" {
                    setFlag("bytecode", !isOn("bytecode"))
                    bcFlag = isOn("bytecode")
                    print("Bytecode debug: ${(bcFlag ? \"ON\" : \"OFF\")}")
                    if isOn("bytecode") {
                        dumpBytecodeSummary()
                    }
                    continue
                }
                if stripped == ":globals" {
                    if #knownGlobals == 0 {
                        print("No globals defined")
                    }
                    else {
                        print("Known globals: ${knownGlobals.join(\", \")}")
                    }
                    continue
                }
                if stripped == ":debug" {
                    if bc.debug_is_attached() {
                        bc.debug_detach()
                        print("Debug mode: OFF")
                    } else {
                        bc.debug_attach()
                        bc.debug_step_mode(1)  // StepInto
                        print("Debug mode: ON (step mode: StepInto)")
                    }
                    continue
                }
            }
            if pending != "" {
                pending = "${pending}\n"
            }
            pending = "${pending}${line}"
            if replBalanced(pending) {
                replEvaluate(cfg, pending)
                break
            }
        }
    }
}

fn runTests(cfg) {
    if cfg.testDir == null {
        print("Error: No test directory specified. Usage: --test <directory>")
        return 1
    }
    // Find all .hv files
    entries = fs.readDir(cfg.testDir)
    if entries == null {
        print("Error: Cannot read test directory: ${cfg.testDir}")
        return 1
    }
    testFiles = []
    for e in entries {
        name = e.name
        if name == null { name = str(e) }
        if name.endsWith(".hv") {
            testFiles.push("${cfg.testDir}/${name}")
        }
    }
    // Sort
    testFiles.sort()
    if #testFiles == 0 {
        print("Error: No .hv files found in: ${cfg.testDir}")
        return 1
    }

    total = #testFiles
    passed = 0
    failed = 0
    print("Running ${str(total)} tests from '${cfg.testDir}'")

    // Find havel binary
    selfPath = shell.env("HAVEL_BIN")
    if selfPath == null || selfPath == "" {
        // Try common locations
        if fs.exists("./build-debug/havel") {
            selfPath = "./build-debug/havel"
        }
        else if fs.exists("../../build-debug/havel") {
            selfPath = "../../build-debug/havel"
        }
        else {
            selfPath = "havel"
        }
    }

    for testFile in testFiles {
        // Extract test name from path
        parts = string.split(testFile, "/")
        testName = parts[#parts - 1]

        // Run test as subprocess with timeout
        cmd = "timeout ${str(cfg.testTimeout)} ${selfPath} --run ${testFile}"
        result = shell.exec(cmd)

        if result != null && result.exitCode == 0 {
            print("  PASS ${testName}")
            passed = passed + 1
        }
        else {
            print("  FAIL ${testName}")
            if result != null && result.stderr != "" {
                print("    ${result.stderr}")
            }
            failed = failed + 1
        }
    }

    print("")
    print("Test Results:")
    print("  Total:  ${str(total)}")
    print("  Passed: ${str(passed)}")
    print("  Failed: ${str(failed)}")
    if failed > 0 { return 1 }
    print("All tests passed!")
    0
}

// ============================================================
// Spawn user script as a goroutine
// ============================================================

fn spawnUserScript(bcChunk) {
    // bc is a host global, no import needed
    // Store the bytecode chunk so we can spawn it
    chunkId = bc.store_chunk(bcChunk)
    // Spawn the __main__ function from the user script as a goroutine
    bc.spawn_stored(chunkId, "__main__")
}

// ============================================================
// Main entry point
// ============================================================

args = app.args
if args == null || #args == 0 {
    print("Usage: havel --run launcher.hv -- [flags] script.hv")
    print("Use --help for more information")
    1
}

cfg = parseArgs(args)

result = 0
if cfg.mode == "run" {
    result = runScript(cfg)
}
else if cfg.mode == "repl" {
    if #cfg.scriptFiles > 0 {
        result = loadScriptForRepl(cfg)
        if result != 0 { shell.exit(result) }
    }
    replLoop(cfg)
}
else if cfg.mode == "test" {
    result = runTests(cfg)
}
else {
    print("Unknown mode: ${cfg.mode}")
    result = 1
}

// Propagate failure exit codes (parse errors, missing files, failed tests).
// On success, DON'T call shell.exit(): the user script was spawned as a
// goroutine and must run after this returns (the C++ engine.execute() calls
// processGoroutines()).
if result != 0 { shell.exit(result) }
result
