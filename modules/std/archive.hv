// archive.hv — Archive operations via system commands
//
// Loaded by: use { tar_create, tar_extract, tar_list, gzip_compress, gzip_decompress,
//   xz_compress, xz_decompress, zstd_compress, zstd_decompress, format_from_extension,
//   compress, decompress, list } from "std/archive"
//
// Returns: {ok, code, output, entries, error}
//
// format_from_extension(path) returns one of:
//   "tar", "tar.gz", "tar.bz2", "tar.xz", "tar.zst", "zip", "gz", "bz2", "xz", "zst"
// or "" if unknown.
//
// Single-file compress/decompress helpers (gzip_* xz_* zstd_*) operate on a
// single input file and write to disk; they do not produce a multi-entry list.
//
// Calling shell tools is no longer required. We bind directly to the native
// shell.* host functions so archive work runs in-process without spawning
// subprocesses.

use shell

// ============================================================
// format_from_extension
// ============================================================

fn format_from_extension(path) { _ext(path) }

fn _ext(path) {
  if path == null { return "" }
  if path.endsWith(".tar.gz") == true { return "tar.gz" }
  if path.endsWith(".tgz") == true { return "tar.gz" }
  if path.endsWith(".tar.bz2") == true { return "tar.bz2" }
  if path.endsWith(".tbz2") == true { return "tar.bz2" }
  if path.endsWith(".tar.xz") == true { return "tar.xz" }
  if path.endsWith(".txz") == true { return "tar.xz" }
  if path.endsWith(".tar.zst") == true { return "tar.zst" }
  if path.endsWith(".tzst") == true { return "tar.zst" }
  if path.endsWith(".tar") == true { return "tar" }
  if path.endsWith(".zip") == true { return "zip" }
  if path.endsWith(".gz") == true { return "gz" }
  if path.endsWith(".bz2") == true { return "bz2" }
  if path.endsWith(".xz") == true { return "xz" }
  if path.endsWith(".zst") == true { return "zst" }
  ""
}

// ============================================================
// tar-based (multi-entry)
// ============================================================

fn tar_list(archivePath, opts = null) {
  shell.exec("tar -tf " + shell.escape(archivePath))
}

fn tar_extract(archivePath, destDir = null, opts = null) {
  if destDir == null { destDir = "." }
  shell.exec("tar -xf " + shell.escape(archivePath) + " -C " + shell.escape(destDir))
}

fn tar_create(archivePath, sourcePaths, opts = null) {
  if sourcePaths == null || sourcePaths.len() == 0 { return {ok: false, error: "no source paths"} }
  filter = _filter_for_tar(opts)
  cmd = "tar -cf " + shell.escape(archivePath) + " " + filter
  for p in sourcePaths {
    cmd = cmd + " " + shell.escape(p)
  }
  shell.exec(cmd)
}

fn _filter_for_tar(opts) {
  if opts == null { return "" }
  if opts.compress == "gz" { return "-z" }
  if opts.compress == "bz2" { return "-j" }
  if opts.compress == "xz" { return "-J" }
  if opts.compress == "zst" { return "--zstd" }
  ""
}

// ============================================================
// zip-based
// ============================================================

fn zip_list(archivePath) {
  shell.exec("unzip -l " + shell.escape(archivePath))
}

fn zip_extract(archivePath, destDir = null) {
  if destDir == null { destDir = "." }
  shell.exec("unzip -o " + shell.escape(archivePath) + " -d " + shell.escape(destDir))
}

fn zip_create(archivePath, sourcePaths, opts = null) {
  if sourcePaths == null || sourcePaths.len() == 0 { return {ok: false, error: "no source paths"} }
  cmd = "zip -r " + shell.escape(archivePath)
  for p in sourcePaths {
    cmd = cmd + " " + shell.escape(p)
  }
  shell.exec(cmd)
}

// ============================================================
// Single-file compress / decompress
// ============================================================

fn gzip_compress(path, outPath = null) {
  if outPath == null { outPath = path + ".gz" }
  shell.exec("gzip -c " + shell.escape(path) + " > " + shell.escape(outPath))
}

fn gzip_decompress(path, outPath = null) {
  if outPath == null {
    if path.endsWith(".gz") { outPath = path[0 : #path - 3] }
    else { outPath = path + ".out" }
  }
  shell.exec("gzip -dc " + shell.escape(path) + " > " + shell.escape(outPath))
}

fn xz_compress(path, outPath = null) {
  if outPath == null { outPath = path + ".xz" }
  shell.exec("xz -c " + shell.escape(path) + " > " + shell.escape(outPath))
}

fn xz_decompress(path, outPath = null) {
  if outPath == null {
    if path.endsWith(".xz") { outPath = path[0 : #path - 3] }
    else { outPath = path + ".out" }
  }
  shell.exec("xz -dc " + shell.escape(path) + " > " + shell.escape(outPath))
}

fn zstd_compress(path, outPath = null) {
  if outPath == null { outPath = path + ".zst" }
  shell.exec("zstd -c " + shell.escape(path) + " > " + shell.escape(outPath))
}

fn zstd_decompress(path, outPath = null) {
  if outPath == null {
    if path.endsWith(".zst") { outPath = path[0 : #path - 4] }
    else { outPath = path + ".out" }
  }
  shell.exec("zstd -dc " + shell.escape(path) + " > " + shell.escape(outPath))
}

// ============================================================
// High-level helpers
// ============================================================

fn compress(srcPath, destPath = null, opts = null) {
  if destPath == null { destPath = srcPath + ".gz" }
  fmt = _ext(destPath)
  if fmt == "gz"         { return gzip_compress(srcPath, destPath) }
  else if fmt == "xz"    { return xz_compress(srcPath, destPath) }
  else if fmt == "zst"   { return zstd_compress(srcPath, destPath) }
  else if fmt == "zip"   { return zip_create(destPath, [srcPath], opts) }
  else if fmt == "tar"   { return tar_create(destPath, [srcPath], opts) }
  else if fmt == "tar.gz"   { return tar_create(destPath, [srcPath], {compress: "gz"}) }
  else if fmt == "tar.bz2"  { return tar_create(destPath, [srcPath], {compress: "bz2"}) }
  else if fmt == "tar.xz"   { return tar_create(destPath, [srcPath], {compress: "xz"}) }
  else if fmt == "tar.zst"  { return tar_create(destPath, [srcPath], {compress: "zst"}) }
  else { return {ok: false, error: "unknown extension: " + destPath} }
}

fn decompress(archivePath, destDir = null, opts = null) {
  fmt = _ext(archivePath)
  if fmt == "zip"        { return zip_extract(archivePath, destDir) }
  else if fmt == "gz"    {
    out = destDir == null ? null : destDir + "/" + _basename(archivePath, ".gz")
    return gzip_decompress(archivePath, out)
  }
  else if fmt == "xz"    {
    out = destDir == null ? null : destDir + "/" + _basename(archivePath, ".xz")
    return xz_decompress(archivePath, out)
  }
  else if fmt == "zst"   {
    out = destDir == null ? null : destDir + "/" + _basename(archivePath, ".zst")
    return zstd_decompress(archivePath, out)
  }
  else if fmt.startsWith("tar") { return tar_extract(archivePath, destDir, opts) }
  else { return {ok: false, error: "unknown archive format: " + archivePath} }
}

fn list(archivePath) {
  fmt = _ext(archivePath)
  if fmt == "zip" { return zip_list(archivePath) }
  else if fmt.startsWith("tar") { return tar_list(archivePath) }
  else { return {ok: false, error: "cannot list: " + archivePath} }
}

// ============================================================
// Internal helpers
// ============================================================

fn _ext(path) {
  if path == null { return "" }
  if path.endsWith(".tar.gz") == true { return "tar.gz" }
  if path.endsWith(".tgz") == true { return "tar.gz" }
  if path.endsWith(".tar.bz2") == true { return "tar.bz2" }
  if path.endsWith(".tbz2") == true { return "tar.bz2" }
  if path.endsWith(".tar.xz") == true { return "tar.xz" }
  if path.endsWith(".txz") == true { return "tar.xz" }
  if path.endsWith(".tar.zst") == true { return "tar.zst" }
  if path.endsWith(".tzst") == true { return "tar.zst" }
  if path.endsWith(".tar") == true { return "tar" }
  if path.endsWith(".zip") == true { return "zip" }
  if path.endsWith(".gz") == true { return "gz" }
  if path.endsWith(".bz2") == true { return "bz2" }
  if path.endsWith(".xz") == true { return "xz" }
  if path.endsWith(".zst") == true { return "zst" }
  ""
}

fn _basename(path, extToStrip = null) {
  if path == null { return "" }
  base = path
  i = #base - 1
  while i >= 0 {
    if base[i] == "/" { break }
    i -= 1
  }
  if i >= 0 { base = base[i + 1 : #base] }
  if extToStrip != null && base.endsWith(extToStrip) {
    base = base[0 : #base - #extToStrip]
  }
  base
}
