// fn.hv — Function utilities: bind, partial, curry, compose, etc.
//
// Loaded by: use { bind, partial, curry, compose, pipe, flip, identity, constant } from "std/fn"
//
// bind(fn, ...args) - partially apply arguments from the left
//   bind(fn, a, b)(c, d) => fn(a, b, c, d)
//
// bindRight(fn, ...args) - partially apply arguments from the right
//   bindRight(fn, c, d)(a, b) => fn(a, b, c, d)
//
// partial(fn, ...args) - alias for bind
//
// curry(fn) - transform fn(a,b,c) => func(a)(b)(c)
// uncurry(fn) - transform func(a)(b)(c) => fn(a,b,c)
//
// compose(f, g) - f(g(x))
// pipe(f, g) - g(f(x))
//
// flip(f) - fn(a,b) => fn(b,a)
// identity(x) - returns x
// constant(v) - fn(_) => v

// ============================================================
// bind / partial
// ============================================================

fn bind(func, ...boundArgs) {
  func(...boundArgs, ...arguments)
}

fn bindRight(func, ...boundArgs) {
  func(...arguments, ...boundArgs)
}

fn partial(func, ...boundArgs) {
  bind(func, ...boundArgs)
}

// ============================================================
// curry / uncurry
// ============================================================

fn curry(func) {
  if func.length() <= 1 { return func }
  func(a) {
    func(b) {
      func(a, b)
    }
  }
}

// For functions with more than 2 args, we'd need a more complex implementation
// This is a basic 2-arg curry. For N-ary curry, use the general version:
fn curryN(func) {
  func.length() <= 1 { return func }
  firstArg {
    curryN(func.bind(firstArg))
  }
}

fn uncurry(func) {
  func(a, b) { func(a)(b) }
}

// ============================================================
// compose / pipe
// ============================================================

fn compose(f, g) {
  func(x) { f(g(x)) }
}

fn pipe(f, g) {
  func(x) { g(f(x)) }
}

// Multi-function compose: compose(f, g, h)(x) => f(g(h(x)))
fn composeMany(...fns) {
  fns.length() == 0 { return func(x) { x } }
  fns.length() == 1 { return fns[0] }
  // Right-to-left composition
  reduce(fns, func(acc, fn) { compose(fn, acc) }, fns[0])
}

// Multi-function pipe: pipe(f, g, h)(x) => h(g(f(x)))
fn pipeMany(...fns) {
  fns.length() == 0 { return func(x) { x } }
  fns.length() == 1 { return fns[0] }
  reduce(fns, func(acc, fn) { pipe(acc, fn) }, fns[0])
}

// ============================================================
// Basic combinators
// ============================================================

fn flip(f) {
  func(a, b) { f(b, a) }
}

fn identity(x) { x }

fn constant(v) {
  func(_) { v }
}

// ============================================================
// Additional utilities
// ============================================================

// Apply function to each argument: apply(fn, [a,b,c]) => fn(a,b,c)
fn apply(func, args) {
  func(...args)
}

// Thread value through functions: thread(x, f, g, h) => h(g(f(x)))
fn thread(val, ...fns) {
  val = val
  for f in fns {
    val = f(val)
  }
  val
}

// Fixpoint combinator (for recursive anonymous functions)
fn fix(f) {
  func(x) { f(fix(f))(x) }
}

// Memoize a single-argument function
fn memoize(func) {
  cache = {}
  func(x) {
    key = "${x}"
    if cache.has(key) { return cache[key] }
    result = func(x)
    cache[key] = result
    result
  }
}

// Debounce: delay function execution
fn debounce(func, ms) {
  timer = null
  func(...args) {
    if timer != null { clearTimeout(timer) }
    timer = setTimeout(func.bind(this, ...args), ms)
  }
}

// Throttle: limit function execution rate
fn throttle(func, ms) {
  lastCall = 0
  func(...args) {
    now = Date.now()
    if now - lastCall >= ms {
      lastCall = now
      func(...args)
    }
  }
}

// Once: function that only executes once
fn once(func) {
  called = false
  result = null
  func(...args) {
    if !called {
      called = true
      result = func(...args)
    }
    result
  }
}
