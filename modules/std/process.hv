// process.hv — process management wrapping C++ process.* host bridge
// Host bridge: __proc.spawn, __proc.wait, __proc.run, __proc.runDetached,
// __proc.kill, __proc.killObj, __proc.find, __proc.exists, __proc.nice,
// __proc.getState

// ============================================================
// Signal constants
// ============================================================

SIGKILL = 9
SIGTERM = 15
SIGHUP = 1
SIGINT = 2
SIGSTOP = 19
SIGCONT = 18

// ============================================================
// Spawn + wait (two-step async pattern)
// ============================================================

fn spawn(cmd) {
 __proc.spawn(cmd)
}

fn wait(proc) {
 __proc.wait(proc)
}

fn killObj(proc) {
 __proc.killObj(proc)
}

// ============================================================
// Synchronous run — returns {pid, exitCode, success, stdout, stderr, error}
// ============================================================

fn run(cmd) {
 __proc.run(cmd)
}

// Run command and return only stdout (trimmed). Errors logged, not thrown.
fn capture(cmd) {
 r = __proc.run(cmd)
 if !r.success {
  log.warn("process.capture failed: " + r.stderr.trim())
 }
 r.stdout.trim()
}

// Run command, throw on failure.
fn runOrThrow(cmd) {
 r = __proc.run(cmd)
 if !r.success {
  throw("process failed (exit " + str(r.exitCode) + "): " + r.stderr)
 }
 r
}

// ============================================================
// Detached — fire and forget, returns PID
// ============================================================

fn runDetached(cmd) {
 __proc.runDetached(cmd)
}

// ============================================================
// Process finding and existence
// ============================================================

fn find(name) {
 __proc.find(name)
}

fn exists(nameOrPid) {
 __proc.exists(nameOrPid)
}

// ============================================================
// Signal sending and priority
// ============================================================

fn kill(pid, sig) {
 __proc.kill(pid, sig)
}

fn getState(pid) {
 __proc.getState(pid)
}

fn sendSignal(pid, sig) {
 __proc.kill(pid, sig)
}

fn nice(pid, value) {
 __proc.nice(pid, value)
}

// ============================================================
// Higher-level convenience
// ============================================================

// Check if a command is available on PATH
fn which(cmd) {
 r = __proc.run("command -v " + cmd + " 2>/dev/null")
 if r.success { return r.stdout.trim() }
 null
}

// Spawn, wait, return exit code only
fn exec(cmd) {
 p = __proc.spawn(cmd)
 __proc.wait(p)
 p.exitCode
}

// Spawn, wait, return {stdout, stderr, exitCode}
fn output(cmd) {
 p = __proc.spawn(cmd)
 __proc.wait(p)
 {stdout: p.stdout, stderr: p.stderr, exitCode: p.exitCode}
}

// Run command silently, return true on success
fn ok(cmd) {
 r = __proc.run(cmd)
 r.success
}

// Pipeline: run cmd1, pipe stdout into cmd2
fn pipe(cmd1, cmd2) {
 r1 = __proc.run(cmd1)
 if !r1.success { return {success: false, error: r1.stderr} }
 __proc.run("echo '" + r1.stdout.replace("'", "'\\''") + "' | " + cmd2)
}
