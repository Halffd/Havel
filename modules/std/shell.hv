// ============================================================
// History (Havel-side only - not host functions)
// ============================================================

fn historyPath() { 
  home = shell.getenv("HOME")
  if home == null { return null }
  home + "/.havel_history"
}
fn historyRead(path=null) {
  if path == null {
    path = historyPath()
    if path == null { return [] }
  }
  shell.history_read(path)
}
fn historyWrite(lines, path=null) {
  if path == null {
    path = historyPath()
    if path == null { return null }
  }
  shell.history_write(lines, path)
}
fn historyAdd(line, path=null) {
  if path == null {
    path = historyPath()
    if path == null { return null }
  }
  shell.history_add(line, path)
}