// Benchmark: Integer arithmetic
// Tests basic arithmetic operations and local variable access

fn benchmark_integer_add() {
    a = 0
    i = 0
    while i < 1000000 {
        a = a + 1
        i = i + 1
    }
    return a
}

fn benchmark_integer_multiply() {
    a = 1
    i = 0
    while i < 100000 {
        a = a * 2
        if a > 1000000000 {
            a = 1
        }
        i = i + 1
    }
    return a
}

fn benchmark_integer_mixed() {
    a = 100
    b = 50
    c = 25
    i = 0
    while i < 500000 {
        a = a + b
        b = b - c
        c = c * 2
        if c > 10000 {
            c = 1
        }
        i = i + 1
    }
    return a
}

print("arithmetic/integer_add=" + str(benchmark_integer_add()))
print("arithmetic/integer_multiply=" + str(benchmark_integer_multiply()))
print("arithmetic/integer_mixed=" + str(benchmark_integer_mixed()))
