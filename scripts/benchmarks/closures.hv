// Benchmark: Closures and captured variables
// Tests closure creation and execution with captured state

fn benchmark_closure_creation() {
    count = 0
    i = 0
    while i < 100000 {
        x = 10
        f = fn() { x + 1 }
        count = count + 1
        i = i + 1
    }
    return count
}

fn benchmark_closure_calls() {
    count = 0
    i = 0
    x = 42
    f = fn() { x }
    while i < 1000000 {
        result = f()
        count = count + 1
        i = i + 1
    }
    return count
}

fn benchmark_closure_capture() {
    sum = 0
    i = 0
    while i < 10000 {
        x = i
        f = fn() { x * 2 }
        sum = sum + f()
        i = i + 1
    }
    return sum
}

print("closures/closure_creation=" + str(benchmark_closure_creation()))
print("closures/closure_calls=" + str(benchmark_closure_calls()))
print("closures/closure_capture=" + str(benchmark_closure_capture()))
