// Async functionality test (migrated to current async_mod APIs)
use async_mod
use time

print("=== Testing Async Functionality ===")

// Test 1: async work via goroutine + channel
print("1. Testing async work...")

ch = async_mod.chan()
go(fn() {
    print("  Inside async task")
    async_mod.sleep(200)
    ch.send("async result")
})

print("Task started")

// Test 2: waiting for the result
print("2. Testing wait for result...")

result = ch.receive()
print("  Result:", result)
assert(result == "async result", "async result mismatch")

// Test 3: concurrent tasks
print("3. Testing concurrent tasks...")

ch2 = async_mod.chan()
go(fn() {
    async_mod.sleep(100)
    ch2.send("first")
})
go(fn() {
    async_mod.sleep(50)
    ch2.send("second")
})

first = ch2.receive()
second = ch2.receive()
print("  first:", first, "second:", second)
assert(first == "first" || first == "second", "concurrent receive failed")

// Test 4: timeout helper
print("4. Testing timeout helper...")

started = time.now()
result4 = async_mod.withTimeout(fn() { "fast value" }, 1000)
elapsed = time.now() - started
print("  withTimeout result:", result4)
assert(result4.ok == true && result4.value == "fast value", "withTimeout changed value")

print("=== Async tests passed ===")
