// Basic host module functionality test
use time
use fs

pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

// time module
start = time.now()
time.sleep(50)
elapsed = time.now() - start
check("sleep elapsed >= 40", elapsed >= 40, true)
check("sleep elapsed sane", elapsed < 2000, true)

// fs module
testFile = "/tmp/havel_basic_modules_test.txt"
fs.write(testFile, "Hello from Havel!")
content = fs.read(testFile)
check("read back", content, "Hello from Havel!")
check("exists", fs.exists(testFile), true)

// cleanup
fs.delete(testFile)
check("removed", fs.exists(testFile), false)

// clipboard module (headless-safe ops)
clipboard.setText("Test message")
clip = clipboard.getText()
check("clipboard roundtrip", clip, "Test message")
clipboard.clear()

// string module via namespace
use string
check("string toUpper", string.upper("abc"), "ABC")

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
