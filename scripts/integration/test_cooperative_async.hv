// Cooperative async test (migrated to current go/channel APIs)
use async_mod

print("=== Testing Cooperative Async ===")

// Test 1: basic spawn
print("1. Testing basic spawn...")

ch = async_mod.chan()
go(fn() {
    print("  Task running...")
    ch.send("task result")
})

print("Task started")

// Test 2: waiting for the result
print("2. Testing wait for result...")

result = ch.receive()
print("Task result:", result)
assert(result == "task result", "spawn result mismatch")

// Test 3: channel communication between tasks
print("3. Testing channel communication...")

msgs = async_mod.chan()
acks = async_mod.chan()
go(fn() {
    print("  Sender sending message...")
    msgs.send("hello from sender")
})

go(fn() {
    msg = msgs.receive()
    print("  Receiver got:", msg)
    acks.send("ack from receiver")
})

ack = acks.receive()
print("Ack:", ack)
assert(ack == "ack from receiver", "channel ack mismatch")

// Test 4: multiple waiters
print("4. Testing multiple tasks...")

ch3 = async_mod.chan()
for i in 0 .. 3 {
    (fn(n) {
        go(fn() {
            async_mod.sleep(10 * n)
            ch3.send(n)
        })
    })(i)
}

vals = []
for i in 0 .. 3 {
    v = ch3.receive()
    vals.push(v)
}
print("Received values:", vals)
total = 0
for v in vals { total = total + v }
print("Sum of task outputs:", total)
assert(total == 6, "sum mismatch")

print("=== Cooperative async tests passed ===")
