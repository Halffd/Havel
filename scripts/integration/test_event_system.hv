// Event Monitor System test (migrated to current timer/mode APIs)
print("=== Event Monitor Test ===")

// Test timer functions
print("Testing timeout/interval namespaces...")

timerId = timeout.start(1000, fn() {
    print("timeout.start executed after 1 second!")
})

counter = 0
intervalId = interval.start(500, fn() {
    counter = counter + 1
    print("Interval tick: ", counter)
    if counter >= 3 {
        print("Stopping interval after 3 ticks")
        interval.stop(intervalId)
    }
})

// Test mode management
print("Testing mode management...")
print("Mode APIs registered: setMode/getMode live in the mode module")

// Key event registration happens through hotkey bindings; this script
// only verifies that the timer namespaces schedule cleanly headless.
print("All event monitor timer features initialized!")
print("Timers scheduled; callbacks fire on the event loop.")
