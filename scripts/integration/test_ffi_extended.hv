// FFI extended API test (memory, cdef, struct, libc calls)
use ffi
use os

pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

// memory management + typed accessors
ptr = ffi.allocBytes(8)
check("ptr is foreign", type(ptr) == "unknown" || ptr != null, true)

ffi.set_i32(ptr, 42)
check("set/get i32", ffi.get_i32(ptr), 42)

ffi.set_f64(ptr, 3.14159)
v = ffi.get_f64(ptr)
check("get f64 approx", v > 3.14 && v < 3.15, true)

// sizeof / alignof
check("sizeof int32", ffi.sizeof("int32"), 4)
check("alignof int64", ffi.alignof("int64"), 8)

// cstring
cs = ffi.cstring("hello world")
check("cstring non-null", cs != null, true)
ffi.free(cs)

// free the byte buffer
ffi.free(ptr)

// libc symbol + call
libc = ffi.open("libc.so.6")
if libc == 0 { libc = ffi.open("libc.so") }
check("libc handle", libc != 0 && libc != null, true)

getpid = ffi.sym(libc, "getpid")
check("getpid sym", getpid != null, true)

pid = ffi.call(getpid, "int64", [])
check("getpid() == real pid", pid == os.pid(), true)

// errno
ffi.clearError()
e0 = ffi.lastError()
check("errno cleared", e0, 0)

// cdef
decls = ffi.cdef("int getpid(void);")
check("cdef count", #decls, 1)
check("cdef name", decls[0].name, "getpid")

ffi.close(libc)

// struct definition
fields = []
fields.push(["x", "int32"])
fields.push(["y", "int32"])
st = ffi.newStruct("Point", fields)
check("newStruct", st != null, true)

point = ffi.alloc("Point")
check("alloc struct", point != null, true)
ffi.free(point)

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
