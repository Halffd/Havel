gl = ffi.open("/usr/lib/libGL.so")
glfw = ffi.open("/usr/lib/libglfw.so")

glfwInit = ffi.sym(glfw, "glfwInit")
glfwCreateWindow = ffi.sym(glfw, "glfwCreateWindow")
glfwMakeContextCurrent = ffi.sym(glfw, "glfwMakeContextCurrent")
glfwWindowShouldClose = ffi.sym(glfw, "glfwWindowShouldClose")
glfwSwapBuffers = ffi.sym(glfw, "glfwSwapBuffers")
glfwPollEvents = ffi.sym(glfw, "glfwPollEvents")
glfwTerminate = ffi.sym(glfw, "glfwTerminate")

glClear = ffi.sym(gl, "glClear")
glClearColor = ffi.sym(gl, "glClearColor")

ffi.call(glfwInit)

win = ffi.call(glfwCreateWindow, 800, 600, ffi.cstring("Havel GL"), 0, 0)
ffi.call(glfwMakeContextCurrent, win)
ffi.call(glClearColor, 0.1, 0.2, 0.3, 1.0)

while ffi.call(glfwWindowShouldClose, win) == 0 {
    ffi.call(glClear, 0x4000)  // GL_COLOR_BUFFER_BIT
    ffi.call(glfwSwapBuffers, win)
    ffi.call(glfwPollEvents)
}

ffi.call(glfwTerminate)