// integration: json.stringify
// covers: stringify primitives, arrays, objects, escaping, round-trip via parse.
// regression: stringify of a live local object after a host FFI call in a
//   reused function must NOT return "null". json.stringify is correct only when
//   the script does not name a local variable "json" (that would shadow the
//   json module). This test pins the correct behavior.

use json

pass = 0
fail = 0
fn check(n, a, e) { if a == e { pass += 1 } else { fail += 1; print("FAIL $n: got $a, expected $e") } }

// 1. primitives
check("stringify-int", json.stringify(42), "42")
check("stringify-float", json.stringify(3.14), "3.14")
check("stringify-true", json.stringify(true), "true")
check("stringify-false", json.stringify(false), "false")
check("stringify-null", json.stringify(null), "null")
check("stringify-str", json.stringify("hi"), "\"hi\"")
check("stringify-esc-newline", json.stringify("hi\nthere"), "\"hi\\nthere\"")

// 2. array (compact, no inner spaces)
check("stringify-array", json.stringify([1, 2, 3]), "[1,2,3]")

// 3. single-key object (reverse-insertion key order -> single key deterministic)
check("stringify-obj", json.stringify({x: 1}), "{ \"x\": 1 }")
check("stringify-obj-str", json.stringify({method: "ZoomIn"}), "{ \"method\": \"ZoomIn\" }")

// 4. round-trip through parse for nested structure (order-independent)
rt = json.parse(json.stringify({a: [1, 2], b: {c: true, d: null}}))
check("roundtrip-a0", rt.a[0], 1)
check("roundtrip-a1", rt.a[1], 2)
check("roundtrip-b-c", rt.b.c, true)
check("roundtrip-b-d", rt.b.d, null)

// 5. regression: stringify of a live local object after a host FFI call,
//    in a reused function, must not return "null".
_libc = ffi.open("libc.so.6")
if _libc == 0 { _libc = ffi.open("libc.so") }
_getpid = ffi.sym(_libc, "getpid")
fn makeObj(method, params) {
   pid = ffi.call(_getpid, "int32", [])
   obj = { "method": method }
   obj.params = params
   json.stringify(obj)
}
check("ffi-obj-1", makeObj("A", [1.1]), "{ \"params\": [1.1], \"method\": \"A\" }")
check("ffi-obj-2", makeObj("B", [2.2]), "{ \"params\": [2.2], \"method\": \"B\" }")
check("ffi-obj-digits", makeObj("C", [0, 5]), "{ \"params\": [0,5], \"method\": \"C\" }")

print("json-stringify: $pass passed, $fail failed")
exit(fail)
