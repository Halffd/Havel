// regex module functionality test
use regex

pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

// match: entire-text anchoring
check("match hits", regex.match("hello.*world", "hello world"), true)
check("match anchored misses", regex.match("^hello$", "hello world"), false)

// search: substring search
check("search hits", regex.search("world", "hello world"), true)
check("search misses", regex.search("xyz", "hello world"), false)

// replace
check("replace", regex.replace("world", "hello world", "universe"), "hello universe")

// extract
check("extract", regex.extract("\\d+", "abc123def456"), ["123", "456"])

// split
check("split", regex.split("\\s+", "hello world test"), ["hello", "world", "test"])

// escape
check("escape", regex.escape("hello.world*"), "hello\\.world\\*")

// Regex global object (setGlobal)
check("Regex.match exists", type(Regex.match), "function")
check("Regex.search exists", type(Regex.search), "function")

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
