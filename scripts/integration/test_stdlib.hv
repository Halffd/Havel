// Extracted stdlib module tests (math, string, regex namespaces)
pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

print("--- math module ---")
check("abs", math.abs(-5), 5)
check("ceil", math.ceil(3.2), 4)
check("floor", math.floor(3.8), 3)
check("round", math.round(3.5), 4)
check("sqrt", math.sqrt(16), 4)
check("pow", math.pow(2, 10), 1024)
check("min", math.min(3, 7), 3)
check("max", math.max(3, 7), 7)

print("--- string module ---")
use string
check("upper", string.upper("abc"), "ABC")
check("lower", string.lower("ABC"), "abc")
check("trim", string.trim("  pad  "), "pad")

print("--- regex module ---")
use regex
check("match hit", regex.match("f.x", "fox"), true)
check("match miss", regex.match("f.x", "cat"), false)
check("search digits", regex.search("\\d+", "abc123def"), true)
check("replace", regex.replace("fox", "the fox", "cat"), "the cat")

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
