// Struct and class semantics test (current class syntax)
// Classes are reference types; struct-style value copying is exercised
// via explicit field copies since the Struct.define module API was
// replaced by the native class syntax.

pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

print("1. Testing class reference semantics:")

class Point {
  x, y
  fn @(a, b) {
    @x = a
    @y = b
  }
  fn copy() {
    Point(@x, @y)
  }
  fn scaled(n) {
    Point(@x * n, @y * n)
  }
}

p1 = Point(10, 20)
p2 = p1          // reference: same object
p2.x = 30

check("p1.x after p2.x=30 (reference)", p1.x, 30)

print("2. Testing explicit copy (value-style):")

p3 = Point(10, 20)
p4 = p3.copy()
p4.x = 99
check("copy isolates original", p3.x, 10)
check("copy holds new value", p4.x, 99)

print("3. Testing methods:")

p5 = Point(2, 3)
p6 = p5.scaled(10)
check("scaled x", p6.x, 20)
check("scaled y", p6.y, 30)
check("original untouched", p5.x, 2)

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
