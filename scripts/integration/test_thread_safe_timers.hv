// Thread-safe timer API test (migrated to timeout/interval namespaces)
print("=== Testing Timers ===")

// Test 1: basic timeout
print("1. Testing timeout.start...")

timeoutId = timeout.start(1000, fn() {
    print("Timeout executed after 1 second!")
})

print("Started timeout with ID: ", timeoutId)

// Test 2: basic interval
print("2. Testing interval.start...")

count = 0
intervalId = interval.start(500, fn() {
    count = count + 1
    print("Interval executed ", count, " times")
})

print("Started interval with ID: ", intervalId)

// Test 3: stop the interval after enough ticks
print("3. Testing interval.stop...")

timeout.start(2200, fn() {
    interval.stop(intervalId)
    print("Interval stopped after ", count, " ticks")
})

// Test 4: multiple concurrent timers
print("4. Testing concurrent timers...")

for i in 0 .. 3 {
    id = timeout.start(1000 + (i * 200), fn() {
        print("Concurrent timer ", i, " executed!")
    })
    print("Started concurrent timer ", i, " with ID: ", id)
}

// Test 5: error handling
print("5. Testing error handling...")

try {
    invalidId = timeout.start(-100, fn() { print("This should not print") })
    print("No error raised for negative delay, id=", invalidId)
} catch e {
    print("Caught error as expected: ", e)
}

print("=== Timer tests scheduled ===")
