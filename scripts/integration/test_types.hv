// Type system semantics test (current class syntax)
// Covers reference identity, explicit copies and type introspection.

pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

print("1. Testing reference semantics:")

class Point {
  x, y
  fn @(a, b) { @x = a; @y = b }
  fn copy() { Point(@x, @y) }
}

p1 = Point(10, 20)
p2 = p1
p2.x = 30
check("shared identity", p1.x, 30)

p3 = Point(10, 20)
p4 = p3.copy()
p4.x = 99
check("copy isolation", p3.x, 10)

print("2. Testing type introspection:")

check("type name", type(p1), "object")
check("point is object", type(p1) == "object" || type(p1) == "Point", true)

print("3. Testing field access:")

check("field x", p1.x, 30)
check("field y", p1.y, 20)
check("copied field", p4.x, 99)

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
