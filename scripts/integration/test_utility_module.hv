// utility builtins test
pass = 0
fail = 0
fn check(name, actual, expected) {
  if actual == expected { pass += 1 } else { fail += 1; print("FAIL ${name}: got ${actual}, expected ${expected}") }
}

// type()
check("type int", type(123), "int")
check("type str", type("hello"), "string")
check("type array", type([1, 2, 3]), "array")
check("type object", type({a: 1}), "object")

// len()
check("len str", len("hello"), 5)
check("len arr", len([1, 2, 3]), 3)

// keys()
o = {a: 1, b: 2}
ks = keys(o)
check("keys count", #ks, 2)
check("keys has a", ks.has("a"), true)
check("keys has b", ks.has("b"), true)

// str()
check("str int", str(42), "42")

print("=== ${pass} passed, ${fail} failed ===")
if fail > 0 { process.exit(1) }
