// Window manager detection test
use window

print("=== Window Manager Detection Test ===")

title = null
try {
    title = window.getTitle()
} catch e {
    print("no title: " + e)
}

pid = null
try {
    pid = window.getPID()
} catch e {
    print("no pid: " + e)
}

print("title: " + str(title))
print("pid: " + str(pid))
print("=== Test Complete ===")
