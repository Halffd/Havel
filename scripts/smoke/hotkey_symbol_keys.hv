// Regression: symbol and digit keys did not lex as hotkey bindings.
//
// `; => {}`, `\` => {} and `0 => {}` all fell through to the expression parser
// and failed with "Unexpected token in expression" or "Arrow function
// requires an identifier parameter". Four lexer gates had to move together, or
// a hotkey is still not recognised:
//
//   1. isHotkeyChar   - the lookahead scan, must step over the symbol to see `=>`
//   2. key-name scan  - tryParseHotkeyBinding's main loop
//   3. combo-key scan - the same loop after `&`
//   4. hasKeyName     - excluded digits, so `0 => {}` never started a hotkey
//
// Covered through `havel --lint`, never by execution: a hotkey binding in an
// auto-collected suite would register a real global hotkey and dispatch real
// input to the developer's desktop. --lint parses, type-checks and
// bytecode-compiles without running anything, and the sentinel fixture proves
// it (same technique as test_hotkey_condition_shorthand_lint_only.hv).
//
// Expected result: PASS, exit 0. Fails if any symbol or digit form stops
// parsing, if named-key forms regress, if the negative control wrongly lints,
// or if the fixture got executed.
use "fs"
use "process"

FIXTURE_DIR = "${sys.tmpdir()}/havel_symhotkey_${sys.pid()}"
SYMBOL_FIXTURE = "${FIXTURE_DIR}/symbol.hv"
NAMED_FIXTURE = "${FIXTURE_DIR}/named.hv"
BAD_FIXTURE = "${FIXTURE_DIR}/broken.hv"
SENTINEL = "${FIXTURE_DIR}/SIDE_EFFECT.txt"

fs.mkdir(FIXTURE_DIR)

havel_bin = sys.env("HAVEL_BINARY")
if !havel_bin || havel_bin == "" {
    cwd = sys.cwd()
    candidates = ["${cwd}/build-release/havel", "${cwd}/build-nollvm/havel",
                  "${cwd}/build-debug/havel", "${cwd}/havel"]
    havel_bin = ""
    for c in candidates {
        if fs.exists(c) {
            havel_bin = c
            break
        }
    }
    assert(havel_bin != "", "could not locate the havel binary from cwd ${cwd}")
}

// --------------------------------------------------- fixture 1: symbol keys
// Every symbol the keymap registers as an alias of a punctuation row, plus the
// digit keys and the trigger/modifier variants. Each body would write the
// sentinel if executed.
symbol_src = """
0 => { fs.write("SENTINEL_PATH", "executed") }
1 => { fs.write("SENTINEL_PATH", "executed") }
9 => { fs.write("SENTINEL_PATH", "executed") }
; => { fs.write("SENTINEL_PATH", "executed") }
\\ => { fs.write("SENTINEL_PATH", "executed") }
' => { fs.write("SENTINEL_PATH", "executed") }
` => { fs.write("SENTINEL_PATH", "executed") }
[ => { fs.write("SENTINEL_PATH", "executed") }
] => { fs.write("SENTINEL_PATH", "executed") }
= => { fs.write("SENTINEL_PATH", "executed") }
< => { fs.write("SENTINEL_PATH", "executed") }
, => { fs.write("SENTINEL_PATH", "executed") }
. => { fs.write("SENTINEL_PATH", "executed") }
/ => { fs.write("SENTINEL_PATH", "executed") }
- => { fs.write("SENTINEL_PATH", "executed") }
; if true => { fs.write("SENTINEL_PATH", "executed") }
/ if true => { fs.write("SENTINEL_PATH", "executed") }
\\ if true => { fs.write("SENTINEL_PATH", "executed") }
^/ => { fs.write("SENTINEL_PATH", "executed") }
^+a => { fs.write("SENTINEL_PATH", "executed") }
/ & . => { fs.write("SENTINEL_PATH", "executed") }
return 0
"""
symbol_src = symbol_src.replace("SENTINEL_PATH", SENTINEL)
fs.write(SYMBOL_FIXTURE, symbol_src)

res = process.run("\"${havel_bin}\" --lint \"${SYMBOL_FIXTURE}\" 2>&1")
assert(res.exitCode == 0, "symbol/digit hotkey forms must pass --lint, got exit ${res.exitCode}: ${res.stdout}")

// ---------------------------------------------------- fixture 2: named keys
// Named keys already parsed. They are here so widening the key-name scanner
// cannot quietly change how they parse.
named_src = """
escape => print("a")
pgup => print("a")
pagedown => print("a")
F1 => print("a")
numpadadd => print("a")
Ctrl+Shift+F1 => print("a")
LButton & RButton => print("a")
volumeup => print("a")
a => print("a")
return 0
"""
fs.write(NAMED_FIXTURE, named_src)

res2 = process.run("\"${havel_bin}\" --lint \"${NAMED_FIXTURE}\" 2>&1")
assert(res2.exitCode == 0, "named-key hotkey forms must still pass --lint, got exit ${res2.exitCode}: ${res2.stdout}")

// The point of lint-only coverage: nothing ran, so no hotkey was registered
// and the sentinel the fixture would have written does not exist.
assert(!fs.exists(SENTINEL), "--lint must NOT execute the fixture (sentinel created: ${SENTINEL})")

// ----------------------------------------------------- fixture 3: negative
// Proves --lint is a real gate rather than a rubber stamp: an unterminated
// literal must fail lint with a non-zero exit.
fs.write(BAD_FIXTURE, "oops = [1, 2\n")

res3 = process.run("\"${havel_bin}\" --lint \"${BAD_FIXTURE}\" 2>&1")
assert(res3.exitCode != 0, "--lint must FAIL on malformed fixture (got exit 0)")

// ----------------------------------------------------------------- cleanup
fs.remove(FIXTURE_DIR)

print("PASS: symbol and digit hotkey forms parse; nothing executed")
return 0