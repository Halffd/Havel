// regression: shell.exec/shell.run rejected legit commands (allowlist + metachar gate)
// fix: removed gate; shell.exec result now exposes code alias of exitCode (modules read .code)
assert(shell.exec("echo hi 2>/dev/null").exitCode == 0, "redirect (2>) must run")
r = shell.exec("echo a; echo b")
assert(r.exitCode == 0, "semicolon separator must run")
assert(r.stdout.trim() == "a\nb", "separator output must be a and b")
r2 = shell.exec("echo $(echo nested)")
assert(r2.stdout.trim() == "nested", "command substitution must run")
r3 = shell.exec("exit 3")
assert(r3.exitCode == 3, "failing command exitCode must be 3")
assert(r3.code == 3, "code alias must equal exitCode")
pid = shell.run("true")
assert(pid > 0, "shell.run must return child pid")
print(" PASS")