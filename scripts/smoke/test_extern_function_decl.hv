// smoke: timeout = 60
// extern { fn ... } declarations: the declared names resolve to registered
// host functions, the emitted load-time __extern_check passes for each, and
// calls dispatch to the host implementations (sleep and exit are registered
// by the VM; both calls below reach the real host functions).
//
// Regression home for the extern-function registration mechanism
// (docs/reference/extern-types.md, functions half).

extern {
  fn sleep(ms: int) -> nil
  fn exit(code: int) -> nil
}

sleep(1)                // reaches VMM host function sleep(ms)
print("extern sleep ok")
exit(0)
