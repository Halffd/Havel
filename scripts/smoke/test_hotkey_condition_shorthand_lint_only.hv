// Regression: the bare-word condition shorthand documented in
// docs/specs/Havel.md ("F1 when mode gaming => {...}", "when mode gaming { ... }")
// did not parse.
//
// Two separate causes, both fixed in src/havel-lang/parser/Parser.cpp:
//
//   1. Implicit-call sugar was live while a hotkey prefix condition was parsed.
//      `when mode gaming` was therefore read as the call `mode(gaming)`, and
//      that call's argument is parsed at rbp 0, so the argument swallowed the
//      binding's `=>` as an arrow lambda. parseWhenBlock() already turned the
//      sugar off for itself, which is why only the `X when ... =>` forms broke.
//   2. Nothing ever turned a bare word into a comparison, so `mode gaming` had
//      no operator. All five hotkey-binding sites spelled the condition parse
//      out by hand; they now share parseConditionExpression(), which reads the
//      shorthand as `mode == "gaming"`.
//
// Covered through `havel --lint`, never by execution: a hotkey binding in an
// auto-collected suite would register a real global hotkey and dispatch real
// input to the developer's desktop. --lint parses, type-checks and
// bytecode-compiles without running anything, and the sentinel fixture proves
// it (same technique as test_issue_dsl_input_sugar_lint_only.hv).
//
// Expected result: PASS, exit 0. Fails if a documented shorthand form stops
// parsing, if an explicit-comparison form regresses, if the negative control
// wrongly lints, or if the fixture got executed.
use "fs"
use "process"

FIXTURE_DIR = "${sys.tmpdir()}/havel_cond_shorthand_${sys.pid()}"
SHORTHAND_FIXTURE = "${FIXTURE_DIR}/shorthand.hv"
EXPLICIT_FIXTURE = "${FIXTURE_DIR}/explicit.hv"
BAD_FIXTURE = "${FIXTURE_DIR}/broken.hv"
SENTINEL = "${FIXTURE_DIR}/SIDE_EFFECT.txt"

fs.mkdir(FIXTURE_DIR)

// Locate the havel binary. HAVEL_BINARY wins (hvtest sets it when the caller
// does). Otherwise probe release layouts first: the debug build is ASan
// instrumented and aborts during shadow setup on some hosts, which would make
// this test fail for a reason unrelated to the parser.
havel_bin = sys.env("HAVEL_BINARY")
if !havel_bin || havel_bin == "" {
    cwd = sys.cwd()
    candidates = ["${cwd}/build-release/havel", "${cwd}/build-nollvm/havel",
                  "${cwd}/build-debug/havel", "${cwd}/havel"]
    havel_bin = ""
    for c in candidates {
        if fs.exists(c) {
            havel_bin = c
            break
        }
    }
    assert(havel_bin != "", "could not locate the havel binary from cwd ${cwd}")
}

// ------------------------------------------------------- fixture 1: shorthand
// Every bare-word form the spec spells out, plus the chained and
// quoted-word variants. Each binding body would write the sentinel if executed.
shorthand_src = """
use "fs"
mode = "work"
title = "Firefox"
F1 when mode gaming => { fs.write("SENTINEL_PATH", "executed") }
F2 when title Firefox => { fs.write("SENTINEL_PATH", "executed") }
F3 when class code => { fs.write("SENTINEL_PATH", "executed") }
F4 when process steam => { fs.write("SENTINEL_PATH", "executed") }
F5 when group browsers => { fs.write("SENTINEL_PATH", "executed") }
F6 when mode gaming && title == "Game" => { fs.write("SENTINEL_PATH", "executed") }
F7 when mode work && class code && title Visual => { fs.write("SENTINEL_PATH", "executed") }
Enter when mode gaming && title "genshin" => { fs.write("SENTINEL_PATH", "executed") }
when mode gaming { F8 => { fs.write("SENTINEL_PATH", "executed") } }
when mode work { ^b => { fs.write("SENTINEL_PATH", "executed") } }
when title Steam { when title Chrome { F9 => { fs.write("SENTINEL_PATH", "executed") } } }
return 0
"""
shorthand_src = shorthand_src.replace("SENTINEL_PATH", SENTINEL)
fs.write(SHORTHAND_FIXTURE, shorthand_src)

res = process.run("\"${havel_bin}\" --lint \"${SHORTHAND_FIXTURE}\" 2>&1")
assert(res.exitCode == 0, "bare-word condition shorthand must pass --lint, got exit ${res.exitCode}: ${res.stdout}")

// ------------------------------------------------------- fixture 2: explicit
// The explicit-comparison forms are the ones that already parsed. They are
// here so the shorthand fix cannot quietly change how they parse.
explicit_src = """
mode = "work"
F1 when mode == "gaming" => { print("a") }
F2 if mode == "work" => { print("a") }
F3 if health < 50 => print("a")
F4 when health < 50 => print("a")
F5 when title == "A" || title == "B" => print("a")
F6 => print("a")
F7:up => print("a")
F8:: => print("a")
RShift & WheelUp => print("a")
LButton & RButton => print("a")
f9 when gaming => print("a")
return 0
"""
fs.write(EXPLICIT_FIXTURE, explicit_src)

res2 = process.run("\"${havel_bin}\" --lint \"${EXPLICIT_FIXTURE}\" 2>&1")
assert(res2.exitCode == 0, "explicit-comparison hotkey forms must still pass --lint, got exit ${res2.exitCode}: ${res2.stdout}")

// The point of lint-only coverage: nothing ran, so no hotkey was registered
// and the sentinel the fixtures would have written does not exist.
assert(!fs.exists(SENTINEL), "--lint must NOT execute the fixture (sentinel created: ${SENTINEL})")

// ----------------------------------------------------- fixture 3: negative
// Proves --lint is a real gate rather than a rubber stamp: an unterminated
// literal must fail lint with a non-zero exit.
fs.write(BAD_FIXTURE, "oops = [1, 2\n")

res3 = process.run("\"${havel_bin}\" --lint \"${BAD_FIXTURE}\" 2>&1")
assert(res3.exitCode != 0, "--lint must FAIL on malformed fixture (got exit 0)")

// ----------------------------------------------------------------- cleanup
fs.remove(FIXTURE_DIR)

print("PASS: bare-word hotkey condition shorthand parses; nothing executed")
return 0
