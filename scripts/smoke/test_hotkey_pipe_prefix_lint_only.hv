// Regression: a statement-start `|` is BOTH a pipeline stage and a hotkey
// prefix. `numbers\n  | x => x * 2` is a pipeline stage; `|*f13 => {` is a hotkey
// binding. Commit b9ad2afb6 ("pipeline lambda stages map/filter per element")
// made every statement-start `|` a Pipe token, which fixed the multi-line
// pipeline but broke every `|`-prefixed hotkey binding: the parser then read
// the binding as an expression and failed with "Unexpected token in expression:
// |". The lexer now asks isHotkeyLookahead() (which only accepts a following
// `=>`/`if =>`/`when =>`) before deciding, so bindings scan as hotkeys and only
// real stages become Pipe.
//
// Both forms are covered through `havel --lint`, never by execution: a hotkey
// binding in an auto-collected suite would register a real global hotkey and
// dispatch real input to the developer's desktop. --lint parses, type-checks and
// bytecode-compiles without running anything, and the sentinel fixture proves
// it (the same technique as test_issue_dsl_input_sugar_lint_only.hv).
//
// Expected result: PASS, exit 0. Fails if a hotkey binding stops parsing, if a
// multi-line pipeline stops parsing, if the negative control wrongly lints, or
// if the fixture got executed.
use "fs"
use "process"

FIXTURE_DIR = "${sys.tmpdir()}/havel_hotkey_pipe_${sys.pid()}"
PIPE_FIXTURE = "${FIXTURE_DIR}/pipeline.hv"
HOTKEY_FIXTURE = "${FIXTURE_DIR}/hotkeys.hv"
BAD_FIXTURE = "${FIXTURE_DIR}/broken.hv"
SENTINEL = "${FIXTURE_DIR}/SIDE_EFFECT.txt"

fs.mkdir(FIXTURE_DIR)

// Locate the havel binary. HAVEL_BINARY wins (hvtest sets it when the caller
// does). Otherwise probe release layouts first: the debug build is ASan
// instrumented and aborts during shadow setup on some hosts, which would make
// this test fail for a reason unrelated to the lexer.
havel_bin = sys.env("HAVEL_BINARY")
if !havel_bin || havel_bin == "" {
    cwd = sys.cwd()
    candidates = ["${cwd}/build-release/havel", "${cwd}/build-nollvm/havel",
                  "${cwd}/build-debug/havel", "${cwd}/havel"]
    havel_bin = ""
    for c in candidates {
        if fs.exists(c) {
            havel_bin = c
            break
        }
    }
    assert(havel_bin != "", "could not locate the havel binary from cwd ${cwd}")
}

// ------------------------------------------------------- fixture 1: pipeline
// The spec's multi-line pipeline (docs/specs/Havel.md "Lambda Filter/Map
// Detection"): each stage on its own line, indented, `|` + space + lambda.
pipe_src = """
numbers = [1, 2, 3]
doubled = numbers
  | x => x * 2
print(str(doubled))
"""
fs.write(PIPE_FIXTURE, pipe_src)

res = process.run("\"${havel_bin}\" --lint \"${PIPE_FIXTURE}\" 2>&1")
assert(res.exitCode == 0, "multi-line pipeline stage must pass --lint, got exit ${res.exitCode}: ${res.stdout}")

// ------------------------------------------------------- fixture 2: hotkeys
// `|`-prefixed hotkey bindings: a key-only modifier prefix and a bare key.
// The `if`-triggered form (`|^f4 if => {`) is deliberately absent: `if` always
// takes a condition (`F2 if mode == "work" =>`, which does parse), so a bare
// `if` with nothing between it and `=>` is not a form the spec defines.
hotkey_src = """
use "fs"
|*f13 => {
  fs.write("SENTINEL_PATH", "executed")
}
|m => {
  fs.write("SENTINEL_PATH", "executed")
}
return 0
"""
hotkey_src = hotkey_src.replace("SENTINEL_PATH", SENTINEL)
fs.write(HOTKEY_FIXTURE, hotkey_src)

res2 = process.run("\"${havel_bin}\" --lint \"${HOTKEY_FIXTURE}\" 2>&1")
assert(res2.exitCode == 0, "`|`-prefixed hotkey binding must pass --lint, got exit ${res2.exitCode}: ${res2.stdout}")

// The point of lint-only coverage: nothing ran, so no hotkey was registered
// and the sentinel the fixture would have written does not exist.
assert(!fs.exists(SENTINEL), "--lint must NOT execute the fixture (sentinel created: ${SENTINEL})")

// ----------------------------------------------------- fixture 3: negative
// Proves --lint is a real gate rather than a rubber stamp: an unterminated
// literal must fail lint with a non-zero exit.
fs.write(BAD_FIXTURE, "oops = [1, 2\n")

res3 = process.run("\"${havel_bin}\" --lint \"${BAD_FIXTURE}\" 2>&1")
assert(res3.exitCode != 0, "--lint must FAIL on malformed fixture (got exit 0)")

// ----------------------------------------------------------------- cleanup
fs.remove(FIXTURE_DIR)

print("PASS: hotkey prefix and pipeline stage disambiguated; nothing executed")
return 0