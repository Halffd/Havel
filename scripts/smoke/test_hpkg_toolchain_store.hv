// smoke: timeout = 600
// Regression: hpkg's toolchain store (per-commit havel binaries).
//
// The version manager keeps one directory per commit under
// ~/.havel/toolchains/<commit>/ with the binary, the test runner and a .info
// sidecar, and resolves a ref (tag, branch, short sha) to that directory.
// `regress` runs the same command under several toolchains and reports
// pass/fail per commit - the reason the store exists.
//
// Exercised here through the real binary with --from pointing at this build,
// so no build is triggered: install, list, use, current, which, run, regress,
// remove, plus the error paths. Set HAVEL_TOOLCHAIN_STORE to redirect the
// store so a developer's real ~/.havel/toolchains is never touched.
//
// Expected: PASS, exit 0. Fails if any subcommand regresses, if a copied
// binary cannot start (missing runtime .so beside it), or if selection
// precedence between HAVEL_TOOLCHAIN and the default file breaks.
//
// The timeout is 600 s, not the 180 s it used to be.
//
// Every `toolchain run` and `toolchain regress` starts a full havel
// engine: the COPIED binary has to boot AND compile the stdlib from
// source, because a fresh toolchain directory has no bytecode cache.
// There are eight such starts in this script, so the cost is eight
// engine startups.
//
// Measured wall time for the whole script on this box, same binary:
//
//   load  2-3   ->  50 s
//   load  8-11  -> 224 s
//   load  12    -> 409 s (under hvtest, which adds its own overhead)
//
// The script ran with its 180 s budget before the check for the new
// "a script path is a command, not a ref" behavior was added; that check
// starts two more engines. A budget that does not cover the work the
// test actually does turns a load spike into a false failure, and this
// test has failed that way repeatedly (see the gate-evidence table in
// docs/known-issues/x11-hotkey-modifier-and-event-delivery.md).
//
// 600 s is inside the range the suite already uses for scripts that
// legitimately start many engines (test_issue_hotkey_pin_lifetime.hv
// uses 1200 s).

use "fs"
use "process"
use "sys"

HPKG = ""
// Prefer the hpkg built beside the havel binary this suite is running
// (HVTEST sets HAVEL_BINARY to its own build's havel). Probing
// ${cwd}/build-debug first validated a *foreign* build's hpkg: on a box with
// several build dirs that binary can predate the subcommands under test
// (observed: a stale hpkg without toolchain-install --from failed 19 checks
// that the current tree passes). HAVEL_BINARY's directory is by construction
// built from current sources; the cwd candidates remain as fallbacks.
bindir = sys.env("HAVEL_BINARY")
if bindir != null && bindir != "" {
    lastSlash = -1
    bi = #bindir - 1
    while bi >= 0 {
        if bindir[bi:bi+1] == "/" { lastSlash = bi; bi = -1 }
        bi = bi - 1
    }
    if lastSlash > 0 {
        candidates = ["${bindir[0:lastSlash]}/hpkg"]
    } else {
        candidates = []
    }
} else {
    candidates = []
}
for c in ["${sys.cwd()}/build-debug/hpkg", "${sys.cwd()}/build-release/hpkg",
          "${sys.cwd()}/out/bin/hpkg"] {
    candidates.push(c)
}
for c in candidates {
    if fs.exists(c) {
        HPKG = c
        break
    }
}
if HPKG == "" {
    print("SKIP toolchain_store: hpkg binary not built in this configuration")
    process.exit(0)
}

failures = 0

fn check(name, cond) {
    if cond {
        print("PASS " + name)
    } else {
        print("FAIL " + name)
        failures = failures + 1
    }
}

BUILD_DIR = ""
for c in candidates {
    if !fs.exists(c) { continue }
    d = c.substr(0, c.len() - 5)
    if fs.exists(d + "/havel") {
        BUILD_DIR = d
        break
    }
}
if BUILD_DIR == "" {
    print("SKIP toolchain_store: no build dir with a havel binary")
    process.exit(0)
}

STORE = "${sys.tmpdir()}/havel_tc_store_${sys.pid()}"
// process.run execs directly (no shell), so the env assignment goes
// through env(1) rather than a VAR=value prefix.
env_prefix = "env HAVEL_TOOLCHAIN_STORE=" + STORE

// --- the store path is taken from the environment so this test is isolated.
r = process.run(env_prefix + " " + HPKG + " toolchain list")
check("list on an empty store succeeds", r.exitCode == 0 && r.stdout.includes("no toolchains installed"))

// --- install the current commit, plus an older one, via --from.
head = process.run("git rev-parse HEAD").stdout.trim()
check("HEAD is resolvable in this repo", head != "" && #head >= 40)

r = process.run(env_prefix + " " + HPKG + " toolchain install " + head + " --from " + BUILD_DIR)
check("install registers the current commit", r.exitCode == 0 && r.stdout.includes("installed toolchain"))

r = process.run(env_prefix + " " + HPKG + " toolchain list")
check("list shows the installed commit", r.stdout.includes(head.substr(0, 12)))

r = process.run(env_prefix + " " + HPKG + " toolchain install " + head + " --from " + BUILD_DIR)
check("installing the same commit twice is a no-op", r.stdout.includes("already installed"))

// --- which / use / current
r = process.run(env_prefix + " " + HPKG + " toolchain which " + head)
// The store is relocated by HAVEL_TOOLCHAIN_STORE, so assert on the binary
// filename rather than on the default ~/.havel/toolchains location.
check("which prints a path to the binary", r.exitCode == 0 && r.stdout.trim().endsWith("/havel"))

r = process.run(env_prefix + " " + HPKG + " toolchain use " + head)
check("use sets the default", r.exitCode == 0 && r.stdout.includes("default toolchain set"))

r = process.run(env_prefix + " " + HPKG + " toolchain current")
check("current reports the selection", r.exitCode == 0 && r.stdout.includes(head.substr(0, 12)))

// --- run: the copied binary must actually start. A binary copied without its
// runtime .so files dies 127 here, which is the whole point of copying them.
FIXTURE = "${sys.tmpdir()}/havel_tc_script_${sys.pid()}.hv"
fs.write(FIXTURE, "print(\"TOOLCHAIN_RAN\")\n")
r = process.run(env_prefix + " " + HPKG + " toolchain run " + head + " run " + FIXTURE)
check("run executes the stored binary", r.exitCode == 0 && r.stdout.includes("TOOLCHAIN_RAN"))

// The first argument is a ref only if it resolves to an installed
// toolchain; otherwise the whole arg list runs under the current one. So
// a script path as the first argument must reach the current toolchain's
// havel - not be rejected as an unknown ref.
r = process.run(env_prefix + " " + HPKG + " toolchain run " + FIXTURE)
check("run treats a script path as a command, not a ref", r.exitCode == 0 && r.stdout.includes("TOOLCHAIN_RAN"))

// --- regress: same command under the selected toolchain, pass and fail.
r = process.run(env_prefix + " " + HPKG + " toolchain regress " + head + " -- run " + FIXTURE)
check("regress reports the passing toolchain", r.exitCode == 0 && r.stdout.includes("passed:"))

FAILFIX = "${sys.tmpdir()}/havel_tc_fail_${sys.pid()}.hv"
fs.write(FAILFIX, "process.exit(3)\n")
r = process.run(env_prefix + " " + HPKG + " toolchain regress " + head + " -- run " + FAILFIX)
check("regress reports a failing toolchain", r.exitCode == 1 && r.stdout.includes("failed:"))

// --- tags: every tag in the repo with the commit it points at, newest first,
// and an [installed] marker once that commit is in the store.
r = process.run(env_prefix + " " + HPKG + " toolchain tags --repo .")
check("tags exits 0 on a repository", r.exitCode == 0)
tagRows = r.stdout.trim().split("\n")
check("tags lists the repository's tags", #tagRows > 0)

// Every listed name must be a real tag, and the listing must not drop any.
r = process.run("git tag")
gitTags = r.stdout.trim().split("\n")
missing = 0
for t in gitTags {
    if t == "" { continue }
    found = 0
    for row in tagRows {
        parts = row.split(" ")
        if parts[0] == t || parts[0] == "tags/" + t { found = 1 }
    }
    if found == 0 { missing = missing + 1 }
}
check("every git tag appears in the listing", missing == 0)

// An installed tag must be marked. Any tag will do: --from registers the
// CURRENT binary under the commit that tag resolves to, which is exactly the
// store bookkeeping this exercises (no build, no download).
if #gitTags > 0 && gitTags[0] != "" {
    someTag = gitTags[0]
    r = process.run(env_prefix + " " + HPKG + " toolchain install " + someTag + " --from " + BUILD_DIR)
    check("a tag resolves and installs", r.exitCode == 0 && r.stdout.includes("installed toolchain"))
    r = process.run(env_prefix + " " + HPKG + " toolchain tags --repo . --all")
    check("installed tag is marked in the listing", r.stdout.includes("[installed]"))
} else {
    print("SKIP installed-tag marker (this checkout has no tags)")
}

// tags outside a repository must be refused, not crash.
r = process.run(env_prefix + " " + HPKG + " toolchain tags --repo /nonexistent-repo-dir")
check("tags refuses a non-repository path", r.exitCode == 1 && r.stderr.includes("cannot read tags"))

// --- error paths
//
// The first argument of `toolchain run` is a toolchain ref ONLY if it
// resolves to an INSTALLED toolchain; anything else (a script path, a
// flag, ...) means "run under the current toolchain". That is deliberate:
// `hpkg toolchain run ./script.hv` is the natural spelling, and treating
// the path as a ref name produced the absurd
// "not installed: /home/.../script.hv".
//
// So an uninstalled ref is NOT an error while a default is set - it falls
// back to the current toolchain. The refusal only happens when there is
// no default either. The check below therefore uses a store with no
// default selected, which is the case that must still be refused.
EMPTY_STORE = "${sys.tmpdir()}/havel_tc_empty_${sys.pid()}"
r = process.run("env HAVEL_TOOLCHAIN_STORE=" + EMPTY_STORE + " " + HPKG + " toolchain run deadbeefdeadbeef run x.hv")
check("run refuses an uninstalled ref with no default", r.exitCode == 1 && r.stderr.includes("not an installed toolchain"))

// With a default set, the same uninstalled ref falls back to the current
// toolchain - the first arg is then part of the command, so the run fails
// on the missing script rather than on the ref.
r = process.run(env_prefix + " " + HPKG + " toolchain run deadbeefdeadbeef run x.hv")
check("run falls back to the current toolchain for an uninstalled ref", r.exitCode == 1 && !r.stderr.includes("not an installed toolchain"))

r = process.run(env_prefix + " " + HPKG + " toolchain install nosuchrefatall")
check("install refuses an unknown ref", r.exitCode == 1 && r.stderr.includes("ref not found"))

r = process.run(env_prefix + " " + HPKG + " toolchain install " + head + " --no-build")
check("--no-build without --from is rejected", r.exitCode == 1 && r.stderr.includes("--no-build requires --from"))

r = process.run(env_prefix + " " + HPKG + " toolchain remove " + head)
check("remove refuses to drop the default", r.exitCode == 1 && r.stderr.includes("default"))

// --- clean up
r = process.run(env_prefix + " " + HPKG + " toolchain use " + head)
fs.remove_all(STORE)
fs.remove_all(EMPTY_STORE)
fs.remove(FIXTURE)
fs.remove(FAILFIX)

if failures > 0 {
    print("FAIL toolchain_store: " + failures + " check(s) failed")
    process.exit(1)
}
print("PASS toolchain_store")
process.exit(0)