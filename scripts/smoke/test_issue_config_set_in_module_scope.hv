// Regression: cfg.set() called from a MODULE's top level must not kill the
// importing script.
//
// Failure (Nov 8, gdb): hotkeys0.3.hv -> start.hv (a module) -> cfg.set ->
// config.set -> repopulate(configObjAtCall()) -> setNestedField ->
// setField(null, ...) -> throw "VMApi::setField: expected object".
//
// Cause: the config module resolved the "config" global through
// api.vm().getGlobals(), which is the AMBIENT scope. A module body runs in
// the module sandbox (a fresh globals map), so "config" was not bound there:
// the lookup returned null and the repopulate path handed that null to
// setField. The lookup must search the same scope chain a script-level
// global read uses (ambient -> module base layer -> pushed frames).
//
// The fixture module's top level calls cfg.set(), which is exactly the
// shape that failed. Runs in a sandbox HOME so the developer's real config
// file is never touched.
//
// Expected: the module loads, the value it wrote is visible through the
// importing script's cfg, exit 0.

use "std/config" as cfg
use "config_scope_fixture/setter" as setter
use sys

home = sys.env("HOME")
if !home || home == "" {
  home = sys.tmpdir()
}

// The module writes through the config object from a module scope and
// reads the value back through the SAME object - the object the main
// scope holds. This is the property the fix restores: the write must land
// on the live object, not on a scope-local copy.
//
// The read-back is IN-PROCESS on purpose: config.set persists to disk only
// on an explicit save (the host bridge's config.set takes an optional
// save flag), so a separate process would race the file write.
fs.write(MODULE_FILE, """
use "std/config" as cfg
cfg.set("Probe.ScopeKey", "from-module")
value = cfg.get("Probe.ScopeKey", "missing")
print("module: cfg.set returned")
print("module: readback " + value)
""")

// The importing script's own cfg must see the same value.
direct = cfg.get("Smoke.ConfigScope", "")
assert direct == "from-module", "script-level cfg.get must see the module's write, got '${direct}'"

// Negative control: no main-scope import, so the module's own import
// registers the object in the module scope.
fs.write(MAIN_NO_IMPORT, """
use "writer"
print("main: module imported")
""")

// ------------------------------------------------- failing shape (fixed)
res = process.run("HOME=\"${SANDBOX_HOME}\" \"${havel_bin}\" \"${MAIN_WITH_IMPORT}\" 2>&1")
assert(res.exitCode == 0,
       "cfg.set() from a module scope must not crash; exit ${res.exitCode}, output: ${res.stdout}")
assert(res.stdout.find("expected object") < 0,
       "cfg.set() from a module scope must not throw setField errors; output: ${res.stdout}")
assert(res.stdout.find("module: cfg.set returned") >= 0,
       "the module's cfg.set() must have completed; output: ${res.stdout}")
assert(res.stdout.find("module: readback from-module") >= 0,
       "the value written from the module scope must read back on the same object; output: ${res.stdout}")
assert(res.stdout.find("main: module imported") >= 0,
       "the main script must have continued past the module import; output: ${res.stdout}")

// ------------------------------------------------- negative control
res2 = process.run("HOME=\"${SANDBOX_HOME}\" \"${havel_bin}\" \"${MAIN_NO_IMPORT}\" 2>&1")
assert(res2.exitCode == 0,
       "the no-main-import shape must also pass; exit ${res2.exitCode}, output: ${res2.stdout}")

// The value the module wrote must be readable through the config store.
// config.get() takes (key, default) - the host bridge rejects a single
// argument - so the read-back passes an explicit default.
// The fixture body deliberately contains NO '$': the outer triple-quoted
// string would interpolate it, and an interpolation containing escaped
// quotes is not valid Havel source.
READBACK_FILE = "${FIXTURE_DIR}/readback.hv"
fs.write(READBACK_FILE, """
use "std/config" as cfg
value = cfg.get("Probe.ScopeKey", "missing")
print(value)
""")
readback = process.run("HOME=\"${SANDBOX_HOME}\" \"${havel_bin}\" \"${READBACK_FILE}\" 2>&1")
assert(readback.exitCode == 0,
       "the readback script must run; exit ${readback.exitCode}, output: ${readback.stdout}")
assert(readback.stdout.find("from-module") >= 0,
       "the value written from the module scope must be readable; output: ${readback.stdout}")

fs.remove(FIXTURE_DIR)
print("PASS: cfg.set() from a module scope updates the live config object and does not crash")
return 0
