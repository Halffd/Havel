// smoke: timeout = 1200
// Regression test: hotkey bindings must not leak GC external roots.
//
// what: register hotkeys, then remove them - one at a time and in bulk -
//   and assert the external root count returns to the pre-registration
//   baseline.
// why: two pin leaks lived in the hotkey binding lifetime:
//   (1) The action/condition closure pins (registerCallback pins an
//       external root and returns that root id AS the callback id) had no
//       shutdown drain. ~VM released host_function_gc_roots_,
//       module_cache_gc_roots_ and tracked_external_roots_, but NOT the
//       callback pins, so every binding still live at shutdown left one
//       root behind. Measured 263 roots still pinned at VM shutdown for a
//       130-hotkey config.
//   (2) removeAll()/clearAll() cleared the binding map without releasing
//       the action/condition/context pins, leaking them for the whole
//       process - even mid-session, where the count is observable.
// how: gc_external_root_count() exposes the heap's live pin count. Each
//   hotkey pins an action closure, a condition closure and a context
//   object, so the count grows by a known amount per registration and must
//   come back down when the binding goes away. The shutdown drain is only
//   observable from OUTSIDE the process (~VM logs the leftover count), so
//   that part runs as a child and asserts on the child's output.
// expected: the count returns to baseline after hotkey.remove() and after
//   removeAll(); a child that registers bindings and exits logs NO
//   "external roots still pinned" warning.
// run: ./build-debug/hvtest --smoke test_issue_hotkey_pin_lifetime
//   (headless-safe: registers bindings on F-key names and removes them;
//   no key is ever pressed, so no input is injected)
// timeout budget: the 1200s header covers the parent plus ONE child havel
// startup. On a loaded box a headless child needs minutes to reach its
// first prompt (display-connection retries plus module loading); the
// default 60s budget cut the assertion off before the child finished.
// The CHILD's own budget is 900s (see CHILD_CMD below): a child that is
// killed never destroys its VM, so the drain assertion would pass
// vacuously. A SIGKILLed child fails the "the child exited cleanly"
// check instead.

use hotkey
use "fs"
use "process"

fails = 0

check = fn(name, ok, detail) {
    if ok {
        print("PASS: " + name)
    } else {
        print("FAIL: " + name + " - " + detail)
        fails = fails + 1
    }
}

// ---------------------------------------------------------------------------
// (2) removeAll() must release the pins of the bindings it drops.
// ---------------------------------------------------------------------------
base = gc_external_root_count()
print("baseline_roots=" + str(base))

h1 = F13 => { print("never") }
h2 = F14 => { print("never") }
registered = gc_external_root_count()
print("after_register=" + str(registered))
check("registration pins the bindings",
      registered > base,
      "expected more roots than baseline, got " + str(registered) + " (baseline " + str(base) + ")")

removed = h1.removeAll()
print("removeAll_returned=" + str(removed))
gc_collect_full()
gc_collect()
afterRemoveAll = gc_external_root_count()
print("after_removeAll=" + str(afterRemoveAll))
check("removeAll releases every binding's pins",
      afterRemoveAll <= base,
      "expected <= baseline " + str(base) + ", got " + str(afterRemoveAll))

// ---------------------------------------------------------------------------
// (1) hotkey.remove() must release the pins of a single binding.
// ---------------------------------------------------------------------------
h3 = F15 => { print("never") }
h4 = F16 => { print("never") }
afterReg2 = gc_external_root_count()
print("after_register_2=" + str(afterReg2))

hotkey.remove("F15")
hotkey.remove("F16")
gc_collect_full()
gc_collect()
afterRemove = gc_external_root_count()
print("after_remove=" + str(afterRemove))
check("hotkey.remove releases every binding's pins",
      afterRemove <= base,
      "expected <= baseline " + str(base) + ", got " + str(afterRemove))

// ---------------------------------------------------------------------------
// A conditional binding pins THREE roots (action closure, condition closure,
// context object). Removing it must release all three.
// ---------------------------------------------------------------------------
h5 = hotkey("F17", fn() { return true }) => { print("never") }
afterCond = gc_external_root_count()
print("after_conditional_register=" + str(afterCond))
check("a conditional binding pins more than an unconditional one",
      afterCond > afterRemove,
      "expected > " + str(afterRemove) + ", got " + str(afterCond))

hotkey.remove("F17")
gc_collect_full()
gc_collect()
afterCondRemove = gc_external_root_count()
print("after_conditional_remove=" + str(afterCondRemove))
check("a removed conditional binding releases all three pins",
      afterCondRemove <= base,
      "expected <= baseline " + str(base) + ", got " + str(afterCondRemove))

// ---------------------------------------------------------------------------
// The SHUTDOWN drain. A binding still live when the VM is destroyed keeps
// its callback pin unless ~VM releases it, and ~VM reports the leftovers:
//     [VM][GC] N external roots still pinned at VM shutdown
// That message is only produced while the VM is being destroyed, so the
// assertion has to run in a CHILD process and read the child's output.
//
// Before the fix: 3 hotkeys -> "3 external roots still pinned at VM
// shutdown"; 130 hotkeys -> 263.
// ---------------------------------------------------------------------------
havel_bin = sys.env("HAVEL_BINARY")
if !havel_bin || havel_bin == "" {
    cwd = sys.cwd()
    candidates = ["${cwd}/build-debug/havel", "${cwd}/build-release/havel", "${cwd}/havel"]
    havel_bin = ""
    for c in candidates {
        if fs.exists(c) {
            havel_bin = c
            break
        }
    }
    assert(havel_bin != "", "could not locate the havel binary from cwd ${cwd}")
}

FIXTURE_DIR = "${sys.tmpdir()}/havel_hotkey_pins_${sys.pid()}"
CHILD_FIXTURE = "${FIXTURE_DIR}/live_bindings.hv"
fs.mkdir(FIXTURE_DIR)
fs.write(CHILD_FIXTURE, """
use hotkey
use sys
// Three unconditional bindings: each pins an action closure and a context
// object. They are deliberately NOT removed - the point is what the VM
// still holds when it is destroyed.
hotkey("F21") => { print("never") }
hotkey("F22") => { print("never") }
hotkey("F23") => { print("never") }
sys.exit(0)
""")

// Headless: the child inherits this process's environment, and on a live
// desktop the display-connection retries would push it past the timeout.
//
// The child's timeout must be generous: on a loaded box a headless child
// needs minutes to reach its first prompt, and a SIGKILLed child never
// runs ~VM - so a timed-out child logs NO "external roots still pinned"
// warning and the drain assertion below would pass VACUOUSLY. The
// "the child exited cleanly" check is what makes the next check meaningful;
// the profiler dump in the child's output is the second proof that the
// destructor actually ran.
CHILD_CMD = "env -u DISPLAY -u WAYLAND_DISPLAY -u XAUTHORITY -u XDG_RUNTIME_DIR HAVEL_HEADLESS=1 timeout 900"
child = process.run("${CHILD_CMD} \"${havel_bin}\" \"${CHILD_FIXTURE}\" 2>&1")
check("the child exited cleanly",
      child.exitCode == 0,
      "expected exit 0, got " + str(child.exitCode))
check("the child's VM was destroyed, so the drain really ran",
      child.stdout.find("profiler") >= 0,
      "the child never reached VM shutdown; its output is: " + child.stdout)
check("no external roots are still pinned at VM shutdown",
      child.stdout.find("external roots still pinned") < 0,
      "the child logged a shutdown pin warning: " + child.stdout)

fs.remove(FIXTURE_DIR)

if fails == 0 {
    print("ALL PASS")
    exit(0)
} else {
    print("FAILURES: " + str(fails))
    exit(1)
}
