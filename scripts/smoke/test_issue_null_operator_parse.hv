// smoke: timeout = 60
// Regression: the lexer's operator-context list omitted TokenType::Null,
// so every operator after a null literal fell to scanHotkey() and became a
// hotkey token; the statement parser then rejected it ("Expected '=>' after
// hotkey literal"). An operator after null must parse as a binary
// operation; nil + int runs (null coerces to 0).
val a = nil + 1
if a != 1 { return 0 }
val b = nil + 2
if b != 2 { return 0 }
val c = 1 + nil
if c != 1 { return 0 }
return 1
