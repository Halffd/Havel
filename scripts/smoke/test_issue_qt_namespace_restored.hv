// Regression for the dead qt.*/gtk.* extension namespaces.
//
// smoke: timeout = 240
//
// Since the "Qt6 extension merged into havel_toolkit_qt.so" refactor,
// api_register_function stored every C-ABI registration in a
// function-local static map with no reader, and UIManager called the
// toolkit's register_extension_functions with nullptr — which crashed any
// plugin that dereferenced it (observed SIGSEGV in
// qt_register_host_functions before the REPL banner could appear).
//
// This test forces the toolkit-found environment (child havel runs with the
// build dir as cwd, matching ctest) and asserts:
//   - the session survives backend creation (pre-null-guard: SIGSEGV)
//   - the qt namespace object exists and qt.init resolves as a function
// The probe is presence-only: qt.init is never CALLED, so no QApplication
// or display is touched.
// Skips (explicit, passing) when this build has no Qt toolkit plugin.
// Expected: PASS, exit 0.

use "fs"
use "process"

cwd = sys.cwd()
candidates = ["${cwd}/build-debug", "${cwd}/build-release", "${cwd}"]
// The suite's own binary wins: hvtest exports HAVEL_BINARY, and the child
// under test must be the binary this suite runs. The classic candidates can
// hold a stale sibling build (observed: case 1 asserted against an old
// build-debug/havel that still leaked EventRuntime, so the child died with
// LeakSanitizer's exit 1 while build-verify was green).
suite_bin = sys.env("HAVEL_BINARY")
if suite_bin && suite_bin != "" && fs.exists(suite_bin) {
    dir_q = process.run("dirname -- \"${suite_bin}\"")
    if dir_q.exitCode == 0 {
        suite_dir = dir_q.stdout.trim()
        if suite_dir != "" && fs.exists("${suite_dir}/havel") {
            candidates = [suite_dir, "${cwd}/build-debug", "${cwd}/build-release", "${cwd}"]
        }
    }
}
build_dir = ""
for c in candidates {
    if fs.exists("${c}/havel") && fs.exists("${c}/toolkits/havel_toolkit_qt.so") {
        build_dir = c
        break
    }
}
if build_dir == "" {
    // No Qt toolkit plugin in this build (Qt dev libs absent) — the
    // registration path has nothing to exercise. Explicit pass.
    print("OK qt-namespace (toolkit not built in this configuration)")
    process.exit(0)
}

FIXTURE_DIR = "${sys.tmpdir()}/havel_qt_ns_smoke_${sys.pid()}"
fs.mkdir(FIXTURE_DIR)

// Child: REPL session from the build dir (toolkit resolves), print whether
// qt.init resolves, exit. The function reference is never invoked.
// `env -u HAVEL_HEADLESS` strips the ctest sandbox's headless marker (it
// makes UIManager refuse backend creation, which would deny the very path
// under test); QT_QPA_PLATFORM=offscreen stays inherited so any Qt
// initialization is inert. `env -u` is a no-op when the var is unset
// (direct suite runs).
res = process.run("cd \"${build_dir}\" && printf 'print(\"QT_FN_\" + str(qt.init != nil))\\nexit\\n' | env -u HAVEL_HEADLESS timeout 25 ./havel --repl 2>&1")
assert(res.exitCode == 0, "repl session with qt toolkit must exit 0 (pre-null-guard it SIGSEGV'd at backend creation), got ${res.exitCode}")
assert(res.stdout.includes("QT_FN_true"), "qt.init must resolve as a function when the toolkit registers; got: ${res.stdout}")

// ---------------------------------------------------------------- case 2
// `--ui gtk` from a display-less child running a UI-declaring script: the
// gtk toolkit plugin must load, the register bridge must run (gtk.*
// registrations are visible with -d), and GTK's failed headless initialize
// must degrade to the documented "No UI backend available" refusal (exit 1)
// instead of crashing. DISPLAY/WAYLAND/XAUTHORITY are stripped so
// GtkBackend::initialize can never touch a real desktop session even when
// the suite runs on one; HAVEL_HEADLESS is stripped so registration is
// actually reached.
GTK_CHILD = "${FIXTURE_DIR}/gtk_child.hv"
fs.write(GTK_CHILD, "use ui\nprocess.exit(0)\n")
res2 = process.run("cd \"${build_dir}\" && env -u HAVEL_HEADLESS -u DISPLAY -u WAYLAND_DISPLAY -u XAUTHORITY timeout 25 ./havel --ui gtk -d \"${GTK_CHILD}\" 2>&1")
assert(res2.exitCode == 1, "display-less gtk session must end in the documented refusal (exit 1), got ${res2.exitCode}")
assert(res2.stdout.includes("Registered extension function: gtk.init"), "gtk register bridge must run; got: ${res2.stdout}")
assert(res2.stdout.includes("No UI backend available"), "headless GTK must refuse with the documented error, got: ${res2.stdout}")

// ---------------------------------------------------------------- case 3
// Invalid --ui value: warning + auto fallback, never fatal.
res3 = process.run("cd \"${build_dir}\" && printf 'exit\\n' | env -u HAVEL_HEADLESS timeout 25 ./havel --ui bogus --repl 2>&1")
assert(res3.exitCode == 0, "invalid --ui value must fall back to auto and still work, got ${res3.exitCode}")
assert(res3.stdout.includes("ignoring 'bogus'"), "invalid --ui value must be warned about, got: ${res3.stdout}")

// Clean up.
fs.remove(FIXTURE_DIR)

print("OK qt-namespace")
process.exit(0)
