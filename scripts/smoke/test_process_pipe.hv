// test_process_pipe.hv
// What: process.pipe runs a command or a pipeline with real pipes and direct
//       exec (no shell): stages chain stdout->stdin, quoted arguments keep
//       their spaces, an optional second argument supplies stdin, and the
//       result is the last stage's object (success/exitCode/stdout/stderr).
// Why: this is what the REPL shell layer compiles every command to.
// Expected: exit 0, no output on success. Cleans up after itself.
// smoke: timeout = 60

r = process.pipe(["echo", "hello"])
if !r.success { print("FAIL echo success: " + str(r.error)); exit(1) }
if r.stdout.trim() != "hello" { print("FAIL echo stdout=" + r.stdout); exit(1) }
if r.exitCode != 0 { print("FAIL echo exitCode=" + str(r.exitCode)); exit(1) }

p = process.pipe([["printf", "b\na\nc\n"], ["sort"], ["head", "-1"]])
if !p.success { print("FAIL pipe success: " + str(p.error)); exit(1) }
if p.stdout != "a\n" { print("FAIL pipe stdout=" + p.stdout); exit(1) }

// Direct exec: an argument with spaces stays one argument.
q = process.pipe(["printf", "%s\n", "two words"])
if q.stdout.trim() != "two words" { print("FAIL quoted stdout=" + q.stdout); exit(1) }

// Stdin as text, and as a previous result's stdout.
s = process.pipe([["cat"]], "from stdin\n")
if s.stdout != "from stdin\n" { print("FAIL stdin stdout=" + s.stdout); exit(1) }
s2 = process.pipe([["cat"]], s)
if s2.stdout != "from stdin\n" { print("FAIL stdin-from-result=" + s2.stdout); exit(1) }

// Failing tail: the last stage's status is the pipeline's.
bad = process.pipe([["echo", "boom"], ["false"]])
if bad.success { print("FAIL false must not be success"); exit(1) }
if bad.exitCode != 1 { print("FAIL false exitCode=" + str(bad.exitCode)); exit(1) }

// Missing command: spawn error is reported, not a crash.
miss = process.pipe(["havel_no_such_command_xyz"])
if miss.success { print("FAIL missing must not be success"); exit(1) }
if miss.error == null { print("FAIL missing should carry an error"); exit(1) }

// fs.globArgs: matches when present, literal pattern otherwise (bash default).
`rm -rf /tmp/havel_smoke_pipe`
lit = fs.globArgs("/tmp/havel_smoke_pipe/*.txt")
if lit.len() != 1 { print("FAIL globArgs literal len=" + str(lit.len())); exit(1) }
if !lit[0].includes("*") { print("FAIL globArgs literal=" + str(lit[0])); exit(1) }
fs.mkdirAll("/tmp/havel_smoke_pipe")
fs.write("/tmp/havel_smoke_pipe/a.txt", "x")
fs.write("/tmp/havel_smoke_pipe/b.txt", "y")
got = fs.globArgs("/tmp/havel_smoke_pipe/*.txt")
if got.len() != 2 { print("FAIL globArgs match len=" + str(got.len())); exit(1) }

`rm -rf /tmp/havel_smoke_pipe`
exit(0)
