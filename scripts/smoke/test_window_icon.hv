// Test: window.icon() returns a usable image handle for the _NET_WM_ICON
// Verifies the icon contract: an int image handle (the same handle space
// image.load uses); 0 means the window has no icon (legitimate). When a
// handle is returned, its dimensions must be positive and within the
// decode cap. At least one window in the session is expected to carry an
// icon; if none does, the contract check degrades to the 0/consistency
// assertions and the run still passes.

use window
use image

val all = window.list()
assert(type(all) == "array", "window.list must return an array")

foundIcon = 0
checked = 0
for w in all {
    if w.id == nil { continue }
    val h = window.icon(w.id)
    assert(type(h) == "int", "window.icon must return an int handle, got " + type(h))
    checked = checked + 1
    if h != 0 {
        val iw = image.width(h)
        val ih = image.height(h)
        assert(iw > 0, "icon width must be positive when a handle is returned, got " + iw)
        assert(ih > 0, "icon height must be positive when a handle is returned, got " + ih)
        assert(iw <= 512, "icon width must be within the decode cap, got " + iw)
        assert(ih <= 512, "icon height must be within the decode cap, got " + ih)
        assert(iw * ih > 0, "icon must have a nonzero pixel count")
        image.release(h)
        if foundIcon == 0 {
            print("first icon: " + iw + "x" + ih)
        }
        foundIcon = foundIcon + 1
    }
}

// Inert default: an unknown window id yields 0, not a crash. (id 0 means
// "the active window" per the resolveWindowId convention.)
assert(window.icon(99999999) == 0, "window.icon of an unknown id must be 0")

print("windows checked: " + checked + ", icons found: " + foundIcon)
print("PASS: window_icon")
exit(0)
