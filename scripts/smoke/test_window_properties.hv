// Test: window.properties() X11 property list
// Verifies the active window's property list comes back as an object
// mapping property names to string values, and that WM_CLASS (set by
// virtually every X11 client) is present and non-empty.
// Headless compatibility: sandboxed children (hvtest/ctest) have no
// window manager — window.active() returns nil there, so the property
// list can only be exercised where a display exists. Degraded run still
// checks the inert default (unknown id -> empty object), which needs no
// display.

use window

val active = window.active()
if active == nil {
    print("no window manager (headless env), active = nil")

    // Inert default still holds without a display.
    val none = window.properties(99999999)
    assert(type(none) == "object", "window.properties of an unknown id must still return an object")

    print("PASS: window_properties")
} else {
    val props = window.properties(active.id)
    print("window.properties() type: " + type(props))
    assert(type(props) == "object", "window.properties must return an object, got " + type(props))

    val wmClass = props.WM_CLASS
    assert(wmClass != nil, "WM_CLASS property must be present on the active window")
    assert(wmClass != "", "WM_CLASS property must be non-empty")
    print("WM_CLASS = " + wmClass)

    val pidProp = props._NET_WM_PID
    if pidProp != nil {
        // Cardinal property: rendered as a decimal number string.
        assert(pidProp != "", "_NET_WM_PID, when present, must be non-empty")
    }

    // Inert default: an unknown window id yields an empty object, not a crash.
    // (id 0 means "the active window" per the resolveWindowId convention.)
    val none = window.properties(99999999)
    assert(type(none) == "object", "window.properties of an unknown id must still return an object")

    print("PASS: window_properties")
}

exit(0)
