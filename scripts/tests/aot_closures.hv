print("aot closures")

// closure capturing local var
adder = fn(x) { return fn(y) { x + y } }
add5 = adder(5)
print(add5(10))  // 15

// multiple captures
multiplier = fn(mult) { 
    base = 2
    return fn(val) { base * mult * val }
}
times4 = multiplier(2)
print(times4(3))  // 24

// closure assigned to object field
obj = { compute = fn(x) { x * x } }
print(obj.compute(7))  // 49

// nested closures
outer = fn() {
    a = 10
    inner = fn() {
        b = 20
        innermost = fn() { a + b }
        return innermost()
    }
    return inner()
}
print(outer())  // 30
