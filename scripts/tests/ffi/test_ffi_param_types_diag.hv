// Test: ffi.call param_types diagnostic
//
// What: when ffi.call is passed a non-array as the third argument (the C
//       parameter type list), the VM must report a clear "param_types is not
//       an array" error instead of a confusing "expected 0 args, got N" count
//       mismatch. The array path must keep working unchanged.
// Why:  a user hit "ffi.call: expected 0 args, got 3" once per zoom tick in an
//       async context; the generic message hid which call and why. This
//       diagnostic isolates the real cause.
// Expected: control array call executes; non-array call errors explicitly.

use ffi

_libc = ffi.open("libc.so.6")
if _libc == 0 { _libc = ffi.open("libc.so") }
if _libc == 0 {
    print("FAIL: libc not loadable")
    exit(1)
}

_close = ffi.sym(_libc, "close")
if _close == 0 {
    print("FAIL: close not resolvable")
    exit(1)
}

// Control: array param_types with matching arg count. Must NOT error.
r = ffi.call(_close, "int32", ["int32"], -1)
// close(-1) returns -1 (EBADF); the important thing is it executed the array
// path without the "not an array" / count-mismatch error.
print("ok array-path r=", r)

// Diagnostic: string (non-array) as param_types with an extra value arg.
// Expect the explicit "not an array" error text, not "expected 0 args".
s = "not-an-array"
ffi.call(_close, "int32", s, -1)
print("note reached-past-nonarray")

print("FFI_PARAM_TYPES_DIAG: PASS")
