// ai_gaming_demo.hv — the LiveLink "AI gaming" flow, in Havel.
//
// The shape asked for:
//
//   import tensorflow as tf from python
//   import "game_bot.lua" as bot from lua
//   compositor.create_workspace("AI_Gaming")
//   hotkey("f12") => {
//       let model = tf.load_model("genshin_ai.h5");
//       bot.start_automation(model.predict(screen.capture()));
//   }
//
// Havel's equivalents (the language has no import statement; modules are
// reached with `use`, and a module object is what `use` binds):
//
//   tf  = py.import("tensorflow")     // the CPython bridge, as an object
//   bot = lua.load("game_bot.lua")     // a Lua file, as an object
//   compositor.createWorkspace("AI_Gaming")
//   hotkey("F12") => { ... }          // the hotkey DSL, key named in a string
//   (F12 => { ... } is the same binding)
//
// Notes:
//  - `let` does not exist in Havel; assignment is plain `name = value`.
//  - the hotkey body is a closure: it captures the module objects above.
//  - a screen capture is a 2D RGBA array of millions of elements; the
//    python bridge refuses arrays over 64k elements, so the frame is passed
//    as a FILE the model loads itself (screenshot.save writes the frame).
//
// This file is a shape demonstration, not an automated test: it needs
// tensorflow, a model file and a real desktop. Run it by hand.

use py
use lua
use compositor
use screenshot

tf = py.import("tensorflow")
bot = lua.load("game_bot.lua")

print("[demo] python: " + py.version())
print("[demo] lua: " + lua.version())
print("[demo] compositor: " + compositor.detect())

ws = compositor.createWorkspace("AI_Gaming")
print("[demo] workspace: ok=" + ws.ok + " err=" + ws.err)

// The model handle is kept across presses; the object holds it because a
// closure captures locals by value.
state = {model: null}

hotkey("F12") => {
    if state.model == null {
        state.model = tf.keras.models.load_model("genshin_ai.h5")
    }
    // The frame goes to a file; the model reads it (passing millions of
    // pixels across the bridge is refused by design).
    frame = "/tmp/livelink_frame.png"
    screenshot.save(frame)
    action = state.model.predict(frame)
    bot.start_automation(action)
}
