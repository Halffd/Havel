Mode = mode
mode = lmode = "default"
title_ = ltitle = ""
lclass = class_ = ""
wid = lwid = 0
wpid = lwpid = 0
win = lastWin = null
cmd = lcmd = ""

timeout 35000 {
    print("35 seconds passed, exiting")
    exit(0)
}

// ============================================================
// HOTKEY DEFINITIONS WITH CONDITIONS
// ============================================================
enterHk = Enter if title_ ~ "onsole" => print("Enter pressed in konsole")
enter2Hk = ~Enter if !(title_ ~ "onsole") => print("Enter pressed OUTSIDE konsole")
tHk = #t if true => print("Meta+t pressed")
fHk = +f if false => print("Error: should never print")
nHk = !n if 1 + 2 == 4 - 1 => print("Alt+n pressed")
oHk = ~!o if {} == {} => print("Alt+o non-grab pressed")
xHk = |x if #"x" == 1 => print("X non repeat pressed")

// ============================================================
// ASSERT HELPERS
// ============================================================
fn assert(condition, msg) {
    if !condition {
        print("ASSERT FAIL: " + msg)
        exit(1)
    }
}
fn assertEq(got, expected, msg) {
    if got != expected {
        print("ASSERT FAIL: " + msg + " - got: " + got + " expected: " + expected)
        exit(1)
    }
}

// ============================================================
// STARTUP HOTKEY GRAB TESTS
// ============================================================
fn runGrabTests() {
    print("\n=== RUNNING STARTUP GRAB TESTS ===")
    assert(tHk.grab == true, "true condition should grab")
    assert(fHk.grab == false, "false condition should not grab")
    assert(nHk.grab == true, "arithmetic condition should grab")
    assert(oHk.grab == true, "object equality should grab (currently non-grab?)")
    // oHk is actually ~!o with {} == {} which is true, so grab should be true
    assert(oHk.grab == true, "object equality should grab")
    assert(xHk.grab == true, "length expression should grab")
    print("All grab tests passed.")
}
runGrabTests()

// ============================================================
// CONDITIONAL HOTKEYS
// ============================================================
condGaming = () => {
    res = mode == "gaming" || title_ ~ "mpv"
    print("COND GAMING: " + res)
    return res
}
condConsole = () => {
    res = title_ ~ "onsole"
    print("COND CONSOLE: " + res)
    return res
}

hotkeyTest = hotkey.register_conditional("a",
    () => { print("Gaming/mpv mode active") },
    condGaming
)
hotkeyTest2 = hotkey.register_conditional("b",
    () => { print("On terminal") },
    condConsole
)

// ============================================================
// MODE EVALUATION FUNCTION
// ============================================================
cfg = cfg || {}
if cfg?.General == null { cfg.General = {} }
cfg.General.Apps = "steam,lutris,mpv,konsole,hatterino"
cfg.General.GamingExcludeClasses = ""
cfg.General.GamingExcludeTitles = ""

fn modeEval(win) {
    titlelower = win.title.lower().trim()
    classlower = win.class.lower().trim()
    apps = cfg.General.Apps.lower().trim().split(",")
    excludeClasses = cfg.General.GamingExcludeClasses.lower().trim().split(",")
    excludeTitles = cfg.General.GamingExcludeTitles.lower().trim().split(",")

    isGamingApp = (classlower in apps) || (titlelower in apps)
    isExcluded = (classlower in excludeClasses) || (titlelower in excludeTitles)

    if isGamingApp && !isExcluded && mode != "gaming" {
        print("Gaming mode activated for window: " + title_ + " (class: " + class_ + ")")
        mode = "gaming"
    } else if !isGamingApp && mode == "gaming" {
        mode = "default"
        print("Leaving mode to default")
    }
}

// ============================================================
// OTHER HOTKEYS
// ============================================================
pHk = p if title_ ~ "mpv" => print("P pressed in mpv")
vHk = ^v if title_ ~ "hatterino" => print("Ctrl+V pressed in chatterino")
+s if mode == "gaming" => {
    winid = window.active().id
    interval 100 {
        if winid != window.active().id || io.getKey("f") { return }
        send("{enter}")
        sleep(100)
        send("f")
        io.mouseMoveTo(1600, 900)
        io.click(1)
    }
}
o => test()

// ============================================================
// COMPREHENSIVE TEST FUNCTION
// ============================================================
fn test() {
    print("\n=== TESTING ===")
    print("title_: " + title_)
    print("mode: " + mode)

    // Test conditional hotkeys based on current mode/title
    if condGaming() {
        assert(hotkeyTest.grab, "hotkeyTest should be grabbing when condGaming true")
    } else {
        assert(!hotkeyTest.grab, "hotkeyTest should not grab when condGaming false")
    }

    if condConsole() {
        assert(hotkeyTest2.grab, "hotkeyTest2 should be grabbing when condConsole true")
    } else {
        assert(!hotkeyTest2.grab, "hotkeyTest2 should not grab when condConsole false")
    }

    // Test window-specific hotkeys
    if title_ ~ "mpv" {
        assert(pHk.grab, "pHk should be grabbing in mpv")
    } else {
        if !pHk.grab { assert(!pHk.grab, "pHk not grabbing should have grab false") }
    }

    if title_ ~ "hatterino" {
        assert(vHk.grab, "vHk should be grabbing in hatterino")
    } else {
        if !vHk.grab { assert(!vHk.grab, "vHk not grabbing should have grab false") }
    }

    if title_ ~ "onsole" {
        assert(enterHk.grab, "enterHk should be grabbing in konsole")
        assert(!enter2Hk.grab, "enter2Hk should not grab in konsole")
    } else {
        assert(enter2Hk.grab, "enter2Hk should be grabbing outside konsole")
        assert(!enterHk.grab, "enterHk should not grab outside konsole")
    }

    print("=== ALL TESTS PASSED ===\n")
}

// ============================================================
// MODE FORCING TEST (startup)
// ============================================================
fn testModeForcing() {
    print("\n=== FORCING MODE TO GAMING FOR TEST ===")
    oldMode = mode
    mode = "gaming"
    sleep(100)  // Allow condition re-eval to process
    print("Mode forced to gaming. Testing hotkey states...")
    // Call test to verify hotkeyTest becomes active
    test()
    // Restore mode
    mode = oldMode
    sleep(100)  // Allow condition re-eval to process
    print("Mode restored to " + mode + ". Re-testing...")
    test()
}

// ============================================================
// START MAIN LOOPS
// ============================================================
dbgWin = 0
hks = null
tick = 0
tickGo = 0
tickOut = 0

print("STARTING GOROUTINE")
go fn update() {
    loop {
        tickGo++
        print("[IN GOROUTINE] tick=" + tickGo)

        // Verify goroutine is not alone
        if tickGo > 5 && tickOut < 5 {
            print("[ERROR] ONLY GOROUTINE RUNNING " + tickGo + " > " + tickOut)
            assert(tickOut > 0, "outside loop should have run by now")
        }

        win = window.active()
        [title_, class_, cmd, wid, wpid] = [win.title, win.class, win.cmdline, win.id, win.pid]

        if wid != lwid {
            print("WINDOW CHANGE")
            [ltitle, lclass, lcmd, lwid, lwpid] = [title_, class_, cmd, wid, wpid]
            modeEval(win)

            if dbgWin {
                print("Active window changed: " + title_ + " class: " + class_ + " mode: " + mode + " cmd: " + cmd + " pid: " + wpid + " id: " + wid + " last: " + (lastWin ? lastWin.title_ : "none"))
            }
            print("Hotkeys:")
            print(hotkey.list())
            test()
        }
        sleep(1000)
    }
}

testModeForcing()
print("STARTING OUTSIDE LOOP")
loop {
    tickOut++
    println("[OUTSIDE GOROUTINE] tick=" + tickOut)

    // Check goroutine liveness
    if tickOut > 20 && tickGo <= 20 {
        print("[ERROR] GOROUTINE HANG " + tickGo + " < " + tickOut)
        assert(tickGo > 20, "goroutine should have run at least 20 times")
    }

    // Mode info
    if mode == "gaming" {
        println("[MODE] gaming")
    } else {
        println("[MODE] default")
    }

    // On every 10th tick, run mode forcing test to verify conditional hotkeys update dynamically
    if tickOut % 10 == 0 {
        println("\n=== RUNNING PERIODIC MODE FORCING TEST ===")
        oldMode = mode
        // Force gaming and verify hotkeyTest
        mode = "gaming"
        sleep(100)  // Allow condition re-eval to process
        // Check that condGaming returns true
        if condGaming() {
            assert(hotkeyTest.grab, "hotkeyTest should be grabbing when mode forced to gaming")
            print("SUCCESS: hotkeyTest became active under forced gaming mode")
        } else {
            print("WARNING: condGaming returned false even after forcing gaming mode")
        }
        // Restore mode and verify it changes back
        mode = oldMode
        sleep(100)  // Allow condition re-eval to process
        if !condGaming() {
            assert(!hotkeyTest.grab, "hotkeyTest should not grab when mode restored")
            print("SUCCESS: hotkeyTest disabled after mode restoration")
        }
        println("=== PERIODIC TEST COMPLETE ===\n")
    }

    sleep(1000)
}
