// ============================================================
// ⚠ SENDS REAL INPUT — DO NOT RUN AUTOMATED / FROM AN AGENT PIPELINE
// ============================================================
// This script issues actual mouse/keyboard/brightness events to the
// running desktop session. It exists for manual verification by a human
// only. Do not run it from CI, smoke, tests, hvtest, or agent-driven
// sessions: it WILL move your cursor, click buttons, change display
// brightness, and affect the focused window.
// ============================================================

mouseAcc = 1
mouseStep = 10
fn moveMouse (dx, dy) {
  print(time.now())
  print(f"moveMouse called with dx: $dx, dy: $dy, current mouseAcc: $mouseAcc")
  print("Mouse position before move: " + mouse.pos())
  mouse.moveRel(dx * mouseStep * mouseAcc, dy * mouseStep * mouseAcc)
  mouseAcc = mouseAcc + 1
  if mouseAcc > 10 { mouseAcc = 10 }
  print("Mouse moved to " + mouse.pos() + " with acceleration " + mouseAcc)
  print(time.now())
  print("moveMouse finished " + mouse.pos())
}
moveMouse(10, 0)
moveMouse(0, 10)
moveMouse(-10, 0)
moveMouse(0, -10)
moveMouse(5000, 5)
print("left click down")
mouse.down(1)
print("Mouse state: " + keyboard.getKey("LButton"))

print("left click up")
mouse.up(1)
print("Mouse state: " + keyboard.getKey("LButton"))
print("Mouse position: " + mouse.pos())
print("Scrolling, type(mouse.scroll) is " + type(mouse.scroll))
mouse.scroll(0, 1)
mouse.scroll(0, -1)
mouse.scroll(1, 0)
mouse.scroll(-1, 0)

print("Brightness and color temperature control")
b = "1.0"
sl = "0.0"
gr = "1.0"
gg = "1.0"
gb = "1.0"
temp = "6500"
print("Resetting brightness to defaults: " + b + " " + sl + " " + gr + " " + gg + " " + gb + " " + temp)
brightness.setBrightness(num(b))
brightness.setShadowLift(num(sl))
brightness.setGammaRGB(num(gr), num(gg), num(gb))
brightness.setTemperature(int(temp))

print("Current brightness: " + brightness.getBrightness() + " ShadowLift: " + brightness.getShadowLift() + " GammaR: " + brightness.getGammaR() + " GammaG: " + brightness.getGammaG() + " GammaB: " + brightness.getGammaB() + " Temperature: " + brightness.getTemperature())

print("Brightness increase requested")
print("Brightness before change: ")
print(brightness.getBrightness())
brightness.increaseBrightness(0.05)
print("Brightness after change: ")
print(brightness.getBrightness())
print("Brightness decrease requested")
brightness.decreaseBrightness(0.05)
print("Brightness after decrease: ")
print(brightness.getBrightness())
print("type of brightness: " + type(brightness) + ", type of brightness.getBrightness: " + type(brightness.getBrightness) + ", type of brightness.increaseBrightness: " + type(brightness.increaseBrightness) + ", type of brightness.decreaseBrightness: " + type(brightness.decreaseBrightness) + ", type of brightness.setBrightness: " + type(brightness.setBrightness) + ", type of brightness.getShadowLift: " + type(brightness.getShadowLift) + ", type of brightness.setShadowLift: " + type(brightness.setShadowLift) + ", type of brightness.getGammaR: " + type(brightness.getGammaR) + ", type of brightness.setGammaRGB: " + type(brightness.setGammaRGB) + ", type of brightness.getTemperature: " + type(brightness.getTemperature) + ", type of brightness.setTemperature: " + type(brightness.setTemperature))
print(brightness)

sl = brightness.getShadowLift()
print("Current ShadowLift: " + sl)
print("ShadowLift increase requested")
brightness.increaseShadowLift(0.05)
print("ShadowLift after increase: " + brightness.getShadowLift())
print("ShadowLift decrease requested")
brightness.decreaseShadowLift(0.05)
print("ShadowLift after decrease: " + brightness.getShadowLift())
sl = brightness.getShadowLift()
brightness.setShadowLift(sl - 0.05)
print("ShadowLift after decrease: " + brightness.getShadowLift())
// temperature
temp = brightness.getTemperature()
print("Current color temperature: " + temp)
print("Color temperature increase requested")
brightness.increaseTemperature(500)
print("Color temperature after increase: " + brightness.getTemperature())
print("Color temperature decrease requested")
brightness.decreaseTemperature(500)
print("Color temperature after decrease: " + brightness.getTemperature())
temp = brightness.getTemperature()
brightness.setTemperature(temp - 500)
print("Color temperature after decrease: " + brightness.getTemperature())
// get brightness and set it directly
b = brightness.getBrightness()
print("Current brightness: " + b)
brightness.setBrightness(b - 0.05)
print("Brightness after decrease: " + brightness.getBrightness())

// io
print("Mouse state ", mouse.state())
print("IO state ", keyboard.state())
print("IO device ", devices.device())
print("IO locks ", keyboard.locks())
print("IO modifiers ", keyboard.modifiers())
print("IO keys ", keyboard.keys())
print("IO getKey LButton: " + keyboard.getKey("LButton"))
print("IO getKey RButton: " + keyboard.getKey("RButton"))
print("IO getKey MButton: " + keyboard.getKey("MButton"))
print("IO getKey XButton1: " + keyboard.getKey("XButton1"))
print("IO getKey XButton2: " + keyboard.getKey("XButton2"))
print("IO getKey Shift: " + keyboard.getKey("Shift"))
print("IO getKey Ctrl: " + keyboard.getKey("Ctrl"))
print("IO getKey Alt: " + keyboard.getKey("Alt"))
print("IO getKey Super: " + keyboard.getKey("Super"))
print("IO sendKey Shift down")
io.sendKey("Shift", "down")
print("IO getKey Shift: " + keyboard.getKey("Shift"))
print("IO sendKey Shift up")
io.sendKey("Shift", "up")
print("IO getKey Shift: " + keyboard.getKey("Shift"))
print("IO sendKey Ctrl down + Alt down + E")
keyboard.setLock("CapsLock", true)
print("IO locks after setting CapsLock: " + keyboard.locks())
io.sendKey("Ctrl", "down")
io.sendKey("Alt", "down")
io.sendKey("E", "down")
print("IO state after sending Ctrl+Alt+E: " + keyboard.state())
print("IO getKey Ctrl: " + keyboard.getKey("Ctrl"))
print("IO getKey Alt: " + keyboard.getKey("Alt"))
print("IO getKey E: " + keyboard.getKey("E"))
io.sendKey("E", "up")
io.sendKey("Alt", "up")
io.sendKey("Ctrl", "up")
keyboard.setLock("CapsLock", false)
print("IO locks after unsetting CapsLock: " + keyboard.locks())
print("IO getKey Ctrl: " + keyboard.getKey("Ctrl"))
print("IO getKey Alt: " + keyboard.getKey("Alt"))
print("IO getKey E: " + keyboard.getKey("E"))
io.sendKey("Shift", "down")
io.sendKey("A", "down")
print("IO state after sending Shift+A: " + keyboard.state())
keyboard.reset()
print("IO state after reset: " + keyboard.state())
io.send("Hello, world!")
print("Last key: " + keyboard.lastKey())
print("Last state: " + keyboard.lastState())
print("Last device: " + devices.lastDevice())
print("Last modifiers: " + keyboard.lastModifiers())
print("Last locks: " + keyboard.lastLocks())
print("Last keys: " + keyboard.lastKeys())
print("Mouse click")
mouse.click()
print("Mouse last state: " + mouse.lastState())
mouse.click("left")
print("Mouse last button: " + mouse.lastButton())
mouse.click("right")
print("Mouse last button: " + mouse.lastButton())
mouse.click(1, "down")
print("Mouse state: " + keyboard.getKey("LButton"))
mouse.click(2, "down")
print("Mouse state: " + keyboard.getKey("RButton"))
mouse.click(3, "down")
print("Mouse state: " + keyboard.getKey("MButton"))
mouse.click(4, "down")
print("Mouse state: " + keyboard.getKey("XButton1"))
mouse.click(5, "down")
print("Mouse state: " + keyboard.getKey("XButton2"))
print("Mouse buttonss: " + mouse.buttons())
print("Mouse position: " + mouse.pos())
mouse.reset()
print("Mouse last state: " + mouse.lastState())
print("Mouse state: " + mouse.state())