// Comprehensive self-hosted compiler suite (compile-only).
// What: drives the self-hosted pipeline (lexer -> pratt -> emitter) across
//       arithmetic, variables, functions, control flow, comparisons, logic,
//       strings, booleans, loops, closures, arrays, objects, multi-statement
//       programs and chained conditions. Every snippet must parse and compile
//       to a bytecode chunk without error.
// Why compile-only: the persistent VM discards top-level expression results
//       (last-statement POP in compileProgram) and shares one global table
//       across executes, so per-snippet value assertions cannot be expressed
//       against the current architecture. Behavioral self-hosted coverage
//       lives in the self-hosted pipeline suite; this file pins down
//       parse+compile of every feature.
// Expected: every check reports PASS; final line reports N/N passed.

use { parse } from "pratt"
use { Emitter, compileProgram } from "emitter"

passed = 0
failed = 0

fn check(label, source) {
    parsed = parse(source)
    if parsed == null || parsed.ast == null || parsed.errors != null && #parsed.errors > 0 {
        print("FAIL ${label}: parse failed")
        failed = failed + 1
        return
    }
    bc.reset()
    em = Emitter()
    chunk = compileProgram(em, parsed, true)
    if chunk != null && type(chunk) == "int" {
        print("PASS ${label}")
        passed = passed + 1
    } else {
        print("FAIL ${label}: compile returned ${str(chunk)}")
        failed = failed + 1
    }
}

// --- Arithmetic ---
check("add", "3 + 4")
check("sub", "10 - 3")
check("mul", "6 * 7")
check("div", "20 / 4")
check("mod", "10 % 3")
check("neg", "-5")
check("paren", "(2 + 3) * 4")
check("precedence", "2 + 3 * 4")

// --- Variables ---
check("val_decl", "val x = 10\nx + 5")
check("let_decl", "let x = 10\nx = 20\nx")

// --- Functions ---
check("fn_call", "fn double(n) { n * 2 }\ndouble(21)")
check("fn_add", "fn add(a, b) { a + b }\nadd(3, 4)")
check("fn_recursion", "fn fib(n) { if n < 2 { n } else { fib(n-1) + fib(n-2) } }\nfib(10)")

// --- Control flow ---
check("if_true", "if true { 1 } else { 0 }")
check("if_false", "if false { 1 } else { 0 }")
check("if_else", "val x = 10\nif x > 5 { 100 } else { 200 }")
check("ternary", "true ? 1 : 0")
check("ternary_false", "false ? 1 : 0")

// --- Comparisons ---
check("lt_true", "3 < 5")
check("lt_false", "5 < 3")
check("gt_true", "5 > 3")
check("eq_true", "3 == 3")
check("ne_true", "3 != 4")
check("le_true", "3 <= 3")
check("ge_true", "5 >= 3")

// --- Logic ---
check("and_true", "true && true")
check("and_false", "true && false")
check("or_true", "false || true")
check("or_false", "false || false")
check("not_true", "!false")

// --- Strings ---
check("string", "\"hello\"")
check("strlen", "\"hello\".length()")
check("str_concat", "\"hello\" + \" world\"")

// --- Booleans and null ---
check("bool_true", "true")
check("bool_false", "false")
check("null_val", "null")

// --- While loop ---
check("while_loop", "let x = 0\nwhile x < 5 { x = x + 1 }\nx")

// --- For loop (0..5 is inclusive = 0+1+2+3+4+5=15) ---
check("for_loop", "let sum = 0\nfor i in 0..5 { sum = sum + i }\nsum")

// --- Nested functions (braces required for nested fn) ---
check("nested_fn", "fn outer(x) { fn inner(y) { x + y } inner(3) }\nouter(4)")

// --- Closures ---
check("closure", "fn make_adder(n) { fn add(x) { x + n } add }\nval add5 = make_adder(5)\nadd5(10)")

// --- Array ---
bc.reset()
em_a = Emitter()
ast_a = parse("[1, 2, 3]")
r_a = compileProgram(em_a, ast_a, true)
if r_a != null && type(r_a) == "int" {
    print("PASS array")
    passed = passed + 1
} else {
    print("FAIL array: compile returned ${str(r_a)}")
    failed = failed + 1
}

// --- Object ---
bc.reset()
em_o = Emitter()
ast_o = parse("{ a: 1, b: 2 }")
r_o = compileProgram(em_o, ast_o, true)
if r_o != null && type(r_o) == "int" {
    print("PASS object")
    passed = passed + 1
} else {
    print("FAIL object: compile returned ${str(r_o)}")
    failed = failed + 1
}

// --- Multiple statements ---
check("multi_stmt", "val a = 10\nval b = 20\nval c = a + b\nc")

// --- Comparison chaining ---
check("chain_lt", "1 < 2 && 2 < 3")

print("${str(passed)}/${str(passed + failed)} tests passed")