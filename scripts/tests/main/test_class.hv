// Test class and struct syntax
// Class with typed fields and constructor fn @()

class Point {
    x: int
    y: int

    fn @(x, y) {
        @x = x
        @y = y
    }
}

class Deque {
    front: int
    back: int
    data: []

    fn @(data) {
        @data = data
        @front = 0
        @back = #data - 1
    }
    fn append(x) {
        @back = @back + 1
        @data[@back] = x
    }
    fn prepend(x) {
        @front = @front - 1
        @data[@front] = x
    }
    fn pop() {
        x = @data[@back]
        @back = @back - 1
        x
    }
}

class MousePos {
    x: num
    y: num
    device: str

    fn @(x, y, device) {
        @x = x
        @y = y
        @device = device
    }

    fn moveTo(x, y, speed) {
        @x = x
        @y = y
        print("mouse.move(${@x}, ${@y}, ${speed})")
    }

    fn distance(other) {
        dx = @x - other.x
        dy = @y - other.y
        math.sqrt(dx*dx + dy*dy)
    }
}

// initializing
p = Point(10, 20)
m = MousePos(100.5, 200.7, "mouse1")
deq = Deque([1, 2, 3])

m.moveTo(500, 550, 1.5)
dist = m.distance(p)
print("Distance: ${dist}")
print("m: ${m}")
print("m.x: ${m.x}")
print("m.y: ${m.y}")
print("p: ${p}")
print("p.x: ${p.x}")
print("p.y: ${p.y}")
print("deq.front: ${deq.front}")
deq.prepend(4)
print("deq.front: ${deq.front}")
print("deq.back: ${deq.back}")
deq.append(5)
print("deq.pop: ${deq.pop()}")
print("deq.data: ${deq.data}")
print("deq length: ${#deq} items: ${deq.data.len}")

// Exercise member/index assignment paths
m.x = 500
m.y = 550
deq.back = 3

print("p: ${p}")
print("m: ${m}")
print("deq: ${deq}")
