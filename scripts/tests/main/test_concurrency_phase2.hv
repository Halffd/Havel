
// This tests interval.start, interval.stop, timeout.start, timeout.cancel

print("=== Testing interval.start ===")

 counter = 0
 interval_id = interval.start(500, fn() {
  counter = counter + 1
  print("Interval tick: " + str(counter))
})

print("Interval started, waiting for ticks...")
sleep(2000)

print("Stopping interval")
interval.stop(interval_id)

print("=== Testing timeout.start ===")

 timeout_triggered = false
 timeout_id = timeout.start(1000, fn() {
  timeout_triggered = true
  print("Timeout triggered!")
})

print("Timeout scheduled, waiting...")
sleep(1500)

if timeout_triggered {
  print("Timeout test PASSED")
} else {
  print("Timeout test FAILED")
}

print("=== Testing timeout.cancel ===")

 timeout_triggered2 = false
 timeout_id2 = timeout.start(2000, fn() {
  timeout_triggered2 = true
  print("This should not print")
})

print("Timeout scheduled, cancelling now...")
timeout.cancel(timeout_id2)

sleep(2500)

if !timeout_triggered2 {
  print("Timeout cancel test PASSED")
} else {
  print("Timeout cancel test FAILED")
}

print("=== Phase 2 tests completed ===")
