// ============================================================
// ⚠ SENDS REAL INPUT — DO NOT RUN AUTOMATED / FROM AN AGENT PIPELINE
// ============================================================
// This script issues actual mouse/keyboard/brightness events to the
// running desktop session. It exists for manual verification by a human
// only. Do not run it from CI, smoke, tests, hvtest, or agent-driven
// sessions: it WILL move your cursor, click buttons, change display
// brightness, and affect the focused window.
// ============================================================

use "app/brightness" as br

fn main() {
    print("Monitors: ", br.getMonitors())
    print("Initial temp: ", br.getTemperature())
    br.setTemperature(3000)
    print("After setTemperature(3000): ", br.getTemperature())
    br.increaseTemperature(500)
    print("After increaseTemperature(500): ", br.getTemperature())
    br.decreaseTemperature(200)
    print("After decreaseTemperature(200): ", br.getTemperature())
}
main()