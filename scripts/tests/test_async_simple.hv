// Simple async test
use async_mod
use time

print("Testing sleep...")
start = time.now()
print("Before sleep, time.now() = " + str(time.now()))
print("Calling async_mod.sleep(50)...")
async_mod.sleep(50)
elapsed = time.now() - start
print("After sleep, time.now() = " + str(time.now()))
print("sleep elapsed: " + str(elapsed) + "ms")
assert(elapsed >= 40 && elapsed <= 200, "sleep timing off")

print("\nTesting go + channel...")
ch = async_mod.chan()
async_mod.go(fn() {
    async_mod.sleep(20)
    ch.send("hello")
})
result = ch.receive()
print("Received: " + result)
assert(result == "hello", "channel failed")

print("\nTesting debounce...")
counter = 0
debounced = async_mod.debounce(fn(x) { counter += x }, 50)
debounced(1)
debounced(2)
debounced(3)
async_mod.sleep(80)
print("Counter after debounce: " + str(counter))
assert(counter == 3, "debounce failed")

print("\nAll tests passed!")