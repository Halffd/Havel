// Regression: isStringId gap. str() returns a heap STRING_ID; TypeModule's
// isString/type._isString/toString and VM::isTruthy only recognized the
// chunk-literal STRING_VAL_ID encoding, so isString(str(42)) was false,
// toString(str(42)) was null, and `if str(42) {}` was falsy.
//
// Expected: isString true, len 2, type "string", toString round-trip "42",
// equality with a literal, truthy in a conditional.
s = str(42)

assert(isString(s), "isString must accept STRING_ID (str() output)")
assert(len(s) == 2, "len of str(42) must be 2")
assert(type(s) == "string", "type of str(42) must be string")
assert(toString(s) == "42", "toString must pass STRING_ID through")
assert(s == "42", "STRING_ID must equal an equal literal")
assert(isString(str("")), "isString must accept empty STRING_ID")

t = str("hello world")
assert(t.len() == 11, "STRING_ID .len() must work")
assert(t.upper() == "HELLO WORLD", "STRING_ID .upper() must work")
assert(t.sub(0, 5) == "hello", "STRING_ID .sub() must work")

count = 0
if s {
	count = 1
}
assert(count == 1, "STRING_ID must be truthy in a conditional")

itCount = 0
for ch in str("abc") {
	itCount = itCount + 1
}
assert(itCount == 3, "for-in over STRING_ID must yield all 3 chars")

print("test_isstringid_ops passed")
