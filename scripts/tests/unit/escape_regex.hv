// smoke: escape-regex = 4
use regex
// The module's escape function is regex_escape (exposed as regex.escape);
// the test was written against the name escape_regex, which never existed
// in the module - it only compiled because this directory was never
// wired into a runner.
s = regex_escape("a.b")
// "a.b" -> "a\\.b" (escaped the dot)
val __result = #s
if __result != 4 {
 print("FAIL escape-regex: expected 4, got " + str(__result))
 process.exit(255)
}
return __result
