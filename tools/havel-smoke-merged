#!/bin/bash
# havel-smoke-merged: one combined smoke suite across every havel checkout.
#
# Why this exists
# ---------------
# Every agent session has its own checkout (/host/havel, /host/havel-2,
# /host/havel-3, /host/havel-stable, ...) and each one runs "its" smoke
# suite independently. Those suites are not merely similar, they are mostly
# byte-identical: measured on this box, all 359 files under havel/scripts/smoke
# are identical to their havel-3 counterparts (0 differing). So N sessions mean
# N copies of the same work, and on a 9p mount - where I/O is the bottleneck,
# not CPU - that is what makes the machine crawl.
#
# What it does
# ------------
#   1. Collects the smoke tests from every checkout and dedups them by content
#      hash, so an unchanged test is run once no matter how many checkouts
#      carry it.
#   2. Takes an exclusive lock. If another session is already running the
#      merged suite, this exits immediately and points at that run's log
#      instead of piling on a second full-suite pass.
#   3. Writes a published summary that other sessions can read.
#
# It deliberately does not reimplement hvtest's runner. Each test is handed to
# `hvtest --havel <bin> <file>`, which is hvtest's own single-file mode and so
# keeps its per-test timeout handling.
#
# Usage:
#   tools/havel-smoke-merged [--bin <havel>] [--roots a,b,c] [--timeout N]
#                            [--status] [--list]
#
# Exit codes: 0 all passed (or nothing to do), 1 one or more failures,
#             2 bad usage / no tests found, 3 another session holds the lock.

set -uo pipefail

STATE_DIR="${HAVEL_SMOKE_STATE:-/tmp/opencode/havel-smoke-merged}"
LOCK_FILE="$STATE_DIR/lock"
LOG_FILE="$STATE_DIR/latest.log"
PER_TEST_TIMEOUT=90
BIN=""
ROOTS=""
SLOW_TOO=1
MODE=run

die() { echo "havel-smoke-merged: $*" >&2; exit "${2:-2}"; }

while [ $# -gt 0 ]; do
    case "$1" in
        --bin)      BIN="${2:-}"; shift 2 ;;
        --roots)    ROOTS="${2:-}"; shift 2 ;;
        --timeout)  PER_TEST_TIMEOUT="${2:-}"; shift 2 ;;
        --slow-too) SLOW_TOO=1; shift ;;
        --no-slow)  SLOW_TOO=0; shift ;;
        --status)   MODE=status; shift ;;
        --list)     MODE=list; shift ;;
        -h|--help)  sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *)          die "unknown argument '$1'" ;;
    esac
done

mkdir -p "$STATE_DIR" || die "cannot create $STATE_DIR"

# ------------------------------------------------------------------ checkouts
# The invoking checkout's own scripts/ are the suite. Other checkouts are
# sibling branches: their tests are usually identical (deduped below), but the
# few that are unique to them belong to THAT branch, and running them against
# this branch's binary reports failures that say nothing about this branch.
# Measured: seeding the roots with /host/havel first credited 359 of 366 tests
# to another branch and produced 12 "failures", 0 of which came from this
# checkout. So other roots are opt-in via --roots, never implicit.
if [ -z "$ROOTS" ]; then
    here="$(cd "$(dirname "$0")/.." && pwd)"
    ROOTS="$here"
else
    here="$(cd "$(dirname "$0")/.." && pwd)"
    # Keep the invoking checkout first even when --roots is given, so dedup
    # prefers this branch's copy of any shared test.
    ROOTS="${ROOTS:+$ROOTS,}$here"
fi
[ -d "$here/scripts/smoke" ] || die "invoking checkout has no scripts/smoke" 2
PRIMARY_ROOT="$here"

# ------------------------------------------------------------------- binary
# Prefer an explicitly given binary, else the build belonging to the checkout
# this tool was invoked from, else whatever exists.
if [ -z "$BIN" ]; then
    for cand in "$here"/build-timerfix/havel "$here"/build-debug/havel "$here"/build-release/havel; do
        [ -x "$cand" ] && { BIN="$cand"; break; }
    done
fi
[ -n "$BIN" ] && [ -x "$BIN" ] || die "no havel binary found (pass --bin)" 2

# --------------------------------------------------------------- test set
# Dedup by content hash: a test that is byte-identical across checkouts is the
# same test and must only run once. First path wins, and the roots are ordered
# so the invoking session's own checkout is preferred (its binary is the one
# being tested).
collect_tests() {
    local root file hash
    local -A seen=()
    for root in ${ROOTS//,/ }; do
        [ -d "$root/scripts/smoke" ] || continue
        for file in "$root"/scripts/smoke/*.hv; do
            [ -f "$file" ] || continue
            if [ "$SLOW_TOO" -eq 0 ] && grep -qE '^// smoke: tier *= *slow' "$file"; then
                continue
            fi
            hash="$(sha256sum "$file" | cut -d' ' -f1)"
            if [ -n "${seen[$hash]:-}" ]; then continue; fi
            seen[$hash]=1
            echo "$file"
        done
    done
}

TESTS="$(collect_tests)"
COUNT="$(printf '%s\n' "$TESTS" | grep -c . || true)"
[ "$COUNT" -gt 0 ] || die "no smoke tests collected" 2

if [ "$MODE" = list ]; then
    printf '%s\n' "$TESTS"
    exit 0
fi

# The lock fd is opened before --status is answered: flock needs a real open
# descriptor, and without this the status check reports "held" always.
exec 9>"$LOCK_FILE"

# ------------------------------------------------------------------- status
if [ "$MODE" = status ]; then
    if flock -n 9; then
        echo "lock: free"
    else
        echo "lock: held (pid $(cat "$STATE_DIR/lock.pid" 2>/dev/null || echo '?'))"
    fi
    echo "tests: $COUNT unique across ${ROOTS//,/, }"
    [ -f "$LOG_FILE" ] && { echo "last log: $LOG_FILE"; tail -2 "$LOG_FILE"; }
    exit 0
fi

# --------------------------------------------------------------------- lock
# This is the point of the tool: a second concurrent full-suite pass is pure
# waste on an I/O-bound box, so refuse rather than queue up behind it.
if ! flock -n 9; then
        echo "another session is already running the merged smoke suite."
        echo "not starting a duplicate run. progress: $LOG_FILE"
        tail -3 "$LOG_FILE" 2>/dev/null | sed 's/^/  /'
        exit 3
fi
echo $$ > "$STATE_DIR/lock.pid"

echo "binary : $BIN"
echo "roots  : ${ROOTS//,/, }"
echo "suite  : $COUNT tests from $PRIMARY_ROOT (per-test directives honoured)"
echo "log    : $LOG_FILE"
echo

: > "$LOG_FILE"
start=$(date +%s)

HVTEST_BIN="$(dirname "$BIN")/hvtest"
[ -x "$HVTEST_BIN" ] || HVTEST_BIN="hvtest"

# Run the real suite entry point, NOT `hvtest <file>` per test.
#
# The per-test header directives (// smoke: flags / env / timeout / tier) are
# parsed by run_smoke_suite, and single-file mode ignores every one of them.
# Driving the tests one at a time looked equivalent and was not: it reported
# test_issue_orc_classnew_field as failing, when that test carries
# `// smoke: flags = --tiering` and `// smoke: tier = slow` and only exercises
# the ORC path when both are honoured. It passes under the real runner.
#
# --slow-too is passed so the slow tier is included; a bare `hvtest --smoke`
# skips exactly the GC/tiering stress tests that catch the worst regressions.
"$HVTEST_BIN" --smoke --slow-too --timeout "$PER_TEST_TIMEOUT" \
    --havel "$BIN" --scripts-root "$PRIMARY_ROOT/scripts" > "$LOG_FILE" 2>&1
suite_rc=$?

# A suite that ran nothing is a failure of this runner, not a clean result.
# Observed exactly that: --scripts-root was handed the checkout instead of its
# scripts/ dir, hvtest looked in <checkout>/smoke, found nothing, and the
# summary cheerfully reported "0 passed, 0 failed" with exit 0.
if ! grep -q '^smoke:' "$LOG_FILE"; then
    echo "havel-smoke-merged: the suite produced no summary line - aborting." >&2
    echo "hvtest exit=$suite_rc; first lines of $LOG_FILE:" >&2
    head -5 "$LOG_FILE" >&2
    exit 2
fi

pass=$(grep -c '^\[PASS\]' "$LOG_FILE" || true)
timeouts=$(grep -c '^\[FAIL\].*(timeout)' "$LOG_FILE" || true)
fail=$(grep -c '^\[FAIL\]' "$LOG_FILE" || true)
timeouts=$((timeouts))
fail=$((fail - timeouts))
failed_list=()
while IFS= read -r line; do
    [ -n "$line" ] && failed_list+=("$line")
done < <(grep '^\[FAIL\]' "$LOG_FILE" | grep -av '(timeout)' || true)
timeout_list=()
while IFS= read -r line; do
    [ -n "$line" ] && timeout_list+=("$line")
done < <(grep '^\[FAIL\].*(timeout)' "$LOG_FILE" || true)

elapsed=$(( $(date +%s) - start ))

{
    echo
    echo "smoke-merged: $pass passed, $fail failed, $timeouts timed-out | $COUNT tests, ${elapsed}s"
    if [ "$fail" -gt 0 ]; then
        echo "failed:"
        printf '  %s\n' "${failed_list[@]}"
    fi
    if [ "$timeouts" -gt 0 ]; then
        echo "timed out (per-test bound too low for this box, not necessarily broken):"
        printf '  %s\n' "${timeout_list[@]}"
    fi
    echo "binary: $BIN"
    echo "roots : ${ROOTS//,/, }"
} >> "$LOG_FILE"

tail -n 20 "$LOG_FILE"
[ "$fail" -eq 0 ] || exit 1
exit 0